// สลับ override รายใบ (เฉพาะใบพักหน้างาน)
function toggleHoldOrder(order){
  const cur=(order in holdCommitOverride)?holdCommitOverride[order]:holdCommitDefault;
  holdCommitOverride[order]=!cur;
  // ถ้าตรงกับค่ารวมแล้ว ลบ override ทิ้ง (ให้ตามค่ารวม)
  if(holdCommitOverride[order]===holdCommitDefault)delete holdCommitOverride[order];
  saveHoldCommit();renderCommit();
}
function renderCommit(){
  const hc=document.getElementById('commit-holdcommit');if(hc)hc.checked=holdCommitDefault;
