  const items=[...agg.values()].sort((a,b)=>b.pend-a.pend).slice(0,15);
  return `<div class="pcard"><div class="tbl-wrap"><table class="datatbl">
    <thead><tr><th>รหัส</th><th>สินค้า</th><th style="text-align:right">จำนวน</th></tr></thead>
    <tbody>${items.map(x=>`<tr><td style="font-weight:700">${esc(x.code)}</td><td>${esc(x.name)}</td><td class="qty" style="font-weight:700;color:var(--aqua-d)">${x.pend.toLocaleString()}</td></tr>`).join('')}</tbody>
