        tooltip:{bodyFont:{family:'Sarabun'}}}}});

  // 8) มูลค่าคงค้างแยกตามสถานะใบสั่ง
  const valByStatus={}, pendByStatus={}, ordByStatus={};
  STATUSES.forEach(s=>{valByStatus[s.id]=0;pendByStatus[s.id]=0;ordByStatus[s.id]=new Set();});
  DATA.forEach(r=>{const p=num(r[F.pend]);if(p<=0)return;
    const sid=orderStatus(String(r[F.order]));
    if(valByStatus[sid]===undefined){valByStatus[sid]=0;pendByStatus[sid]=0;ordByStatus[sid]=new Set();}
    valByStatus[sid]+=pendValue(r);pendByStatus[sid]+=p;ordByStatus[sid].add(String(r[F.order]));});
  const vsActive=STATUSES.filter(s=>valByStatus[s.id]>0||pendByStatus[s.id]>0);
  const anyVal=vsActive.some(s=>valByStatus[s.id]>0);
  charts.valstatus=new Chart(document.getElementById('c_valstatus'),{type:'bar',
    data:{labels:vsActive.map(s=>s.emoji+' '+s.label),datasets:[{
      data:vsActive.map(s=>Math.round(anyVal?valByStatus[s.id]:pendByStatus[s.id])),
      backgroundColor:vsActive.map(s=>s.color),borderRadius:8}]},
    options:{...baseOpts(true),plugins:{legend:{display:false},tooltip:{backgroundColor:'#0f2b2b',padding:12,cornerRadius:8,
      callbacks:{label:ctx=>anyVal?('฿'+ctx.parsed.x.toLocaleString()):(ctx.parsed.x.toLocaleString()+' หน่วย')},bodyFont:{family:'Sarabun'}}}}});
  // ตารางสรุปใต้กราฟ
  const totV=vsActive.reduce((s,x)=>s+valByStatus[x.id],0);
  const totP=vsActive.reduce((s,x)=>s+pendByStatus[x.id],0);
  document.getElementById('valStatusTable').innerHTML=`<table class="datatbl" style="font-size:.82rem">
    <thead><tr><th>สถานะ</th><th style="text-align:right">ใบสั่ง</th><th style="text-align:right">คงค้าง</th><th style="text-align:right">มูลค่า</th></tr></thead>
    <tbody>${vsActive.map(s=>`<tr>
      <td><span style="color:${s.color};font-weight:700">${s.emoji} ${esc(s.label)}</span></td>
      <td class="qty">${ordByStatus[s.id].size}</td>
      <td class="qty">${pendByStatus[s.id].toLocaleString()}</td>
      <td class="qty" style="color:var(--aqua-d);font-weight:700">${valByStatus[s.id]>0?'฿'+Math.round(valByStatus[s.id]).toLocaleString():'—'}</td>
    </tr>`).join('')}
    <tr style="border-top:2px solid var(--line)"><td style="font-weight:800">รวม</td><td></td>
      <td class="qty" style="font-weight:800">${totP.toLocaleString()}</td>
      <td class="qty" style="font-weight:800;color:var(--aqua-d)">${totV>0?'฿'+Math.round(totV).toLocaleString():'—'}</td></tr>
    </tbody></table>`;
}

// ---------- Import / Export ----------
document.getElementById('imp').addEventListener('change',e=>{
  if(typeof isAdmin==='function' && !isAdmin()){toast('🔒 เฉพาะผู้ดูแลระบบนำเข้าข้อมูลได้');e.target.value='';return;}
  const f=e.target.files[0];if(!f)return;const rd=new FileReader();
  rd.onload=ev=>{try{
    const wb=XLSX.read(ev.target.result,{type:'array'});
    const ws=wb.Sheets[wb.SheetNames[0]];
    // อ่านทั้งชีตเป็น array เพื่อหาแถวหัวตารางจริง (บางไฟล์มีแถวชื่อบริษัทอยู่ข้างบน)
    const aoa=XLSX.utils.sheet_to_json(ws,{header:1,defval:''});
    let hi=-1;
    for(let i=0;i<Math.min(aoa.length,10);i++){
      const rowTxt=(aoa[i]||[]).map(c=>String(c).trim());
      if(rowTxt.includes('รหัสสินค้า') && rowTxt.some(c=>c.includes('ใบสั่งขาย')||c.includes('ใบสั่ง'))){hi=i;break}
    }
    if(hi<0)hi=0; // ไม่เจอ ใช้แถวแรกตามเดิม
    const header=(aoa[hi]||[]).map(h=>String(h).trim()).filter(h=>h!=='');
    // แปลง array (ตั้งแต่แถวถัดจาก header) เป็น object โดยใช้ header ที่หาเจอ
    const rawHeader=(aoa[hi]||[]).map(h=>String(h).trim());
    const json=[];
    for(let i=hi+1;i<aoa.length;i++){
      const row=aoa[i]; if(!row)continue;
      // ข้ามแถวว่างทั้งแถว
      if(row.every(c=>String(c).trim()===''))continue;
      const o={};
      rawHeader.forEach((h,ci)=>{ if(h!=='')o[h]=row[ci]!==undefined?row[ci]:''; });
      json.push(o);
    }
    if(!json.length){toast('ไฟล์ว่าง หรือหาหัวตารางไม่พบ');return}
    DATA=json.map(normalizeRow);
    COLS=header.length?header:DEFAULT_COLS.slice();
    DATA.forEach((r,i)=>r._i=i);
    meta={file:f.name,time:new Date().toISOString()};
    saveData();render();renderInfo();renderStatBar();renderPicBar();
    toast('นำเข้าข้อมูล '+DATA.length+' บรรทัดแล้ว');
  }catch(err){toast('อ่านไฟล์ไม่สำเร็จ: '+err.message)}};
  rd.readAsArrayBuffer(f);e.target.value='';
});
function exportExcel(){
