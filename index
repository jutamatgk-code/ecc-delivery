      <button class="btn" onclick="exportStatus()">📤 ส่งออก Excel</button>
      <button class="btn" onclick="document.getElementById('impstatus').click()">📥 นำเข้า (CSV/Excel)</button>
      <input type="file" id="impstatus" accept=".xlsx,.xls,.csv" style="display:none">
    </div>
    <div class="search-bar" style="margin-top:14px">
      <input id="sq" placeholder="ค้นหาเลขใบสั่ง / ลูกค้า / โครงการ ..." autocomplete="off"
