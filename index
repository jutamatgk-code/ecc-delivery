function customerList(){
  return [...new Set(DATA.map(r=>r[F.cus]).filter(Boolean))].sort((a,b)=>String(a).localeCompare(String(b),'th'));
}
function projectsOfCustomer(cus){
  if(!cus)return [...new Set(DATA.map(r=>r[F.proj]).filter(Boolean))].sort((a,b)=>String(a).localeCompare(String(b),'th'));
  return [...new Set(DATA.filter(r=>String(r[F.cus])===cus).map(r=>r[F.proj]).filter(Boolean))]
    .sort((a,b)=>String(a).localeCompare(String(b),'th'));
}
function ordersOfCusProj(cus,proj){
  return [...new Set(DATA.filter(r=>String(r[F.cus])===cus && String(r[F.proj]||'')===proj)
    .map(r=>r[F.order]).filter(Boolean))].sort();
}
// key = ลูกค้า ‖ โครงการ ‖ ใบสั่งหลายเลข(คั่นด้วย ,)
const KSEP=' ‖ ';
function ordersKey(orders){return (orders||[]).map(o=>String(o).trim()).filter(Boolean).slice().sort().join(',')}
function addrKey(cus,proj,orders){return [String(cus||'').trim(),String(proj||'').trim(),ordersKey(orders)].join(KSEP)}
const nz=v=>String(v==null?'':v).trim();
// หาที่อยู่ที่ครอบคลุมใบสั่งนี้ (orders array มี o อยู่)
function findOrderAddr(cus,proj,order){
  const C=nz(cus),P=nz(proj),O=nz(order);
  for(const [k,a] of Object.entries(addrStore)){
    if(nz(a.cus)===C && nz(a.proj)===P && Array.isArray(a.orders) && a.orders.map(nz).includes(O))return [k,a];
  }
  return null;
}
// ที่อยู่ระดับโครงการ = orders ว่าง
function findProjectAddr(cus,proj){
  const C=nz(cus),P=nz(proj);
  for(const [k,a] of Object.entries(addrStore)){
    if(nz(a.cus)===C && nz(a.proj)===P && (!a.orders || a.orders.length===0))return [k,a];
  }
  return null;
}
// migration: รูปแบบเก่า -> รูปแบบใหม่ที่ orders เป็น array
(function migrateAddr(){
  let changed=false;
  Object.keys(addrStore).forEach(k=>{
    const a=addrStore[k];
    // เก่าสุด: key = ชื่อโครงการล้วน (ไม่มีตัวคั่น)
    if(k.indexOf(KSEP)===-1){a.proj=a.proj||k;a.cus=a.cus||'';}
    // แปลง order (string) -> orders (array)
    if(!Array.isArray(a.orders)){a.orders=a.order?[String(a.order)]:[]; }
    delete a.order;
    const nk=addrKey(a.cus||'',a.proj||'',a.orders);
    if(nk!==k){delete addrStore[k];addrStore[nk]=a;}
    changed=true;
  });
  if(changed)saveAddr();
})();

