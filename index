        <option value="cus_asc">จำนวนลูกค้า (น้อย→มาก)</option>
        <option value="pend_desc">ยอดคงค้าง (มาก→น้อย)</option>
        <option value="pend_asc">ยอดคงค้าง (น้อย→มาก)</option>
