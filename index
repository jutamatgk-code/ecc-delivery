// ---------- Calendar (ปฏิทินจัดส่ง ตามวันกำหนดส่ง) ----------
let calYear, calMonth; // เดือนที่แสดง
let calSel=new Set();  // วันที่เลือก (YYYY-MM-DD)
let calStatusSel=new Set(); // กรองสถานะในปฏิทิน (ว่าง = ทั้งหมด)
let calSort={key:'order',dir:1}; // การเรียงตารางวัน (key, dir 1=น้อย→มาก)
