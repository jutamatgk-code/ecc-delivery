async function ensureSeedAdmin(){
  try{
    const adminDoc=await db.collection('appUsers').doc('admin').get();
    if(!adminDoc.exists){
      const pin=await hashPin('1234');
      await db.collection('appUsers').doc('admin').set({
        name:'ผู้ดูแลระบบ',role:'admin',pin,active:true,
        tabs:ROLE_PRESETS.admin(),created:Date.now()
      });
      setFbStatus('สร้างผู้ดูแลเริ่มต้น (admin/1234)','ok');
    }
  }catch(e){console.error('seed error',e);}
}

async function doLogin(){
  loginError('');
  const u=document.getElementById('loginUser').value.trim().toLowerCase();
  const p=document.getElementById('loginPin').value;
  if(!u||!p){loginError('กรอกชื่อผู้ใช้และรหัสผ่าน');return;}
  if(!fbReady){loginError('ยังเชื่อมต่อฐานข้อมูลไม่สำเร็จ');return;}
  const btn=document.getElementById('loginBtn');btn.disabled=true;btn.textContent='กำลังตรวจสอบ…';
  try{
    const doc=await db.collection('appUsers').doc(u).get();
    if(!doc.exists){loginError('ไม่พบชื่อผู้ใช้นี้');return;}
    const data=doc.data();
    if(data.active===false){loginError('บัญชีนี้ถูกระงับ ติดต่อผู้ดูแล');return;}
    const ph=await hashPin(p);
    if(ph!==data.pin){loginError('รหัสผ่านไม่ถูกต้อง');return;}
    CURRENT_USER={username:u,...data};
    localStorage.setItem(SESSION_KEY,JSON.stringify({username:u}));
    document.getElementById('loginPin').value='';
    onLoginSuccess();
  }catch(err){
    console.error(err);loginError('เกิดข้อผิดพลาด ลองใหม่อีกครั้ง');
  }finally{btn.disabled=false;btn.textContent='เข้าสู่ระบบ';}
}
