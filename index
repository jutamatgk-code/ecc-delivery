function num(v){const n=Number(String(v).replace(/,/g,''));return isNaN(n)?0:n}
// แปลงค่าวันที่: รองรับ Excel serial (เช่น 45551.0000462963) และสตริงวันที่ทั่วไป -> YYYY-MM-DD
function fmtDate(v){
  if(v===''||v==null)return '';
  // ตัวเลข = Excel serial (นับจาก 1899-12-30)
  if(typeof v==='number' || (/^\d+(\.\d+)?$/.test(String(v).trim()) && Number(String(v))>20000)){
    const serial=Number(v);
    const ms=Math.round((serial-25569)*86400*1000); // 25569 = วันจาก 1970-01-01
    const d=new Date(ms);
    if(!isNaN(d)){const p=n=>String(n).padStart(2,'0');
      return d.getUTCFullYear()+'-'+p(d.getUTCMonth()+1)+'-'+p(d.getUTCDate())}
  }
  // ตัดเวลา 00:00:00 ทิ้งถ้ามี
  const m=String(v).match(/^(\d{4}-\d{2}-\d{2})/);
  if(m)return m[1];
  return String(v);
}
function normalizeRow(r){
  const o={};
  for(const k in r){const tk=String(k).trim();o[tk]=r[k];} // trim ชื่อคอลัมน์
