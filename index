async function saveUser(){
  const username=document.getElementById('uf-user').value.trim().toLowerCase();
  const name=document.getElementById('uf-name').value.trim();
  const pin=document.getElementById('uf-pin').value;
  const role=document.getElementById('uf-role').value;
  const active=document.getElementById('uf-active').value==='1';
  if(!username){toast('กรอกชื่อผู้ใช้');return;}
  if(!/^[a-z0-9_.-]+$/.test(username)){toast('ชื่อผู้ใช้ใช้ได้เฉพาะ a-z 0-9 _ . -');return;}
  if(!editingUser && !pin){toast('ตั้งรหัสผ่านสำหรับผู้ใช้ใหม่');return;}
  const data={name:name||username,role,active,
    tabs: role==='admin'?ROLE_PRESETS.admin():readPermGrid()};
  try{
    if(!editingUser){
      const exist=await db.collection('appUsers').doc(username).get();
      if(exist.exists){toast('มีชื่อผู้ใช้นี้อยู่แล้ว');return;}
      data.created=Date.now();
    }
    if(pin)data.pin=await hashPin(pin);
    await db.collection('appUsers').doc(username).set(data,{merge:true});
    // ถ้าแก้ตัวเอง อัปเดต session ปัจจุบัน
    if(editingUser===CURRENT_USER.username){
      CURRENT_USER={...CURRENT_USER,...data};onLoginSuccess();
    }
    closeUserForm();renderUsers();toast('💾 บันทึกผู้ใช้แล้ว');
  }catch(err){console.error(err);toast('บันทึกไม่สำเร็จ');}
}
