// drag & drop (อ้างด้วย id)
let qDragId=null;
let qSelPool=new Set(); // id ของ item ที่เลือกในคิวรอจัด
function qSelItem(id,on){if(on)qSelPool.add(id);else qSelPool.delete(id);updateQPoolBar();syncGroupChecks()}
function qSelGroup(order,on){
  const plan=qPlan();if(!plan)return;
  plan.pool.filter(it=>String(it.order)===String(order)).forEach(it=>{if(on)qSelPool.add(it.id);else qSelPool.delete(it.id)});
  renderQueue();
}
function syncGroupChecks(){
  // อัปเดต checkbox หัวกลุ่มให้ติ๊กเมื่อเลือกครบทั้งใบ
  document.querySelectorAll('.qpool-group').forEach(g=>{
    const rows=g.querySelectorAll('.qrow-chk');const all=[...rows].every(c=>c.checked);const some=[...rows].some(c=>c.checked);
    const gchk=g.querySelector('.qgrp-chk');if(gchk){gchk.checked=all;gchk.indeterminate=some&&!all;}
  });
}
function updateQPoolBar(){
  const bar=document.getElementById('qpool-actions');if(!bar)return;
  const n=qSelPool.size;
  bar.style.display=n?'flex':'none';
  const cnt=document.getElementById('qpool-selcount');if(cnt)cnt.textContent=n;
}
function qClearSel(){qSelPool.clear();renderQueue()}
function qRemoveSelected(){
  if(!qSelPool.size)return;
  if(!confirm('เอา '+qSelPool.size+' รายการออกจากคิว?'))return;
  const plan=qPlan();if(!plan)return;
  qSelPool.forEach(id=>removeItemFromEverywhere(plan,id));
  qSelPool.clear();saveQueue();renderQueue();toast('เอาออกแล้ว');
}
// ย้ายรายการที่เลือกเข้าเที่ยว/คัน
function qMoveSelected(){
  if(!qSelPool.size){toast('ยังไม่ได้เลือกรายการ');return}
  const plan=qPlan();if(!plan)return;
  // สร้างรายการเที่ยวให้เลือก
  const opts=[];
  trucks.forEach(t=>{for(let i=0;i<t.trips;i++)opts.push({key:t.id+'#'+i,label:t.name+' · เที่ยว '+(i+1)})});
  if(!opts.length){toast('ยังไม่มีรถ');return}
  const sel=document.getElementById('qmove-target');
  sel.innerHTML=opts.map(o=>`<option value="${o.key}">${esc(o.label)}</option>`).join('');
  document.getElementById('qmove-count').textContent=qSelPool.size;
  document.getElementById('qmove-modal').classList.remove('hidden');
}
function qMoveConfirm(){
  const key=document.getElementById('qmove-target').value;
  const plan=qPlan();if(!plan||!key)return;
  const ids=[...qSelPool];
  ids.forEach(id=>{const it=findItem(plan,id);if(!it)return;removeItemFromEverywhere(plan,id);if(!plan.assign[key])plan.assign[key]=[];plan.assign[key].push(it)});
  qSelPool.clear();saveQueue();document.getElementById('qmove-modal').classList.add('hidden');renderQueue();
  toast('ย้าย '+ids.length+' รายการแล้ว');
}
function qMoveCancel(){document.getElementById('qmove-modal').classList.add('hidden')}
function qDragStart(e){const c=e.target.closest('.qcard,.qpool-r,.qtrip-r');if(!c)return;qDragId=c.dataset.id;c.classList.add('dragging');e.dataTransfer.effectAllowed='move'}
function qDragEnd(e){e.target.closest('.qcard,.qpool-r,.qtrip-r')?.classList.remove('dragging')}
function qDragOver(e){e.preventDefault();e.currentTarget.classList.add('over')}
function qDragLeave(e){e.currentTarget.classList.remove('over')}
function findItem(plan,id){
  let it=plan.pool.find(x=>x.id===id);if(it)return it;
  for(const k in plan.assign){it=plan.assign[k].find(x=>x.id===id);if(it)return it}
  return null;
}
function removeItemFromEverywhere(plan,id){
  plan.pool=plan.pool.filter(x=>x.id!==id);
  Object.keys(plan.assign).forEach(k=>{plan.assign[k]=plan.assign[k].filter(x=>x.id!==id)});
}
function qDrop(e,key){
  e.preventDefault();e.currentTarget.classList.remove('over');
  if(!qDragId)return;
  const plan=qPlan();if(!plan)return;
  const it=findItem(plan,qDragId);if(!it){qDragId=null;return}
  removeItemFromEverywhere(plan,qDragId);
  if(!plan.assign[key])plan.assign[key]=[];
  plan.assign[key].push(it);
  qDragId=null;saveQueue();renderQueue();
}
function qRemoveItem(id){const plan=qPlan();if(!plan)return;removeItemFromEverywhere(plan,id);saveQueue();renderQueue()}
function qSetQty(id,val){const plan=qPlan();if(!plan)return;const it=findItem(plan,id);if(!it)return;it.qty=Math.max(0,num(val));saveQueue();
  // อัปเดตยอดรวมเที่ยวโดยไม่วาดใหม่ทั้งหน้า
  renderQueue();}

// trucks management
function changeTrips(id,delta){const t=trucks.find(x=>x.id===id);if(!t)return;
  const plan=qPlan();
  if(delta<0 && plan){ // ถ้าลดเที่ยว ให้ย้ายรายการเที่ยวสุดท้ายกลับ pool
    const key=id+'#'+(t.trips-1);if(plan.assign[key]){plan.assign[key].forEach(it=>plan.pool.push(it));delete plan.assign[key];saveQueue()}
  }
  t.trips=Math.max(1,Math.min(9,t.trips+delta));saveTrucks();renderQueue();
}
function removeTruck(id){const t=trucks.find(x=>x.id===id);if(!t)return;
  if(!confirm('ลบรถ "'+t.name+'" ?\nรายการที่จัดในรถนี้จะกลับไปคิวรอจัด'))return;
  const plan=qPlan();if(plan){Object.keys(plan.assign).forEach(k=>{if(k.startsWith(id+'#')){plan.assign[k].forEach(it=>plan.pool.push(it));delete plan.assign[k]}});saveQueue()}
  trucks=trucks.filter(x=>x.id!==id);saveTrucks();renderQueue();
}
function manageTrucks(){
  const name=prompt('เพิ่มรถใหม่ — พิมพ์ชื่อรถ (เช่น 11.5 ตัน 10ล้อ ประหยัด):\n\n(กด OK โดยเว้นว่างเพื่อยกเลิก)');
  if(!name||!name.trim())return;
  const tr=prompt('รถคันนี้วิ่งกี่เที่ยว?','2');
  const trips=Math.max(1,Math.min(9,parseInt(tr)||1));
  trucks.push({id:'t'+Date.now(),name:name.trim(),trips});saveTrucks();renderQueue();
  toast('🚛 เพิ่มรถแล้ว');
}

// picker: เลือกรายสินค้า + ระบุจำนวน, กรองตามวันจัดส่งที่เลือก
let qpLines={}; // key = order‖code -> {sel:bool, qty:number}
function openQueuePicker(){
  if(!qDay()){toast('เลือกวันจัดส่งก่อน');return}
  qpLines={};document.getElementById('qp-search').value='';
  document.getElementById('qp-onlyday').checked=true;
  document.getElementById('qp-date').value=qDay(); // ค่าเริ่มต้น = วันจัดคิว
  renderQueuePicker();document.getElementById('queue-picker').classList.remove('hidden');
}
function closeQueuePicker(){document.getElementById('queue-picker').classList.add('hidden')}
function pickerRows(){
  const q=(document.getElementById('qp-search').value||'').trim().toLowerCase();
  const onlyDay=document.getElementById('qp-onlyday').checked;
  const d=document.getElementById('qp-date').value||qDay();
  return DATA.filter(r=>{
    if(!r[F.order])return false;
    if(onlyDay && String(r[F.ship]||'').slice(0,10)!==d)return false;
    if(q)return [r[F.order],r[F.cus],r[F.proj],r[F.code],r[F.name]].some(v=>String(v||'').toLowerCase().includes(q));
    return true;
  });
}
function renderQueuePicker(){
  const rows=pickerRows();
  // จัดกลุ่มตามใบสั่ง
  const om=new Map();
  rows.forEach(r=>{const o=r[F.order];if(!om.has(o))om.set(o,[]);om.get(o).push(r)});
  let selCount=0;Object.values(qpLines).forEach(v=>{if(v.sel)selCount++});
  document.getElementById('qp-sel').textContent=selCount;
  const box=document.getElementById('qp-list');
  if(!om.size){box.innerHTML='<div style="text-align:center;color:var(--muted);padding:20px">ไม่พบรายการ'+(document.getElementById('qp-onlyday').checked?' (ลองเปลี่ยนวันที่ หรือปิด “เฉพาะวันจัดส่ง”)':'')+'</div>';return}
  box.innerHTML=[...om.entries()].sort((a,b)=>String(a[0]).localeCompare(String(b[0]))).map(([ono,orows])=>{
    const r0=orows[0];const sd=statusDef(orderStatus(ono));
    const lines=orows.map(r=>{
      const key=ono+'‖'+r[F.code];
      const st=qpLines[key]||{sel:false,qty:num(r[F.pend])};
      const kk=esc(key).replace(/'/g,"\\'");
      return `<div class="qp-line ${st.sel?'sel':''}">
        <input type="checkbox" ${st.sel?'checked':''} onchange="qpToggleLine('${kk}',${num(r[F.pend])})">
        <div style="flex:1">
          <div style="font-size:.83rem">${esc(r[F.name])} <span style="color:var(--muted)">(${esc(r[F.code])})</span></div>
          <div style="font-size:.73rem;color:var(--muted)">ค้างส่ง ${num(r[F.pend]).toLocaleString()} / สั่ง ${num(r[F.qty]).toLocaleString()}${stock[String(r[F.code]).trim()]!==undefined?' · สต็อก '+num(stock[String(r[F.code]).trim()]).toLocaleString():''}</div>
        </div>
        <label style="font-size:.75rem;color:var(--muted)">ส่ง <input type="number" min="0" class="qty-input" value="${st.qty}" ${st.sel?'':'disabled'} onchange="qpSetQty('${kk}',this.value)"></label>
      </div>`;
    }).join('');
    return `<div class="qp-order">
      <div class="qp-order-head">
        <b style="color:var(--aqua-d)">${esc(ono)}</b>
        <span class="ostatus" style="background:${sd.bg};color:${sd.color};font-size:.68rem">${sd.label}</span>
        <span style="font-size:.78rem;color:var(--muted)">${esc(r0[F.cus]||'-')} · ${esc(r0[F.proj]||'-')} · กำหนดส่ง ${esc(r0[F.ship]||'-')}</span>
        <button class="qbtn" style="margin-left:auto;font-size:.74rem;padding:4px 9px" onclick="qpSelectOrder('${esc(ono).replace(/'/g,"\\'")}')">เลือกทั้งใบ</button>
      </div>
      ${lines}
    </div>`;
  }).join('');
}
function qpToggleLine(key,pend){
  const cur=qpLines[key]||{sel:false,qty:pend};
  cur.sel=!cur.sel;if(cur.qty===undefined||cur.qty==='')cur.qty=pend;
  qpLines[key]=cur;renderQueuePicker();
}
