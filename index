let planView='need';
let planCharts=[];
function setPlanView(v){planView=v;document.querySelectorAll('#tab-plan [data-pv]').forEach(b=>b.classList.toggle('on',b.dataset.pv===v));renderPlan()}
function planData(statusF){
  // รวมต่อรหัส: ค้างรวม + สต็อก + จำนวนลูกค้า/ใบสั่ง + น้ำหนัก
  const map=new Map();
  DATA.forEach(r=>{
    const code=String(r[F.code]).trim();if(!code)return;
    const pend=num(r[F.pend]);if(pend<=0)return;
    const sid=orderStatus(r[F.order]);
    if(statusF!==undefined && statusF!=='all'){ if(sid!==statusF)return; }  // กรองตามสถานะที่เลือก (รวมค่าว่าง=จัดส่งทั่วไป)
    else { if(sid==='cancel')return; }                                       // ค่าเริ่มต้น: ข้ามใบยกเลิก
    let o=map.get(code);
    if(!o){o={code,name:r[F.name]||'',stock:num(stock[code]),pend:0,cus:new Set(),orders:new Set(),w:weightOf(code),type:(WEIGHTS[code]||{}).t||''};map.set(code,o);}
    o.pend+=pend;o.cus.add(r[F.cus]||'-');o.orders.add(r[F.order]||'-');
  });
  return [...map.values()].map(o=>{
    o.need=Math.max(0,o.pend-o.stock);       // ต้องผลิตเพิ่ม
    o.ready=Math.min(o.pend,o.stock);         // ส่งได้จากสต็อก
    o.cusCount=o.cus.size;o.orderCount=o.orders.size;
    o.needW=o.w?o.need*o.w:0;o.pendW=o.w?o.pend*o.w:0;
    return o;
  });
}
function renderPlan(){
  const q=(document.getElementById('plansearch').value||'').trim().toLowerCase();
  const typeF=document.getElementById('plan-type').value;
  const statusF=document.getElementById('plan-status').value;
  // เติม dropdown สถานะ (ครั้งเดียว)
  const stSel=document.getElementById('plan-status');
  if(stSel.options.length<=1){
    stSel.innerHTML='<option value="all">ทุกสถานะ (ไม่รวมยกเลิก)</option>'+
      STATUSES.map(s=>`<option value="${s.id}">${s.emoji} ${s.label}</option>`).join('');
  }
  let all=planData(statusF);
  // เติม dropdown ประเภท (ครั้งเดียว)
  const typeSel=document.getElementById('plan-type');
  if(typeSel.options.length<=1){
    const types=[...new Set(planData().map(o=>o.type).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'th'));
    typeSel.innerHTML='<option value="">ทุกประเภท</option>'+types.map(t=>`<option value="${esc(t)}">${esc(t)}</option>`).join('');
  }
  if(typeF)all=all.filter(o=>o.type===typeF);
  if(q)all=all.filter(o=>o.code.toLowerCase().includes(q)||String(o.name).toLowerCase().includes(q)||String(o.type).toLowerCase().includes(q));

  // สถิติภาพรวม
  const needList=all.filter(o=>o.need>0);
  const readyList=all.filter(o=>o.ready>0);
  const totNeed=needList.reduce((s,o)=>s+o.need,0);
  const totReady=readyList.reduce((s,o)=>s+o.ready,0);
  const totNeedW=needList.reduce((s,o)=>s+o.needW,0);
  // สรุป commit FIFO (พร้อมส่งจริงจากสต็อก)
  const cm=computeCommit();let cFull=0,cShort=0;cm.forEach(c=>{if(c.canShip)cFull++;cShort+=c.short;});
  document.getElementById('planstats').innerHTML=`
    <div class="stat"><div class="n" style="color:var(--terra-d)">${needList.length.toLocaleString()}</div><div class="l">รายการต้องผลิต</div></div>
    <div class="stat"><div class="n" style="color:var(--terra-d)">${totNeed.toLocaleString()}</div><div class="l">ชิ้นต้องผลิต</div></div>
    <div class="stat"><div class="n" style="color:var(--green)">${cFull.toLocaleString()}</div><div class="l">พร้อมส่ง (Commit)</div></div>
    <div class="stat"><div class="n" style="color:var(--red)">${cShort.toLocaleString()}</div><div class="l">ขาด (Commit)</div></div>
    <div class="stat"><div class="n">${totNeedW?(totNeedW/1000).toLocaleString(undefined,{maximumFractionDigits:1}):'0'}</div><div class="l">ตันต้องผลิต</div></div>`;

  let list, metric, metricLabel, color;
  if(planView==='need'){list=needList.slice().sort((a,b)=>b.need-a.need);metric='need';metricLabel='ต้องผลิต';color='var(--terra)';}
  else if(planView==='ready'){list=readyList.slice().sort((a,b)=>b.ready-a.ready);metric='ready';metricLabel='พร้อมส่ง';color='var(--green)';}
  else {list=all.slice().sort((a,b)=>b.pend-a.pend);metric='pend';metricLabel='ค้างรวม';color='var(--aqua)';}

  const body=document.getElementById('plan-body');
  if(!list.length){body.innerHTML='<div class="empty"><div class="big">📈</div><p>ไม่มีรายการ</p></div>';return}

  // Top 15 สำหรับชาร์ต
