function inDateRange(r){
  const from=dateFrom, to=dateTo;
  if(!from && !to)return true;
  const field = dateField==='odate'?F.odate:F.ship;
  const v=String(r[field]||'').slice(0,10); // YYYY-MM-DD
  if(!v)return false; // ไม่มีวันที่ = ไม่เข้าช่วง
  if(from && v<from)return false;
  if(to && v>to)return false;
  return true;
}
function filteredRows(){
  const q=qEl.value.trim();
  const lq=q.toLowerCase();
  const useStatus=statusSel.size>0;
  return DATA.filter(r=>{
    if(!inDateRange(r))return false;
    if(useStatus && !statusSel.has(orderStatus(r[F.order])))return false;
    if(picSel && String(r[F.pic]||'')!==picSel)return false;
    if(!q)return true;
    const c=String(r[F.code]).toLowerCase(),n=String(r[F.name]).toLowerCase();
    const cu=String(r[F.cus]).toLowerCase(),cc=String(r[F.cuscode]).toLowerCase();
    const od=String(r[F.order]).toLowerCase();
    if(mode==='code')return c.includes(lq);
    if(mode==='name')return n.includes(lq);
    if(mode==='cus')return cu.includes(lq)||cc.includes(lq);
    if(mode==='order')return od.includes(lq);
    return c.includes(lq)||n.includes(lq)||cu.includes(lq)||cc.includes(lq)||od.includes(lq);
  });
}

