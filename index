// คัดลอกตารางแผนจัดส่งของวันเป็นรูปภาพลงคลิปบอร์ด
// คัดลอกตารางเป็น TSV (คอลัมน์ตรงกับไฟล์ export) — onlyPicked=true คัดเฉพาะใบที่ติ๊กเลือก
function copyDayTSV(k,btn,onlyPicked){
  let rows=(shipMap().get(k)||[]);
  if(!rows.length){toast('ไม่มีรายการ');return}
  if(onlyPicked){
    // หาใบสั่งที่ติ๊ก .qsel ในบล็อกวันนี้
    const block=document.getElementById('calday-'+k);
    const picked=new Set();
    if(block)block.querySelectorAll('.qsel:checked').forEach(cb=>picked.add(String(cb.dataset.order)));
    if(!picked.size){toast('ยังไม่ได้เลือกใบสั่ง (ติ๊ก ☐ เลือก ที่ใบที่ต้องการ)');return}
    rows=rows.filter(r=>picked.has(String(r[F.order])));
  }
  const clean=s=>String(s==null?'':s).replace(/[\t\r\n]/g,' ').trim();
  const sorted=[...rows].sort((a,b)=>String(a[F.order]).localeCompare(String(b[F.order])));
  const lines=[];
  sorted.forEach(r=>{
    const pr=prodReply[prodKey(r[F.order],r[F.code])]||{};
    const prStatusLabel=(PROD_STATUSES.find(s=>s.id===(pr.status||''))||{}).label||'';
    const noteParts=[];
    if(pr.newDate)noteParts.push('เลื่อนนัด '+pr.newDate);
    if(pr.note)noteParts.push(pr.note);
    const pv=pendValue(r);
    lines.push([
      clean(r[F.order]), clean(r[F.odate]), clean(r[F.code]), clean(r[F.name]),
      num(r[F.qty]), num(r[F.pend]),
      '', (pr.qty!=null&&pr.qty!=='')?num(pr.qty):'', '', pv>0?Math.round(pv):'',
      clean(r[F.cus]), '',
      '', clean(prStatusLabel.replace(/^[^ก-๙A-Za-z]+/,'').trim()), '', '', clean(noteParts.join(' · '))
    ].join('\t'));
  });
  const tsv=lines.join('\n');
  const nOrd=new Set(sorted.map(r=>String(r[F.order]))).size;
  const done=()=>toast('📋 คัดลอกแล้ว '+nOrd+' ใบสั่ง — วางใน Excel ได้เลย');
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(tsv).then(done).catch(()=>fallbackCopy(tsv,done));
  }else fallbackCopy(tsv,done);
}
function fallbackCopy(text,cb){
  const ta=document.createElement('textarea');ta.value=text;ta.style.position='fixed';ta.style.left='-9999px';
  document.body.appendChild(ta);ta.select();
  try{document.execCommand('copy');cb&&cb();}catch(e){toast('คัดลอกไม่สำเร็จ');}
  document.body.removeChild(ta);
}
async function copyDayImage(k,btn){
  if(typeof html2canvas==='undefined'){toast('ต้องต่อเน็ตครั้งแรกเพื่อโหลดตัวแปลงรูป');return}
  const block=document.getElementById('calday-'+k);
  if(!block){toast('ไม่พบตาราง');return}
  const oldTxt=btn?btn.textContent:'';if(btn){btn.textContent='⏳ กำลังสร้างรูป...';btn.disabled=true}
  function restore(){if(btn){btn.textContent=oldTxt;btn.disabled=false}}
  try{
    // clone ตาราง แล้ว "เผาสี" (คำนวณสีจริงจากจอ ใส่เป็น inline style ค่าตายตัว)
    // เพื่อเลี่ยงปัญหา html2canvas เรนเดอร์ CSS var / สีสมัยใหม่ (oklch) ออกมาจาง
    const clone=block.cloneNode(true);
    // ถ้ามีการติ๊กเลือกใบสั่ง -> เก็บเฉพาะกลุ่มที่เลือก
    const picked=[...block.querySelectorAll('.qsel:checked')].map(c=>c.dataset.order);
    if(picked.length){
      const set=new Set(picked);
      clone.querySelectorAll('tbody tr[data-order]').forEach(tr=>{
        if(!set.has(tr.getAttribute('data-order')))tr.remove();
      });
    }
    // ซ่อน checkbox/label เลือก ในรูป
    clone.querySelectorAll('.qsel-lbl').forEach(el=>el.remove());
    // ซ่อน checkbox/label เลือก ในรูป
    clone.querySelectorAll('.qsel-lbl').forEach(el=>el.remove());
    clone.querySelectorAll('button').forEach(b=>b.style.display='none');
    // วาง clone นอกจอก่อน เพื่อให้ CSS ทำงานแล้วอ่านสีจริงได้
    const holder=document.createElement('div');
    holder.style.cssText='position:fixed;left:-99999px;top:0;background:#fff;padding:16px;width:'+block.offsetWidth+'px';
    holder.appendChild(clone);document.body.appendChild(holder);
    // เผาสี: อ่าน computed จาก clone เอง แล้วเขียน inline ค่าตายตัว (กัน html2canvas อ่านเพี้ยน)
    const PROPS=['color','backgroundColor','borderColor','borderTopColor','borderRightColor','borderBottomColor','borderLeftColor'];
    const all=clone.querySelectorAll('*');
    const bakeSelf=d=>{const cs=getComputedStyle(d);const vals={};PROPS.forEach(p=>vals[p]=cs[p]);
      const fw=cs.fontWeight,fs=cs.fontSize;
      PROPS.forEach(p=>d.style[p]=vals[p]);d.style.fontWeight=fw;d.style.fontSize=fs;
      d.style.opacity='1';d.style.animation='none';d.style.transition='none';d.style.filter='none';d.style.boxShadow='none';};
    bakeSelf(clone);
    for(const el of all)bakeSelf(el);

    const canvas=await html2canvas(holder,{backgroundColor:'#ffffff',scale:2});
    document.body.removeChild(holder);
    canvas.toBlob(async(blob)=>{
      if(!blob){toast('สร้างรูปไม่สำเร็จ');restore();return}
      try{
        if(navigator.clipboard&&window.ClipboardItem){
          await navigator.clipboard.write([new ClipboardItem({'image/png':blob})]);
          toast('🖼️ คัดลอกรูปลงคลิปบอร์ดแล้ว');
        }else throw new Error('no-clipboard');
      }catch(err){
        const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='แผนจัดส่ง_'+k+'.png';a.click();
        toast('เบราว์เซอร์ไม่รองรับคัดลอกรูป — ดาวน์โหลดให้แทน');
      }
      restore();
    },'image/png');
  }catch(err){toast('สร้างรูปไม่สำเร็จ: '+err.message);restore();}
}

// คัดลอก element ใดๆ เป็นรูปภาพ (ใช้กับตารางลูกค้าที่กางในแท็บแผน ฯลฯ)
async function copyElementImage(el,filename,btn){
  if(typeof html2canvas==='undefined'){toast('ต้องต่อเน็ตครั้งแรกเพื่อโหลดตัวแปลงรูป');return}
  if(!el){toast('ไม่พบตาราง');return}
  const oldTxt=btn?btn.textContent:'';if(btn){btn.textContent='⏳ กำลังสร้างรูป...';btn.disabled=true}
  function restore(){if(btn){btn.textContent=oldTxt;btn.disabled=false}}
  try{
    const clone=el.cloneNode(true);
    clone.querySelectorAll('button').forEach(b=>b.style.display='none');
    const holder=document.createElement('div');
    holder.style.cssText='position:fixed;left:-99999px;top:0;background:#fff;padding:16px;width:'+Math.max(el.offsetWidth,640)+'px';
    holder.appendChild(clone);document.body.appendChild(holder);
    const PROPS=['color','backgroundColor','borderColor','borderTopColor','borderRightColor','borderBottomColor','borderLeftColor'];
    const bakeSelf=d=>{const cs=getComputedStyle(d);const vals={};PROPS.forEach(p=>vals[p]=cs[p]);
      const fw=cs.fontWeight,fs=cs.fontSize;PROPS.forEach(p=>d.style[p]=vals[p]);d.style.fontWeight=fw;d.style.fontSize=fs;
      d.style.opacity='1';d.style.animation='none';d.style.transition='none';d.style.filter='none';d.style.boxShadow='none';};
    bakeSelf(clone);for(const e of clone.querySelectorAll('*'))bakeSelf(e);
    const canvas=await html2canvas(holder,{backgroundColor:'#ffffff',scale:2});
    document.body.removeChild(holder);
    canvas.toBlob(async(blob)=>{
      if(!blob){toast('สร้างรูปไม่สำเร็จ');restore();return}
      try{
        if(navigator.clipboard&&window.ClipboardItem){
          await navigator.clipboard.write([new ClipboardItem({'image/png':blob})]);
          toast('🖼️ คัดลอกรูปลงคลิปบอร์ดแล้ว');
        }else throw new Error('no-clipboard');
      }catch(err){
        const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=(filename||'ตาราง')+'.png';a.click();
        toast('เบราว์เซอร์ไม่รองรับคัดลอกรูป — ดาวน์โหลดให้แทน');
      }
      restore();
    },'image/png');
  }catch(err){toast('สร้างรูปไม่สำเร็จ: '+err.message);restore();}
}
// คัดลอกรูปตารางลูกค้าที่กางในแท็บแผน (รวมแถวสินค้าด้วย)
function copyPlanCusImage(cid,code,btn){
  const detRow=document.getElementById(cid);
  const prodRow=detRow?detRow.previousElementSibling:null; // แถวสินค้า (อยู่ก่อนแถวรายละเอียด)
  const inner=detRow?detRow.querySelector('.commit-detail-inner'):null;
  if(!inner){toast('ไม่พบตาราง');return}
  // สร้าง wrapper ชั่วคราว: หัวแถวสินค้า + ตารางลูกค้า
  const wrap=document.createElement('div');
  wrap.style.cssText='background:#fff';
  // ดึงหัวข้อสินค้าจากแถวสินค้า (คอลัมน์ต่างๆ) มาทำเป็นแถบสรุป
  if(prodRow){
    const tds=prodRow.querySelectorAll('td');
    const g=(i)=>tds[i]?tds[i].innerText.trim().replace(/^[▸▾]\s*/,''):'';
    const head=document.createElement('div');
    head.style.cssText='padding:10px 12px;margin-bottom:8px;border:1.5px solid var(--line);border-radius:10px;background:var(--tint2)';
    head.innerHTML=`<div style="font-weight:800;font-size:.95rem;color:var(--ink)">${esc(g(1))}</div>
      <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:6px;font-size:.8rem">
        <span>ค้างรวม: <b style="color:var(--terra-d)">${esc(g(2))}</b></span>
        <span>สต็อก: <b>${esc(g(3))}</b></span>
        <span>ต้องผลิต/พร้อมส่ง: <b style="color:var(--terra-d)">${esc(g(4))}</b></span>
        <span>ลูกค้า: <b>${esc(g(5))}</b></span>
        <span>ใบสั่ง: <b>${esc(g(6))}</b></span>
        <span>น้ำหนัก: <b>${esc(g(7))}</b></span>
      </div>`;
    wrap.appendChild(head);
  }
  wrap.appendChild(inner.cloneNode(true));
  copyElementImage(wrap,'ลูกค้าที่ติด_'+code,btn);
}

// แถวตารางในคิวรอจัด (ลากได้ + checkbox)
function qPoolRow(it){
  const info=lineInfo(it.order,it.code);
  if(!info)return '';
  const w=weightOf(String(it.code).trim());
  const lineW=w!=null?w*num(it.qty):null;
  const checked=qSelPool.has(it.id)?'checked':'';
  return `<tr class="qpool-r" draggable="true" data-id="${it.id}" data-order="${esc(it.order)}" data-from="pool"
      ondragstart="qDragStart(event)" ondragend="qDragEnd(event)">
    <td style="width:26px;text-align:center"><input type="checkbox" class="qrow-chk" ${checked} onclick="event.stopPropagation()" onmousedown="event.stopPropagation()" onchange="qSelItem('${it.id}',this.checked)"></td>
    <td><div style="font-size:.78rem">${esc(info.name)} <span style="color:var(--muted)">(${esc(it.code)})</span></div>
      <div style="font-size:.7rem;color:var(--muted)">ค้าง ${info.pend.toLocaleString()}${lineW!=null?' · '+lineW.toLocaleString(undefined,{maximumFractionDigits:0})+' กก.':''}</div></td>
    <td style="text-align:center"><input type="number" min="0" value="${num(it.qty)}" class="qty-input" style="width:54px" onchange="qSetQty('${it.id}',this.value)" onclick="event.stopPropagation()" onmousedown="event.stopPropagation()"></td>
    <td style="text-align:center"><button class="qc-x" onclick="qRemoveItem('${it.id}')" title="เอาออก">×</button></td>
  </tr>`;
}
// รายการในเที่ยว จัดกลุ่มตามใบสั่ง + ข้อมูลลูกค้า/ที่อยู่/PIC
function tripGroupsHtml(list,key){
  const om=new Map();list.forEach(it=>{const o=it.order;if(!om.has(o))om.set(o,[]);om.get(o).push(it)});
  return [...om.entries()].map(([ono,items])=>{
    const info0=lineInfo(items[0].order,items[0].code);
    const r0=DATA.find(r=>String(r[F.order])===String(ono));
    const sd=info0?statusDef(info0.status):{bg:'',color:'',label:''};
    const gQ=items.reduce((s,it)=>s+num(it.qty),0);
    const gW=items.reduce((s,it)=>{const w=weightOf(String(it.code).trim());return s+(w!=null?w*num(it.qty):0)},0);
    // ที่อยู่
    const addr=r0?(findOrderAddr(r0[F.cus],r0[F.proj]||'',ono)||findProjectAddr(r0[F.cus],r0[F.proj]||'')):null;
    const a=addr?addr[1]:null;
    const info=[];
    if(r0&&r0[F.proj]&&r0[F.proj]!=='ไม่ระบุโครงการ,งาน')info.push('🏗️ '+esc(r0[F.proj]));
    if(r0&&r0[F.pic])info.push('👤 PIC: '+esc(r0[F.pic]));
    if(a&&a.name)info.push('🙍 ผู้รับ: '+esc(a.name));
    {const _pl=(a?phoneLinks(a):'');if(_pl)info.push(_pl);}
    const full=addrFull(a);
    if(full)info.push('🏠 '+esc(full));
    if(a&&a.note)info.push('📝 '+esc(a.note));
    if(a&&a.loc)info.push('<a href="'+esc(a.loc)+'" target="_blank" rel="noopener" style="color:var(--aqua-d);font-weight:700;text-decoration:none">📍 แผนที่</a>');
    const rows=items.map(it=>qTripRow(it,key)).join('');
    return `<div class="qtrip-group">
      <div class="qtrip-ghead">
        <span class="qc-no">${esc(ono)}</span>
        <span class="ostatus" style="background:${sd.bg};color:${sd.color};font-size:.64rem">${sd.label}</span>
        <span style="font-weight:700;color:var(--ink)">${esc(info0?info0.cus:'')||'-'}</span>
        <span style="font-size:.72rem;color:var(--muted);margin-left:auto">${items.length} รายการ · ${gQ.toLocaleString()} ชิ้น${gW?' · '+gW.toLocaleString(undefined,{maximumFractionDigits:0})+' กก.':''}</span>
      </div>
      ${info.length?'<div class="qtrip-ginfo">'+info.map(x=>'<span>'+x+'</span>').join('')+'</div>':''}
      <table class="qtrip-tbl"><tbody>${rows}</tbody></table>
    </div>`;
  }).join('');
}
// แถวตารางในเที่ยวรถ (ลากได้ + น้ำหนัก)
