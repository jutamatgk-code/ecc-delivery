  const todayIso=new Date().toISOString().slice(0,10);
  // แถวหัวเดือน (รวมช่องของเดือนเดียวกัน)
  const monthSpans=[];let cur=null;
  cells.forEach(c=>{if(!cur||cur.mon!==c.mon){cur={mon:c.mon,count:0};monthSpans.push(cur)}cur.count++});
  const COLW=30;
  let monthRow='<tr class="g-month"><th class="g-fix" colspan="8"></th>';
  monthSpans.forEach(m=>{monthRow+=`<th colspan="${m.count}">${th[m.mon]}</th>`;});
  monthRow+='</tr>';
  let dayRow='<tr class="g-daynum"><th class="g-fix">ลูกค้า</th><th class="g-fix">ใบสั่ง</th><th class="g-fix">วันที่สั่ง</th><th class="g-fix">รหัส</th><th class="g-fix">สินค้า</th><th class="g-fix">ค้าง/สั่ง</th><th class="g-fix">สต็อก</th><th class="g-fix">ต้องการ</th>';
  cells.forEach(c=>{const wk=(c.dow===0||c.dow===6);dayRow+=`<th class="${wk?'wk':''} ${c.iso===todayIso?'today':''}" style="min-width:${COLW}px">${c.day}</th>`;});
  dayRow+='</tr>';

  const body=plan.items.map(({it,info,prodDays,shipDays})=>{
