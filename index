];
const STRUCK_KEY='ecc_strucks_v1';
let stockTrucks=(()=>{try{const s=JSON.parse(localStorage.getItem(STRUCK_KEY)||'null');
  if(Array.isArray(s)&&s.length){
    let list=s.map(t=>({name:String(t.name||''),cap:num(t.cap)}));
