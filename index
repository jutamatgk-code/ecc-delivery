      pointBackgroundColor:'#e17055',pointRadius:5,pointHoverRadius:7}]},options:baseOpts(false)});

  // 6) Top 10 มูลค่าคงค้างตามลูกค้า
  const valMap=new Map();
  DATA.forEach(r=>{const v=pendValue(r);if(v>0){const k=r[F.cus]||r[F.cuscode];valMap.set(k,(valMap.get(k)||0)+v)}});
