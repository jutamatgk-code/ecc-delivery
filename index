    if(q.length<2){box.classList.remove('show');box.innerHTML='';return;}
    // จับคู่: ใบสั่ง / ลูกค้า / รหัส / โครงการ
    const orderHits=new Map(), cusHits=new Map(), codeHits=new Map();
    DATA.forEach(r=>{
      if(num(r[F.pend])<=0)return;
      const o=String(r[F.order]||''), c=String(r[F.cus]||''), code=String(r[F.code]||''), pj=String(r[F.proj]||'');
      if(o.toLowerCase().includes(q))orderHits.set(o,(orderHits.get(o)||0)+num(r[F.pend]));
      if(c.toLowerCase().includes(q))cusHits.set(c,(cusHits.get(c)||0)+1);
      if(code.toLowerCase().includes(q)||String(r[F.name]||'').toLowerCase().includes(q))codeHits.set(code,{name:r[F.name],pend:(codeHits.get(code)?codeHits.get(code).pend:0)+num(r[F.pend])});
      if(pj.toLowerCase().includes(q))cusHits.set(c+' · '+pj,(cusHits.get(c+' · '+pj)||0)+1);
    });
    let html='';
    const esc2=s=>esc(String(s));
    if(orderHits.size){html+='<div class="gs-group">📄 ใบสั่งขาย</div>'+[...orderHits.entries()].slice(0,6).map(([o,p])=>
      `<div class="gs-item" onclick="gsGoOrder('${esc2(o).replace(/'/g,"\\'")}')">${esc2(o)} <span class="gs-meta">ค้าง ${p.toLocaleString()}</span></div>`).join('');}
    if(cusHits.size){html+='<div class="gs-group">🏢 ลูกค้า/โครงการ</div>'+[...cusHits.entries()].slice(0,6).map(([c,n])=>
      `<div class="gs-item" onclick="gsGoCus('${esc2(c.split(' · ')[0]).replace(/'/g,"\\'")}')">${esc2(c)} <span class="gs-meta">${n} รายการ</span></div>`).join('');}
    if(codeHits.size){html+='<div class="gs-group">📦 สินค้า</div>'+[...codeHits.entries()].slice(0,6).map(([code,d])=>
      `<div class="gs-item" onclick="gsGoCode('${esc2(code).replace(/'/g,"\\'")}')">${esc2(code)} — ${esc2(d.name)} <span class="gs-meta">ค้าง ${d.pend.toLocaleString()}</span></div>`).join('');}
    if(!html)html='<div class="gs-empty">ไม่พบรายการที่ค้างส่งตรงกับ "'+esc2(q)+'"</div>';
    box.innerHTML=html;box.classList.add('show');
  },200);
}
