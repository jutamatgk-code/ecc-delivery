document.getElementById('impstock').addEventListener('change',e=>{
  if(typeof isAdmin==='function' && !isAdmin()){toast('🔒 เฉพาะผู้ดูแลระบบชนสต็อกได้');e.target.value='';return;}
  const f=e.target.files[0];if(!f)return;const rd=new FileReader();
