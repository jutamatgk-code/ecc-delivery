  // 4) สถานะสต็อก (donut)
  let ok=0,short=0,na=0;
  groups.forEach(g=>{if(stock[g.code]===undefined)na++;else if(num(stock[g.code])>=g.pend)ok++;else short++});
  charts.stock=new Chart(document.getElementById('c_stock'),{type:'doughnut',
    data:{labels:['พอส่ง','สต็อกขาด','ยังไม่กรอก'],datasets:[{data:[ok,short,na],
      backgroundColor:['#20a464','#e0483c','#cdddda'],borderWidth:0}]},
