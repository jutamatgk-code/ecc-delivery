  <!-- CALENDAR TAB -->
  <div id="tab-cal" class="hidden">
    <div class="calbar">
      <button class="btn" onclick="calPrev()">‹ เดือนก่อน</button>
      <div class="calmonth" id="calmonth"></div>
      <button class="btn" onclick="calNext()">เดือนถัดไป ›</button>
      <button class="btn" onclick="calToday()">วันนี้</button>
      <span style="flex:1"></span>
