// ---------- ชนมูลค่า (ราคาต่อหน่วย/จำนวนเงิน ผูก ใบสั่ง+รหัสสินค้า) ----------
document.getElementById('impvalue').addEventListener('change',e=>{
  if(typeof isAdmin==='function' && !isAdmin()){toast('🔒 เฉพาะผู้ดูแลระบบชนมูลค่าได้');e.target.value='';return;}
  const f=e.target.files[0];if(!f)return;const rd=new FileReader();
  const isCsv=/\.csv$/i.test(f.name);
  rd.onload=ev=>{try{
    const wb=XLSX.read(ev.target.result,{type:isCsv?'string':'array'});
    const ws=wb.Sheets[wb.SheetNames[0]];
    const aoa=XLSX.utils.sheet_to_json(ws,{header:1,defval:''});
    // หาแถว header: แถวที่มีทั้ง 'เลขที่ใบสั่งขาย' และ 'รหัสสินค้า'
    let hi=-1;
    for(let i=0;i<Math.min(aoa.length,8);i++){
      const rowTxt=aoa[i].map(c=>String(c).trim());
      if(rowTxt.includes('รหัสสินค้า') && rowTxt.some(c=>c.includes('ใบสั่งขาย'))){hi=i;break}
    }
    if(hi<0){toast('ไม่พบหัวตาราง (ต้องมี "เลขที่ใบสั่งขาย" + "รหัสสินค้า")');return}
    const header=aoa[hi].map(c=>String(c).trim());
    const findCol=(names)=>{for(const n of names){const idx=header.findIndex(h=>h===n);if(idx>=0)return idx;}return -1;};
    const oi=findCol(['เลขที่ใบสั่งขาย','เลขที่ใบสั่ง']);
    const ci=findCol(['รหัสสินค้า']);
    const pi=findCol(['ราคาต่อหน่วย','ราคา/หน่วย','ราคาต่อหน่วย(บาท)']);
    const ai=findCol(['จำนวนเงิน','มูลค่า','จำนวนเงิน(บาท)']);
    const qi=findCol(['จำนวน','จำนวนสั่ง']);
    if(oi<0||ci<0){toast('ไม่พบคอลัมน์ใบสั่ง/รหัสสินค้า');return}
    if(pi<0&&ai<0){toast('ไม่พบคอลัมน์ราคาต่อหน่วย/จำนวนเงิน');return}
    // รหัส+ใบที่มีในระบบ เพื่อชน
    const known=new Set(DATA.map(r=>prodKey(r[F.order],r[F.code])));
    // รวมหลายบรรทัดของคู่เดียวกัน (ไฟล์แยกตามงวด/ใบเสนอราคา)
    const agg={}; // key -> {amount,qty,lastPrice}
    for(let i=hi+1;i<aoa.length;i++){
      const row=aoa[i];
      const order=String(row[oi]==null?'':row[oi]).trim();
      const code=String(row[ci]==null?'':row[ci]).trim();
      if(!order||!code)continue;
      const key=prodKey(order,code);
      const price=pi>=0?num(row[pi]):0;
      const amount=ai>=0?num(row[ai]):0;
      const qty=qi>=0?num(row[qi]):0;
      if(!agg[key])agg[key]={amount:0,qty:0,lastPrice:0};
      agg[key].amount+=amount;
      agg[key].qty+=qty;
      if(price)agg[key].lastPrice=price;
    }
    const newValue={}; let matched=0, unmatched=0;
    Object.keys(agg).forEach(key=>{
      const a=agg[key];
      // ราคาต่อหน่วย = เฉลี่ยถ่วงน้ำหนัก (จำนวนเงินรวม ÷ จำนวนรวม) ถ้าคำนวณได้ ไม่งั้นใช้ราคาบรรทัดล่าสุด
      const price=(a.qty>0 && a.amount>0)?(a.amount/a.qty):a.lastPrice;
      const rec={price:Math.round(price*100)/100, amount:a.amount};
      newValue[key]=rec;
      if(known.has(key))matched++; else unmatched++;
    });
    if(matched===0 && unmatched===0){toast('ไม่มีข้อมูลมูลค่าในไฟล์');return}
    // merge: รวมกับราคาเดิมที่จำไว้ (ไฟล์ใหม่อัปเดตทับเฉพาะคู่ที่มี ราคาเก่าที่ไม่มีในไฟล์ยังอยู่)
    const before=Object.keys(valueStore).length;
    Object.assign(valueStore,newValue);
    const added=Object.keys(valueStore).length-before;
    valueMeta={file:f.name,time:new Date().toISOString(),matched,unmatched,total:Object.keys(valueStore).length};
    saveValue();
    render();renderInfo();refreshActiveTab();
    toast('💰 ชนมูลค่า: อัปเดต '+Object.keys(newValue).length+' รายการ (ใหม่ '+added+') · จับคู่ใบสั่งได้ '+matched+' · รวมราคาที่จำไว้ '+Object.keys(valueStore).length+' รายการ');
  }catch(err){toast('อ่านไฟล์มูลค่าไม่สำเร็จ: '+err.message)}};
  if(isCsv)rd.readAsText(f,'utf-8');else rd.readAsArrayBuffer(f);
  e.target.value='';
});
