  }

  const flt={q,filt,picF,ostatusF,hideCancel};

  // สถิติภาพรวม (นับจาก commit จริง)
  let nFull=0,nPartial=0,nNone=0,totShort=0,totCommit=0;
  cm.forEach(c=>{if(c.canShip)nFull++;else if(c.partial)nPartial++;else nNone++;totShort+=c.short;totCommit+=c.committed;});
  document.getElementById('commitstats').innerHTML=`
    <div class="stat"><div class="n" style="color:var(--green)">${nFull.toLocaleString()}</div><div class="l">รายการพร้อมส่ง</div></div>
    <div class="stat"><div class="n" style="color:var(--amber)">${nPartial.toLocaleString()}</div><div class="l">ได้บางส่วน</div></div>
    <div class="stat"><div class="n" style="color:var(--red)">${nNone.toLocaleString()}</div><div class="l">สินค้าไม่พอ</div></div>
    <div class="stat"><div class="n">${totCommit.toLocaleString()}</div><div class="l">จองแล้ว (ชิ้น)</div></div>
    <div class="stat"><div class="n" style="color:var(--red)">${totShort.toLocaleString()}</div><div class="l">ขาด (ชิ้น)</div></div>`;

  const body=document.getElementById('commit-body');
  if(commitView==='code')body.innerHTML=commitByCodeHtml(cm,flt);
  else body.innerHTML=commitByOrderHtml(cm,flt);
}
