    <td onclick="event.stopPropagation()"><input type="date" class="shipedit" style="font-size:.72rem" value="${esc(shipVal)}" onchange="setOrderShipCommit('${esc(g.order).replace(/'/g,"\\'")}',this.value)" title="ย้ายทั้งใบ"></td>
