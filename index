(function initCal(){const d=new Date();calYear=d.getFullYear();calMonth=d.getMonth();})();
// กรองแถวตามสถานะที่เลือกในปฏิทิน
function calStatusPass(r){
  if(calStatusSel.size===0)return true;
  return calStatusSel.has(orderStatus(r[F.order]));
}
// จัดกลุ่มแถวตามวันกำหนดส่ง -> Map<YYYY-MM-DD, rows[]> (ผ่านตัวกรองสถานะแล้ว)
function shipMap(){
  const m=new Map();
  DATA.forEach(r=>{if(!calStatusPass(r))return;
    const k=String(r[F.ship]||'').slice(0,10);if(!/^\d{4}-\d{2}-\d{2}$/.test(k))return;
    if(!m.has(k))m.set(k,[]);m.get(k).push(r)});
  return m;
}
