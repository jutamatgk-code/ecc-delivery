// ---------- Commit สต็อก (FIFO ตามวันนัดส่ง) ----------
// คืน Map: _i (ดัชนีแถว DATA) -> {committed, short, canShip}
// จองสต็อกต่อรหัส ให้แถวที่นัดส่งก่อน (ship น้อย→มาก, ไม่มีวันไปท้าย, ตัดเสมอด้วยเลขใบสั่ง)
// การจองสต็อกของใบพักหน้างาน: ค่ารวม + override รายใบ
let holdCommitDefault=(localStorage.getItem('ecc_hold_commit')||'no')==='yes'; // yes=จองให้, no=ไม่จอง(default)
let holdCommitOverride=JSON.parse(localStorage.getItem('ecc_hold_override')||'{}'); // order -> true(จอง)/false(ไม่จอง)
function saveHoldCommit(){if(typeof invalidateCommitCache==='function')invalidateCommitCache();localStorage.setItem('ecc_hold_commit',holdCommitDefault?'yes':'no');localStorage.setItem('ecc_hold_override',JSON.stringify(holdCommitOverride));}
// ใบนี้ควร "ไม่จองสต็อก" หรือไม่
function orderCommitBlocked(order){
  const st=orderStatus(order);
  if(st==='cancel')return true; // ยกเลิก = ไม่จองเสมอ
  if(st==='hold'){
    if(order in holdCommitOverride)return !holdCommitOverride[order]; // override: true=จอง -> ไม่ block
    return !holdCommitDefault; // ตามค่ารวม
  }
  return false;
}
function invalidateCommitCache(){_commitCache=null;_checkCache=null;}
function computeCommit(){
  if(_commitCache)return _commitCache;
  const result=new Map();
  // จัดกลุ่มแถวที่มียอดค้าง ตามรหัส
  const byCode=new Map();
  DATA.forEach(r=>{
    const code=String(r[F.code]).trim();if(!code)return;
    const pend=num(r[F.pend]);if(pend<=0)return;
    if(orderCommitBlocked(r[F.order]))return; // ใบที่ถูกกัน (ยกเลิก/พักหน้างานที่ตั้งไม่จอง)
    if(!byCode.has(code))byCode.set(code,[]);
    byCode.get(code).push(r);
  });
  byCode.forEach((rows,code)=>{
    // เรียง FIFO: วันนัดส่งก่อน (ว่างไปท้าย) -> เลขใบสั่ง
    rows.sort((a,b)=>{
      const sa=String(a[F.ship]||'').slice(0,10)||'9999-99-99';
      const sb=String(b[F.ship]||'').slice(0,10)||'9999-99-99';
      if(sa!==sb)return sa<sb?-1:1;
      return String(a[F.order]).localeCompare(String(b[F.order]));
    });
    let avail=num(stock[code]); // สต็อกคงเหลือให้จอง
    rows.forEach(r=>{
      const need=num(r[F.pend]);
      const committed=Math.max(0,Math.min(avail,need));
      avail-=committed;
      const short=need-committed;
      result.set(r._i,{committed,short,need,canShip:short<=0,partial:committed>0&&short>0});
    });
  });
  _commitCache=result;
  return result;
}
// สรุป commit ระดับใบสั่ง: full=ครบทุกรายการ, partial=บางส่วน, none=ไม่ได้เลย
function commitOrderStatus(commitMap){
  const om=new Map();
  DATA.forEach(r=>{
    const pend=num(r[F.pend]);if(pend<=0)return;
    const o=r[F.order]||'-';
    const blocked=orderCommitBlocked(o); // ยกเลิก หรือ พักหน้างานที่ตั้งไม่จอง
    const c=commitMap.get(r._i);
    if(!c&&!blocked)return;
    if(!om.has(o))om.set(o,{order:o,cus:r[F.cus]||'-',pic:r[F.pic]||'',ship:r[F.ship]||'',totalNeed:0,totalCommit:0,totalShort:0,rows:0,fullRows:0,blocked,ostat:orderStatus(o)});
    const g=om.get(o);
    g.totalNeed+=pend;
    if(c){g.totalCommit+=c.committed;g.totalShort+=c.short;if(c.canShip)g.fullRows++;}
    g.rows++;
    if(!g.ship&&r[F.ship])g.ship=r[F.ship];
  });
  om.forEach(g=>{
    g.cancel=(g.ostat==='cancel');
    g.status = g.blocked ? (g.ostat==='hold'?'hold':'cancel') : (g.totalShort<=0 ? 'full' : (g.totalCommit>0 ? 'partial' : 'none'));
  });
  return om;
}

