.wrap{max-width:1400px;margin:0 auto;display:flex;gap:18px;align-items:flex-start}
.sidebar{flex:0 0 240px;position:sticky;top:24px;align-self:flex-start;z-index:40;transition:flex-basis .25s ease}
.sidebar.collapsed{flex-basis:74px}
.main{flex:1 1 auto;min-width:0}
header{background:linear-gradient(120deg,var(--headgrad1) 0%,var(--headgrad2) 55%,var(--headgrad3) 150%);
  color:#fff;border-radius:22px;padding:24px 30px;box-shadow:var(--shadow);position:relative;overflow:visible;border:1px solid var(--headborder);z-index:100}
header::after{content:"";position:absolute;right:20px;top:14px;width:120px;height:120px;background:rgba(255,255,255,.08);border-radius:50%;pointer-events:none;z-index:0}
header>*{position:relative;z-index:1}
header h1{font-size:1.5rem;font-weight:800}
.theme-toggle{position:absolute;top:20px;right:24px;z-index:3;width:44px;height:44px;border-radius:50%;
  border:1px solid rgba(255,255,255,.3);background:rgba(255,255,255,.15);color:#fff;font-size:1.2rem;
  cursor:pointer;transition:.2s;display:flex;align-items:center;justify-content:center}
.theme-toggle:hover{background:rgba(255,255,255,.28);transform:scale(1.08)}
header p{opacity:.9;margin-top:6px;font-size:.92rem}

.tabs{display:flex;flex-direction:column;gap:6px;background:var(--card);border-radius:20px;
  padding:14px;box-shadow:var(--shadow);border:1px solid var(--line)}
.tabs-head{display:flex;align-items:center;justify-content:space-between;padding:4px 8px 8px;gap:8px}
.tabs .tabs-title{font-size:.72rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);white-space:nowrap}
.tabs-group{font-size:.66rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);
  padding:12px 14px 4px;white-space:nowrap;opacity:.75}
.collapse-btn{border:none;background:var(--tint2);color:var(--muted);width:28px;height:28px;border-radius:8px;
  cursor:pointer;font-size:1rem;font-weight:800;line-height:1;transition:.2s;flex:0 0 auto;display:flex;align-items:center;justify-content:center}
.collapse-btn:hover{background:var(--aqua);color:#04201d}
.tabs button[data-tab]{border:none;background:transparent;color:var(--muted);padding:0;height:44px;border-radius:10px;
  cursor:pointer;font-family:inherit;font-size:.9rem;font-weight:600;transition:all .2s ease;text-align:left;
  display:flex;align-items:center;gap:0;width:100%;position:relative;white-space:nowrap;overflow:hidden}
.tabs button[data-tab] .ic{flex:0 0 auto;font-size:1.05rem;width:48px;display:grid;place-content:center;height:100%}
svg.ic{width:20px;height:20px}
.sidebar.collapsed svg.ic{width:22px;height:22px}
.tabs button[data-tab] .tx{flex:1 1 auto;overflow:hidden;text-overflow:ellipsis}
.tabs button[data-tab] .badge{position:absolute;right:12px;display:flex;align-items:center;justify-content:center;
  min-width:20px;height:20px;padding:0 6px;border-radius:20px;background:var(--aqua);color:#04201d;font-size:.7rem;font-weight:800}
.tabs button[data-tab]:hover{background:var(--tint2);color:var(--ink)}
.tabs button[data-tab].on{background:var(--tint2);color:var(--aqua-d);box-shadow:0 1px 3px rgba(0,0,0,.06);
  border-left:3px solid var(--aqua)}
.tabs button[data-tab].on .ic{width:45px}
.tabs button[data-tab].on .badge{background:var(--aqua);color:#04201d}
/* --- โหมดพับเก็บ (icon-only) บนจอใหญ่ --- */
.sidebar.collapsed .tabs-title{display:none}
.sidebar.collapsed .tabs-group{height:0;padding:6px 0 0;overflow:hidden;border-top:1px solid var(--line);margin:4px 12px 0;font-size:0}
.sidebar.collapsed .tabs-head{justify-content:center;padding:4px 0 8px}
.sidebar.collapsed .collapse-btn{transform:rotate(180deg)}
.sidebar.collapsed .tabs button[data-tab]{justify-content:center}
.sidebar.collapsed .tabs button[data-tab] .tx{display:none}
.sidebar.collapsed .tabs button[data-tab] .badge{display:none}
.sidebar.collapsed .tabs button[data-tab] .ic{width:100%;font-size:1.2rem}
.sidebar.collapsed .tabs button[data-tab].on{border-left-width:0}
/* ปุ่มสลับเมนูมือถือ + ฉากหลัง (ซ่อนบนจอใหญ่) */
.sidebar-toggle{display:none;position:sticky;top:12px;z-index:45;width:100%;margin-bottom:12px;
  border:none;border-radius:14px;padding:13px 18px;cursor:pointer;font-family:inherit;font-size:.95rem;
  font-weight:800;background:var(--card);color:var(--aqua-d);box-shadow:var(--shadow);border:1px solid var(--line);
  align-items:center;gap:10px;justify-content:space-between}
@media(max-width:900px){
  .wrap{flex-direction:column;position:relative}
  .sidebar{position:static;flex-basis:auto;width:100%;transition:none}
  .sidebar.collapsed{flex-basis:auto}
  .sidebar-toggle{display:flex}
  .collapse-btn{display:none}
  .tabs{display:none}
  .tabs.open{display:flex;animation:slideDown .2s ease}
  /* บนมือถือไม่ใช้โหมด icon-only — โชว์ข้อความเต็มเสมอ */
  .sidebar.collapsed .tabs button[data-tab]{justify-content:flex-start}
  .sidebar.collapsed .tabs button[data-tab] .tx{display:block}
  .sidebar.collapsed .tabs button[data-tab] .badge{display:flex}
  .sidebar.collapsed .tabs button[data-tab] .ic{width:48px;font-size:1.05rem}
  .sidebar.collapsed .tabs-title{display:inline}
  .sidebar.collapsed .tabs-group{height:auto;padding:12px 14px 4px;overflow:visible;border-top:none;margin:0;font-size:.66rem}
}
@keyframes slideDown{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}

.toolbar{margin-top:16px;display:flex;gap:10px;flex-wrap:wrap;position:relative;z-index:60}
.btn{border:none;border-radius:12px;padding:11px 16px;cursor:pointer;font-family:inherit;font-size:.88rem;
  font-weight:700;transition:.2s;display:inline-flex;align-items:center;gap:7px;background:var(--card2);color:var(--aqua-d);box-shadow:0 4px 14px rgba(0,0,0,.3);border:1px solid var(--line)}
.btn.primary{background:linear-gradient(120deg,var(--aqua),#166534);color:#04201d;border-color:transparent;box-shadow:0 4px 14px rgba(46,158,91,.35)}
.btn.primary:hover{filter:brightness(1.08)}
.btn:hover{transform:translateY(-1px);border-color:var(--aqua)}
.btn.ghost{background:var(--card2);color:var(--aqua-d)}
.btn.ghost:hover{background:var(--cardhover)}
.btn.danger{background:var(--card2);color:var(--red)}
.btn.danger:hover{background:#3a2530;border-color:var(--red)}
.menu-wrap{position:relative;display:inline-block;z-index:60}
.menu-drop{position:absolute;top:calc(100% + 6px);left:0;background:var(--card);border:1px solid var(--line);border-radius:12px;
  box-shadow:0 12px 40px rgba(0,0,0,.6);padding:6px;min-width:210px;z-index:200;display:none}
.menu-drop.open{display:block}
.menu-drop button{display:block;width:100%;text-align:left;border:none;background:transparent;color:var(--ink);
  padding:10px 13px;border-radius:8px;cursor:pointer;font-family:inherit;font-size:.86rem;font-weight:600;transition:.15s}
.menu-drop button:hover{background:var(--card2);color:var(--aqua-d)}
.menu-drop button.danger{color:var(--red)}
.menu-drop button.danger:hover{background:#3a2530}
.menu-sep{height:1px;background:var(--line);margin:5px 4px}
.filter-toggle-row{display:flex;align-items:center;gap:12px;margin-top:14px;flex-wrap:wrap}
.filter-toggle{border:1px solid var(--line);background:var(--card2);color:var(--aqua-d);padding:9px 16px;border-radius:12px;
  cursor:pointer;font-family:inherit;font-size:.88rem;font-weight:700;transition:.2s}
.filter-toggle:hover{border-color:var(--aqua);background:var(--cardhover)}
.filter-active-hint{font-size:.8rem;color:var(--terra-d);font-weight:700}
.filter-panel{margin-top:12px;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px 18px;
  box-shadow:var(--shadow);display:none}
.filter-panel.open{display:block}
.filter-panel>div{margin-top:0}
.filter-panel .sortbar,.filter-panel .datebar{margin-bottom:12px}
.filter-panel .statbar{margin-bottom:10px}
.infobar{margin-top:14px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;background:var(--card);
  border:1px solid var(--line);border-left:5px solid var(--aqua);border-radius:14px;padding:12px 18px;
  box-shadow:var(--shadow);font-size:.85rem}
.infobar .ib{display:flex;align-items:center;gap:7px;color:var(--ink)}
.infobar .ib b{color:var(--aqua-d);font-weight:700}
.infobar .fname{color:var(--terra-d);font-weight:700;word-break:break-all}
.search-bar{margin-top:14px;display:flex;gap:10px;flex-wrap:wrap;position:relative;z-index:2}
.search-bar input{flex:1;min-width:220px;border:1px solid var(--line);border-radius:14px;padding:14px 18px;font-size:1.05rem;
  font-family:inherit;box-shadow:0 6px 18px rgba(0,0,0,.25);outline:none;background:var(--card);color:var(--ink)}
.search-bar input:focus{box-shadow:0 0 0 3px rgba(255,255,255,.6)}
.mode{display:flex;gap:6px;background:#eaf6f4;padding:5px;border-radius:14px;flex-wrap:wrap}
.mode button{border:1.5px solid transparent;background:var(--card2);color:var(--aqua-d);padding:9px 15px;border-radius:10px;cursor:pointer;
  font-family:inherit;font-size:.88rem;font-weight:700;transition:.2s}
.mode button:hover{border-color:var(--aqua);background:var(--tint)}
.mode button.on{background:var(--aqua);color:#fff;box-shadow:0 2px 8px rgba(15,185,177,.35)}
.viewswitch{margin-top:14px;display:flex;align-items:center;gap:8px;position:relative;z-index:2}
.viewswitch .vs-label{color:var(--aqua-d);font-weight:700;font-size:.9rem;margin-right:2px}
.viewswitch button{border:2px solid var(--line);background:var(--card2);color:var(--aqua-d);padding:9px 18px;
  border-radius:12px;cursor:pointer;font-family:inherit;font-size:.92rem;font-weight:700;transition:.2s}
.viewswitch button.on{background:var(--aqua);color:#fff;border-color:var(--aqua);box-shadow:0 4px 12px rgba(15,185,177,.3)}
.viewswitch button:hover{border-color:var(--aqua);background:var(--tint)}
.viewswitch button.on:hover{background:var(--aqua-d)}
/* มุมมองลูกค้า: ลูกค้า > โครงการ > ใบสั่ง > สินค้า */
.ccard{background:var(--card);border-radius:18px;box-shadow:var(--shadow);border:1px solid var(--line);overflow:hidden;animation:rise .35s ease}
.ccard-head{background:linear-gradient(100deg,var(--tint2),var(--card));padding:18px 22px;display:flex;justify-content:space-between;
  align-items:flex-start;gap:16px;flex-wrap:wrap;border-bottom:2px solid var(--line);cursor:pointer}
.ccard-head:hover{background:linear-gradient(100deg,var(--cardhover),var(--tint2))}
.cname{font-size:1.28rem;font-weight:800;color:var(--ink);line-height:1.3}
.ccode{display:inline-block;margin-top:7px;font-size:.8rem;font-weight:700;color:#a78bfa;background:#2a2540;padding:3px 10px;border-radius:8px}
.ccard.closed .cbody{display:none}
.ccard.closed .chev{transform:rotate(-90deg)}
.proj{margin:0 16px 14px;border:1px solid #e6eef7;border-radius:14px;overflow:hidden}
.proj-head{background:var(--tint2);padding:12px 16px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;border-bottom:1px solid #e6eef7}
.proj-title{font-weight:800;color:#3b6fb5;font-size:.98rem;display:flex;align-items:center;gap:7px}
.order{margin:12px 14px;border-left:4px solid var(--aqua);background:var(--tint2);border-radius:0 12px 12px 0;padding:12px 14px}
.order-head{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px}
.order-no{font-weight:800;color:var(--aqua-d);font-size:.92rem}
.order-meta{font-size:.78rem;color:var(--muted)}
.prod-line{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:8px 0;border-top:1px dashed #334155}
.prod-line:first-child{border-top:none}
.prod-name{font-size:.88rem;color:var(--ink);font-weight:600}
.prod-code{font-size:.74rem;color:var(--muted)}
.pstock{display:inline-block;margin-top:5px;font-size:.75rem;font-weight:700;padding:2px 9px;border-radius:7px}
.pstock.ok{background:#e3f6ec;color:var(--green)}
.pstock.short{background:#fdeae8;color:var(--red)}
.pstock.na{background:var(--tint2);color:var(--muted)}
.prod-qty{font-weight:800;color:var(--terra-d);white-space:nowrap;text-align:right}
.shipedit{border:1.5px solid var(--line);border-radius:8px;padding:4px 8px;font-family:inherit;font-size:.82rem;color:var(--ink);outline:none;background:var(--card2);cursor:pointer}
.mini-sel{border:1.5px solid var(--line);border-radius:8px;padding:4px 8px;font-family:inherit;font-size:.76rem;color:var(--ink);background:var(--card2);cursor:pointer;outline:none}
.wcalc{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin-top:8px;padding:8px;background:var(--tint2);border-radius:10px}
.wcalc-k{padding:10px 0;font-size:1rem;font-weight:700;border:1.5px solid var(--line);border-radius:8px;background:var(--card);color:var(--ink);cursor:pointer;font-family:inherit;transition:filter .1s}
.wcalc-k:hover{filter:brightness(1.08)}
.wcalc-k:active{transform:translateY(1px)}
.wcalc-k.op{background:var(--aqua);color:#fff;border-color:var(--aqua)}
.wcalc-k.fn{background:var(--terra);color:#fff;border-color:var(--terra)}
.shipedit:hover{border-color:var(--aqua)}
.shipedit:focus{border-color:var(--aqua);box-shadow:0 0 0 2px rgba(46,158,91,.15)}
.shipedit.ship-saved{border-color:var(--green);background:#e3f6ec;box-shadow:0 0 0 2px rgba(32,164,100,.25);transition:.2s}
.prod-ship{margin-top:6px;font-size:.78rem;color:var(--muted);display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.mini{border:1.5px solid var(--line);background:var(--card2);color:var(--aqua-d);padding:6px 12px;border-radius:9px;cursor:pointer;
  font-family:inherit;font-size:.8rem;font-weight:700;transition:.2s;white-space:nowrap}
.mini:hover{background:var(--tint);border-color:var(--aqua)}
.mini.done{background:var(--green);border-color:var(--green);color:#fff}
