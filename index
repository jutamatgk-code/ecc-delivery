.statbar button{border:2px solid var(--line);background:var(--card2);padding:7px 13px;border-radius:20px;cursor:pointer;
  font-family:inherit;font-size:.83rem;font-weight:700;transition:.2s;color:var(--ink);display:inline-flex;align-items:center;gap:5px}
.statbar button.on{color:#fff}
.statbar .clr{border-style:dashed;color:var(--muted)}
.statbar .clr:hover{background:var(--tint2)}
.picselect{border:2px solid var(--line);border-radius:20px;padding:7px 13px;font-family:inherit;font-size:.85rem;font-weight:700;color:var(--ink);background:var(--card2);outline:none;cursor:pointer}
.picselect:focus{border-color:var(--aqua)}

.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:14px;margin:18px 0}
.stat{background:var(--card);border-radius:16px;padding:16px;box-shadow:var(--shadow);border:1px solid var(--line);text-align:center}
.stat .n{font-size:1.8rem;font-weight:800;background:linear-gradient(120deg,var(--aqua),var(--terra));-webkit-background-clip:text;background-clip:text;color:transparent}
