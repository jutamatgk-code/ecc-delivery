    if(!localStorage.getItem('ecc_6wheel_added') && !list.some(t=>t.name.includes('6 ล้อ'))){
      list.unshift({name:'6 ล้อ 7 ตัน',cap:7});localStorage.setItem('ecc_6wheel_added','1');
      localStorage.setItem(STRUCK_KEY,JSON.stringify(list));
    }
    // แก้เทรลเลอร์ 20->25 ให้ผู้ใช้เดิม (ครั้งเดียว)
    if(!localStorage.getItem('ecc_trailer25_fixed')){
      let ch=false;list.forEach(t=>{if(t.name.includes('เทรลเลอร์')&&num(t.cap)===20){t.cap=25;ch=true;}});
      localStorage.setItem('ecc_trailer25_fixed','1');
      if(ch)localStorage.setItem(STRUCK_KEY,JSON.stringify(list));
    }
    // ปรับให้ตัน = พิกัดชื่อรถ (ครั้งเดียว) 11.5/12/13/15.5/25
    if(!localStorage.getItem('ecc_cap_bynamed')){
      const byName={'11.5 ตัน (10ล้อ)':11.5,'13 ตัน (10ล้อ)':13,'15.5 ตัน (12ล้อ)':15.5};
      let ch=false;list.forEach(t=>{if(byName[t.name]!==undefined&&num(t.cap)!==byName[t.name]){t.cap=byName[t.name];ch=true;}});
      localStorage.setItem('ecc_cap_bynamed','1');
      if(ch)localStorage.setItem(STRUCK_KEY,JSON.stringify(list));
    }
