    'ระบุป้ายชี้บ่งสินค้า','สถานะสินค้า','','','เหมายเหตุ'];
  const wb=XLSX.utils.book_new();
  let made=0;
  days.forEach(k=>{
    const rows=(sm.get(k)||[]).slice().sort((a,b)=>String(a[F.order]).localeCompare(String(b[F.order])));
    if(!rows.length)return;
    const dd=thDMY(k);
    const aoa=[];
    aoa.push(['แผนจัดส่งวันที่ '+dd]);
    aoa.push(HEAD);
    aoa.push(['บิลที่จัดส่งภายในวัน']);
    rows.forEach(r=>{
      const pr=prodReply[prodKey(r[F.order],r[F.code])]||{};
      const prStatusLabel=(PROD_STATUSES.find(s=>s.id===(pr.status||''))||{}).label||'';
      const noteParts=[];
      if(pr.newDate)noteParts.push('เลื่อนนัด '+pr.newDate);
      if(pr.note)noteParts.push(pr.note);
      const pv=pendValue(r); // มูลค่าคงค้าง = ราคาต่อหน่วย × ยอดค้าง
      aoa.push([
        r[F.order], r[F.odate], r[F.code], r[F.name],
        num(r[F.qty]), num(r[F.pend]),
        '', (pr.qty!=null&&pr.qty!=='')?num(pr.qty):'', '', pv>0?pv:'', // จำนวนที่ต้องจัดส่ง, สินค้าจริง, จำนวนเที่ยว, มูลค่าบิล
        r[F.cus], '',              // ลูกค้า, วันที่จัดส่ง
        '', prStatusLabel.replace(/^[^ก-๙A-Za-z]+/,'').trim(), '', '', noteParts.join(' · ') // ป้ายชี้บ่ง, สถานะสินค้า, ว่าง, ว่าง, หมายเหตุ
      ]);
    });
    const ws=XLSX.utils.aoa_to_sheet(aoa);
    // แถวรวมมูลค่าท้ายตาราง
    const dayTotal=rows.reduce((s,r)=>s+pendValue(r),0);
    if(dayTotal>0){
      XLSX.utils.sheet_add_aoa(ws,[['','','','','','','','','รวมมูลค่า',dayTotal]],{origin:-1});
    }
    ws['!cols']=[{wch:15},{wch:12},{wch:14},{wch:26},{wch:9},{wch:11},{wch:14},{wch:9},{wch:10},{wch:10},{wch:32},{wch:16},{wch:16},{wch:11},{wch:4},{wch:4},{wch:12}];
    // ชื่อชีต = วันที่ (เหมือนไฟล์ตัวอย่าง) จำกัด 31 ตัว, กันอักขระต้องห้าม
    let sn=dd.replace(/[\\/?*\[\]:]/g,'-').slice(0,31);
    XLSX.utils.book_append_sheet(wb,ws,sn);made++;
  });
  if(!made){toast('วันที่เลือกไม่มีรายการจัดส่ง');return}
  XLSX.writeFile(wb,'แผนการจัดส่ง_'+new Date().toISOString().slice(0,10)+'.xlsx');
  toast('📤 ส่งออกแผนจัดส่ง '+made+' วันแล้ว');
}

