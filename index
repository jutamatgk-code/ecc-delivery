function toggleCalDay(k){
  if(calSel.has(k))calSel.delete(k);else calSel.add(k);
  // อัปเดตแค่ไฮไลต์ช่องที่กด (ไม่ rebuild ทั้งเดือน = เร็วขึ้นมากบนมือถือ)
  const cell=document.querySelector('.calcell[data-k="'+k+'"]');
  if(cell)cell.classList.toggle('sel',calSel.has(k));
