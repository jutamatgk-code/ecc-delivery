  const nValue=activeCodes.filter(g=>g.rows&&g.rows.some(r=>unitPrice(r[F.order],r[F.code])>0)).length;
  const activeOrders=[...new Set(DATA.filter(r=>num(r[F.pend])>0).map(r=>String(r[F.order])))];
  const nStatus=activeOrders.filter(o=>orderStatus(o)!=='').length;
  const nWeight=activeCodes.filter(g=>weightOf(g.code)>0).length;
  const pct=(a,b)=>b?Math.round(a/b*100):0;
  const bar=(label,a,b,color)=>{const p=pct(a,b);return `<div class="hbar">
    <div class="hbar-top"><span>${label}</span><span class="hbar-pct" style="color:${p>=80?'#059669':p>=50?'#d97706':'#dc2626'}">${p}%</span></div>
    <div class="hbar-track"><div class="hbar-fill" style="width:${p}%;background:${p>=80?'#059669':p>=50?'#d97706':'#dc2626'}"></div></div>
    <div class="hbar-sub">${a.toLocaleString()} / ${b.toLocaleString()} รายการ</div></div>`;};
  document.getElementById('rHealth').innerHTML=
    bar('กรอกสต็อกแล้ว',nStock,activeCodes.length,'')+
    bar('มีมูลค่า (ราคา)',nValue,activeCodes.length,'')+
    bar('ตั้งสถานะใบสั่งแล้ว',nStatus,activeOrders.length,'')+
    bar('มีน้ำหนักสินค้า',nWeight,activeCodes.length,'');

  // 1) Top 10 ยอดคงค้าง
  const top=[...groups].sort((a,b)=>b.pend-a.pend).slice(0,10);
  charts.top=new Chart(document.getElementById('c_top'),{type:'bar',
    data:{labels:top.map(g=>wrapLabel(g.name,20,2)),datasets:[{data:top.map(g=>g.pend),
      backgroundColor:'#2e9e5b',borderRadius:8}]},options:baseOptsFull(true,top.map(g=>g.name))});

  // 2) Top 10 ลูกค้าหลายเจ้า
  const topCus=[...groups].sort((a,b)=>b.nCus-a.nCus).slice(0,10);
  charts.cus=new Chart(document.getElementById('c_cus'),{type:'bar',
    data:{labels:topCus.map(g=>wrapLabel(g.name,20,2)),datasets:[{data:topCus.map(g=>g.nCus),
      backgroundColor:'#e17055',borderRadius:8}]},options:baseOptsFull(true,topCus.map(g=>g.name))});

  // 3) Top 10 ลูกค้าค้างรับของ
  const cusMap=new Map();
  DATA.forEach(r=>{const k=r[F.cus]||r[F.cuscode];cusMap.set(k,(cusMap.get(k)||0)+num(r[F.pend]))});
  const topByCus=[...cusMap.entries()].sort((a,b)=>b[1]-a[1]).slice(0,10);
  charts.bycus=new Chart(document.getElementById('c_bycus'),{type:'bar',
    data:{labels:topByCus.map(e=>wrapLabel(e[0],20,2)),datasets:[{data:topByCus.map(e=>e[1]),
