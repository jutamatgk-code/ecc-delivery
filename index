    <td>${badge}${holdBtn}</td>
  </tr>
  <tr class="commit-detail" id="cdet-${esc(g.order)}" style="display:none"><td colspan="9" style="padding:0"><div class="commit-detail-inner" data-order="${esc(g.order)}"></div></td></tr>`;
  }).join('');
  return `<div class="pcard"><div class="tbl-wrap"><table class="datatbl">
