        tooltip:{bodyFont:{family:'Sarabun'}}}}});

  // 5) ตามเดือนกำหนดส่ง (line)
  const mMap=new Map();
  DATA.forEach(r=>{const k=monthKey(r[F.ship]);if(k)mMap.set(k,(mMap.get(k)||0)+num(r[F.pend]))});
  const months=[...mMap.keys()].sort();
  const thMon=['ม.ค.','ก.พ.','มี.ค.','เม.ย.','พ.ค.','มิ.ย.','ก.ค.','ส.ค.','ก.ย.','ต.ค.','พ.ย.','ธ.ค.'];
