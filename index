// ---------- เครื่องคิดเลขในช่องน้ำหนัก ----------
// ประเมินสูตรอย่างปลอดภัย (อนุญาตเฉพาะ ตัวเลข . + - * / ( ) และช่องว่าง)
function safeCalc(expr){
  let s=String(expr).trim();
  if(s.startsWith('='))s=s.slice(1);
  if(s==='')return null;
  if(!/^[0-9.+\-*/()\s]+$/.test(s))return NaN; // มีอักขระต้องห้าม
  try{const v=Function('"use strict";return('+s+')')();return (typeof v==='number'&&isFinite(v))?v:NaN;}
  catch(e){return NaN;}
}
// แสดงตัวอย่างผลลัพธ์ระหว่างพิมพ์
function weightPreview(){
  const inp=document.getElementById('we-w');const pv=document.getElementById('we-calc-preview');
  const raw=inp.value.trim();
  if(!raw||/^-?\d*\.?\d*$/.test(raw)){pv.textContent='';return;}
  const v=safeCalc(raw);
  pv.textContent=(v===null||isNaN(v))?'⚠️ สูตรไม่ถูกต้อง':('= '+ (Math.round(v*1000)/1000).toLocaleString()+' กก.');
}
// เมื่อกด Enter/ออกจากช่อง -> คิดสูตรแล้วแทนค่าจริง
function evalWeightField(){
  const inp=document.getElementById('we-w');const raw=inp.value.trim();
  if(!raw)return;
  if(/^-?\d*\.?\d+$/.test(raw)){document.getElementById('we-calc-preview').textContent='';return;} // เป็นตัวเลขล้วนแล้ว
  const v=safeCalc(raw);
  if(v!==null&&!isNaN(v)&&v>0){inp.value=Math.round(v*1000)/1000;document.getElementById('we-calc-preview').textContent='';}
}
