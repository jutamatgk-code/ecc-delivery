<body>
<!-- ===== LOGIN OVERLAY ===== -->
<div id="loginOverlay">
  <div class="login-card">
    <div class="login-logo">🔐</div>
    <h2>เข้าสู่ระบบ ECC</h2>
    <p class="sub">ค้นหาสินค้า · เช็คลูกค้าค้างส่ง · สต็อก</p>
    <div class="login-err" id="loginErr"></div>
