    <div class="pcard" style="padding:18px;margin-bottom:14px">
      <div style="font-weight:800;color:var(--aqua-d);margin-bottom:10px">📊 อันดับสินค้า${metricLabel} (Top 15)</div>
      <div style="height:${Math.max(240,top.length*30)}px;position:relative"><canvas id="planChart"></canvas></div>
    </div>
    <div class="pcard"><div class="tbl-wrap"><table class="datatbl">
      <thead><tr><th>#</th><th>สินค้า</th><th>ค้างรวม</th><th>สต็อก</th><th style="color:${color}">${metricLabel}</th><th>ลูกค้า</th><th>ใบสั่ง</th><th>น้ำหนัก</th><th>สถานะ</th></tr></thead>
      <tbody>${list.map((o,i)=>planRow(o,i,metric)).join('')}</tbody>
    </table></div></div>`;

  // วาดชาร์ต
  planCharts.forEach(c=>{try{c.destroy()}catch(e){}});planCharts=[];
  const ctx=document.getElementById('planChart');
  if(ctx){
    const c=new Chart(ctx,{type:'bar',data:{
      labels:top.map(o=>o.code),
      datasets:[{label:metricLabel+' (ชิ้น)',data:top.map(o=>o[metric]),
        backgroundColor:planView==='need'?'#fb923c':planView==='ready'?'#34d399':'#2dd4bf',borderRadius:5}]
    },options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,
      plugins:{legend:{display:false},tooltip:{callbacks:{afterLabel:(it)=>{const o=top[it.dataIndex];return o.name+'\nลูกค้า '+o.cusCount+' · ใบสั่ง '+o.orderCount}}}},
      scales:{x:{ticks:{color:getComputedStyle(document.body).getPropertyValue('--muted')},grid:{color:'rgba(128,128,128,.1)'}},
        y:{ticks:{color:getComputedStyle(document.body).getPropertyValue('--ink'),font:{size:11}},grid:{display:false}}}}});
    planCharts.push(c);
  }
}
