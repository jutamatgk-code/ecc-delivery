      <span>📂 เมนู</span><span style="font-size:.8rem">▾</span>
    </button>
    <nav class="tabs" id="tabsNav">
      <div class="user-badge" id="userBadge" style="display:none">
        <div class="avatar" id="userAvatar">?</div>
        <div class="who"><div class="nm" id="userName">-</div><div class="rl" id="userRole">-</div></div>
        <button class="logout" onclick="doLogout()" title="ออกจากระบบ">⏻</button>
      </div>
      <div class="tabs-head">
        <span class="tabs-title">เมนู</span>
        <button class="collapse-btn" id="collapseBtn" onclick="toggleCollapse()" title="พับเก็บเมนู">«</button>
      </div>
      <button data-tab="dash" class="on" title="ภาพรวม"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 4l9 6.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg><span class="tx">ภาพรวม</span></button>

      <div class="tabs-group">จัดการงานส่ง</div>
      <button data-tab="status" title="สถานะใบสั่ง"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10"/></svg><span class="tx">สถานะใบสั่ง</span><span class="badge" id="badge-status" style="display:none"></span></button>
      <button data-tab="cal" title="ปฏิทินจัดส่ง"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg><span class="tx">ปฏิทินจัดส่ง</span></button>
      <button data-tab="plan" title="แผนผลิต/จัดส่ง"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5M4 19h16M8 16l3-4 3 2 4-6"/></svg><span class="tx">แผนผลิต/จัดส่ง</span></button>

      <div class="tabs-group">สินค้า &amp; สต็อก</div>
      <button data-tab="search" title="ค้นหาสินค้า"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg><span class="tx">ค้นหาสินค้า</span></button>
      <button data-tab="stock" title="สต็อกสินค้า"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8l9 5 9-5zM3 8v8l9 5 9-5V8M12 13v8"/></svg><span class="tx">สต็อกสินค้า</span></button>
      <button data-tab="commit" title="Commit สต็อก"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><span class="tx">Commit สต็อก</span></button>
      <button data-tab="weight" title="น้ำหนักสินค้า"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M7 6h10l3 12a5 5 0 0 1-16 0z"/></svg><span class="tx">น้ำหนักสินค้า</span></button>

      <div class="tabs-group">ข้อมูล &amp; รายงาน</div>
      <button data-tab="report" title="รีพอร์ต"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V4M4 20h16M9 16V9M14 16v-4M19 16v-8"/></svg><span class="tx">รีพอร์ต</span></button>
      <button data-tab="check" title="ตรวจข้อมูลขาด"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2 20h20zM12 10v4M12 17v.5"/></svg><span class="tx">ตรวจข้อมูลขาด</span><span class="badge" id="badge-check" style="display:none"></span></button>
      <button data-tab="addr" title="ที่อยู่จัดส่ง"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg><span class="tx">ที่อยู่จัดส่ง</span></button>

      <div class="tabs-group" id="grpSystem" style="display:none">ระบบ</div>
      <button data-tab="users" id="tabBtnUsers" title="จัดการผู้ใช้" style="display:none"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3 20a6 6 0 0 1 12 0M16 5.5a3 3 0 0 1 0 5.5M22 20a5.5 5.5 0 0 0-4-5"/></svg><span class="tx">จัดการผู้ใช้</span></button>
    </nav>
  </aside>

  <div class="main">
  <header>
    <button class="theme-toggle" id="themeToggle" onclick="toggleTheme()" title="สลับโหมดสว่าง/มืด">🌙</button>
    <h1>🔍 ค้นหาสินค้า — เช็คลูกค้าค้างส่ง + สต็อก</h1>
    <p>ค้นสินค้า ดูลูกค้าที่ค้างส่ง จัดการสต็อก และดูรีพอร์ตภาพรวม</p>
    <div class="global-search">
      <input id="globalSearch" placeholder="🔍 ค้นหาทั่วระบบ — ใบสั่ง / ลูกค้า / สินค้า" oninput="globalSearchInput()" onkeydown="if(event.key==='Enter')globalSearchGo()">
      <div class="gs-results" id="gsResults"></div>
    </div>
  </header>

  <!-- DASHBOARD TAB -->
  <div id="tab-dash">
    <div id="dashBody"></div>
  </div>

  <!-- SEARCH TAB -->
  <div id="tab-search" class="hidden">
    <div class="toolbar">
      <button class="btn primary" data-admin-only onclick="document.getElementById('imp').click()">📥 นำเข้าข้อมูล</button>
      <button class="btn ghost" data-admin-only onclick="document.getElementById('impstock').click()">📦 ชนสต็อก</button>
      <button class="btn ghost" data-admin-only onclick="document.getElementById('impvalue').click()">💰 ชนมูลค่า</button>
      <div class="menu-wrap">
        <button class="btn ghost" onclick="toggleToolMenu(event)">⚙️ เครื่องมือ <span style="font-size:.7rem">▾</span></button>
        <div class="menu-drop" id="toolmenu">
          <button onclick="exportExcel();closeToolMenu()">📤 ส่งออก Excel</button>
          <button onclick="exportStock();closeToolMenu()">💾 ส่งออกสต็อก (CSV)</button>
          <div class="menu-sep" data-admin-only></div>
          <button data-admin-only onclick="backupAll();closeToolMenu()">🗄️ สำรองข้อมูล</button>
          <button data-admin-only onclick="document.getElementById('imprestore').click();closeToolMenu()">♻️ กู้คืนข้อมูล</button>
          <div class="menu-sep" data-admin-only></div>
          <button class="danger" data-admin-only onclick="clearData();closeToolMenu()">🗑️ เคลียร์ข้อมูล</button>
        </div>
      </div>
      <input type="file" id="imp" accept=".xlsx,.xls,.csv" style="display:none">
      <input type="file" id="impstock" accept=".xlsx,.xls,.csv" style="display:none">
      <input type="file" id="impvalue" accept=".xlsx,.xls,.csv" style="display:none">
      <input type="file" id="imprestore" accept=".json" style="display:none">
    </div>
    <div class="infobar" id="infobar"></div>
    <div class="viewswitch">
      <span class="vs-label">มุมมอง :</span>
      <button data-v="product" class="on" onclick="setView('product')">📦 ตามสินค้า</button>
      <button data-v="customer" onclick="setView('customer')">🏢 ตามลูกค้า</button>
    </div>
    <div class="search-bar">
      <input id="q" placeholder="เช่น เสาเข็ม, S081-1810, ชื่อลูกค้า, SS26071502 ..." autocomplete="off">
