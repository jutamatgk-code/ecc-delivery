  if(!items.length){toast('ไม่มีรายการ');return;}
  const thDMY=(kk)=>{const[y,m,d]=kk.split('-');return String(+d).padStart(2,'0')+'-'+String(+m).padStart(2,'0')+'-'+(+y+543)};
  const aoa=[['สรุปสินค้าที่ต้องส่ง '+thDMY(_daySummaryK)],
    ['รหัสสินค้า','ชื่อสินค้า','ลูกค้า','จำนวนรวม','ส่งจริง','มูลค่า(ส่งจริง)','ใบสั่ง']];
  let tP=0,tR=0,tV=0;
  items.forEach(x=>{
    // แถวรวมของสินค้า
    aoa.push([x.code,x.name,'(รวมทุกลูกค้า)',x.pend,x.hasReal?x.real:'',x.val>0?Math.round(x.val):'',x.orders.size]);
    // แถวแยกลูกค้า
    [...x.cus.entries()].sort((a,b)=>b[1].pend-a[1].pend).forEach(([cus,cg])=>{
      aoa.push(['','  ↳ '+cus,cus,cg.pend,cg.real>0?cg.real:'',cg.val>0?Math.round(cg.val):'',cg.orders.size]);
    });
    tP+=x.pend;tR+=x.real;tV+=x.val;
  });
  aoa.push(['รวมทั้งหมด','','',tP,tR||'',tV>0?Math.round(tV):'','']);
  const ws=XLSX.utils.aoa_to_sheet(aoa);
  ws['!cols']=[{wch:16},{wch:32},{wch:28},{wch:11},{wch:10},{wch:12},{wch:8}];
  ws['!merges']=[{s:{r:0,c:0},e:{r:0,c:6}}];
  const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,'สรุปสินค้า');
  XLSX.writeFile(wb,'สรุปสินค้า_'+thDMY(_daySummaryK)+'.xlsx');
  toast('📤 ส่งออก Excel แล้ว');
