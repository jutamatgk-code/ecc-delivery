  for(const r of rows){const k=r[F.code]+'|'+r[F.name];
    if(!m.has(k))m.set(k,{code:r[F.code],name:r[F.name],rows:[]});m.get(k).rows.push(r)}
  return [...m.values()];
}
function enrich(g){
  g.nCus=new Set(g.rows.map(r=>r[F.cuscode]||r[F.cus])).size;
  g.pend=g.rows.reduce((s,r)=>s+num(r[F.pend]),0);
  g.nOrder=g.rows.length;
  const s=stock[g.code];
  g.short = s!==undefined ? Math.max(0,g.pend-num(s)) : -1;
  return g;
}
function sortGroups(groups){
  const cmp={
    cus_desc:(a,b)=>b.nCus-a.nCus, cus_asc:(a,b)=>a.nCus-b.nCus,
    pend_desc:(a,b)=>b.pend-a.pend, pend_asc:(a,b)=>a.pend-b.pend,
    order_desc:(a,b)=>b.nOrder-a.nOrder,
    name_asc:(a,b)=>String(a.name).localeCompare(String(b.name),'th'),
    code_asc:(a,b)=>String(a.code).localeCompare(String(b.code),'th'),
    short_desc:(a,b)=>b.short-a.short,
  }[sortBy];
  return groups.sort(cmp);
}

