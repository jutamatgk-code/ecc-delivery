  prodHist.unshift({
    clearedAt:Date.now(),
    clearedBy:(CURRENT_USER&&CURRENT_USER.name)||(CURRENT_USER&&CURRENT_USER.username)||'?',
    count:keys.length,
    items:JSON.parse(JSON.stringify(prodReply))
  });
