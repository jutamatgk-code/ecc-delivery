function renderCal(){
  // ถ้ามีการแก้วันจากแท็บอื่น -> กระโดดไปเดือนนั้นและเลือกวันให้เห็นทันที
  if(calJumpTo){
    const[jy,jm]=calJumpTo.split('-').map(Number);
    calYear=jy;calMonth=jm-1;
    calSel.add(calJumpTo);
    calJumpTo=null;
  }
  renderCalStatBar();
  const thMon=['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน','กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'];
  document.getElementById('calmonth').textContent=thMon[calMonth]+' '+(calYear+543);
  const sm=shipMap();
  const first=new Date(calYear,calMonth,1);
  const startDow=first.getDay(); // 0=อา
  const daysInMonth=new Date(calYear,calMonth+1,0).getDate();
  const todayK=new Date().toISOString().slice(0,10);
  const dow=['อา','จ','อ','พ','พฤ','ศ','ส'];
  let html=dow.map(d=>`<div class="caldow">${d}</div>`).join('');
  // ช่องว่างก่อนวันที่ 1
  for(let i=0;i<startDow;i++)html+=`<div class="calcell empty"></div>`;
  for(let d=1;d<=daysInMonth;d++){
    const k=calYear+'-'+String(calMonth+1).padStart(2,'0')+'-'+String(d).padStart(2,'0');
    const rows=sm.get(k)||[];
    const nOrder=new Set(rows.map(r=>r[F.order])).size;
    const pend=rows.reduce((s,r)=>s+num(r[F.pend]),0);
    // มูลค่าคงค้าง = คงค้าง×ราคา / มูลค่าส่งจริง = ส่งจริงที่ฝ่ายผลิตตอบ×ราคา
    let valPend=0, valReal=0, hasAnyReal=false;
    rows.forEach(r=>{const price=unitPrice(r[F.order],r[F.code]);
      valPend+=price*num(r[F.pend]);
      const pr=prodReply[prodKey(r[F.order],r[F.code])]||{};
      if(pr.qty!=null&&pr.qty!==''){valReal+=price*num(pr.qty);hasAnyReal=true;}});
    const cls=['calcell'];
    if(k===todayK)cls.push('today');
    if(calSel.has(k))cls.push('sel');
    const valLine=(valPend>0?`<br><span class="ci-val">฿${Math.round(valPend).toLocaleString()}</span>`:'')
      +(hasAnyReal?`<br><span class="ci-valreal">✓฿${Math.round(valReal).toLocaleString()}</span>`:'');
    const info=rows.length?`<div class="cdinfo"><span class="ci-ord">📃 ${nOrder} ใบสั่ง</span><br><span class="ci-pend">📦 ${pend.toLocaleString()}</span>${valLine}</div>`:'';
    const dot=rows.length?'<span class="cdot"></span>':'';
    html+=`<div class="${cls.join(' ')}" data-k="${k}" onclick="toggleCalDay('${k}')"><span class="cdnum">${d}</span>${dot}${info}</div>`;
  }
  document.getElementById('calgrid').innerHTML=html;
  renderCalList();
}
