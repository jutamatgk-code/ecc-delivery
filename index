const WEIGHT_KEY='ecc_weights_v1';
// ส่วนที่ผู้ใช้เพิ่ม/แก้ (ซ้อนทับค่าตั้งต้น) + รายการที่ลบ
let weightEdits=JSON.parse(localStorage.getItem(WEIGHT_KEY)||'{"edit":{},"del":[]}');
if(!weightEdits.edit)weightEdits.edit={};if(!weightEdits.del)weightEdits.del=[];
function saveWeightEdits(){localStorage.setItem(WEIGHT_KEY,JSON.stringify(weightEdits));if(typeof cloudPush==='function')cloudPush('weights');}
// รวมค่าตั้งต้น + แก้ไข - ลบ => WEIGHTS ที่ใช้จริง
function buildWeights(){
  const w=Object.assign({},WEIGHTS_DEFAULT,weightEdits.edit);
  weightEdits.del.forEach(c=>delete w[c]);
  return w;
}
let WEIGHTS=buildWeights();
let weightView='list', wtypeSel='', wEditCode=null;
function setWeightView(v){weightView=v;document.querySelectorAll('#tab-weight [data-wv]').forEach(b=>b.classList.toggle('on',b.dataset.wv===v));renderWeight()}
function weightOf(code){const w=WEIGHTS[String(code).trim()];return w?w.w:null}
function renderWeightTypeBar(){
  const bar=document.getElementById('wtypebar');
  const types=[...new Set(Object.values(WEIGHTS).map(w=>w.t))].sort((a,b)=>a.localeCompare(b,'th'));
  let chips=`<button class="${wtypeSel===''?'on':''}" style="${wtypeSel===''?'background:var(--ink);border-color:var(--ink)':''}" onclick="setWType('')">ทั้งหมด</button>`;
  chips+=types.map(t=>`<button class="${wtypeSel===t?'on':''}" onclick="setWType('${esc(t).replace(/'/g,"\\'")}')">${esc(t)}</button>`).join('');
  bar.innerHTML='<span class="sblabel">📦 ประเภท:</span>'+chips;
}
function setWType(t){wtypeSel=t;renderWeightTypeBar();renderWeight()}
function renderWeight(){
  renderWeightTypeBar();
  document.getElementById('wtypebar').style.display=(weightView==='calc')?'none':'';
  if(weightView==='list')renderWeightList();
  else if(weightView==='calc')renderWeightCalc();
  else renderWeightOrder();
}
function renderWeightList(){
  const q=(document.getElementById('wsearch').value||'').trim().toLowerCase();
  let rows=Object.entries(WEIGHTS);
  if(wtypeSel)rows=rows.filter(([c,w])=>w.t===wtypeSel);
  if(q)rows=rows.filter(([c,w])=>c.toLowerCase().includes(q)||String(w.n).toLowerCase().includes(q)||String(w.t).toLowerCase().includes(q));
  rows.sort((a,b)=>a[0].localeCompare(b[0]));
  const body=document.getElementById('weight-body');
  if(!rows.length){body.innerHTML='<div class="empty"><div class="big">⚖️</div><p>ไม่พบสินค้าที่ตรงกับคำค้น</p></div>';return}
  const trs=rows.map(([c,w])=>{
    const edited=weightEdits.edit[c]!==undefined;
    return `<tr>
    <td class="sno-td">${esc(c)}${edited?' <span style="font-size:.66rem;background:#2a2540;color:#a78bfa;padding:1px 6px;border-radius:6px;font-weight:700">แก้ไขแล้ว</span>':''}</td>
    <td>${esc(w.n)}</td>
    <td>${esc(w.t)}</td>
    <td style="text-align:center">${esc(w.u)}</td>
    <td class="qty">${w.w.toLocaleString(undefined,{minimumFractionDigits:0,maximumFractionDigits:3})} กก.</td>
    <td><div class="row-btns">
      <button class="abtn edit" onclick="openWeightEdit('${esc(c).replace(/'/g,"\\'")}')">แก้ไข</button>
      <button class="abtn del" onclick="delWeight('${esc(c).replace(/'/g,"\\'")}')">ลบ</button>
    </div></td>
  </tr>`;}).join('');
  body.innerHTML=`<div style="font-size:.85rem;color:var(--muted);margin-bottom:8px">พบ ${rows.length.toLocaleString()} รหัส</div>
    <div class="pcard"><div class="tbl-wrap"><table class="datatbl sortable-tbl">
    <thead><tr><th>รหัสสินค้า</th><th>ชื่อสินค้า</th><th>ประเภท</th><th>หน่วย</th><th>น้ำหนัก/ชิ้น</th><th data-nosort></th></tr></thead>
    <tbody>${trs}</tbody></table></div></div>`;
}
function renderWeightOrder(){
  const q=(document.getElementById('wsearch').value||'').trim().toLowerCase();
  // จัดกลุ่มตามใบสั่ง จากข้อมูลค้างส่ง (DATA)
  const om=new Map();
  DATA.forEach(r=>{const o=r[F.order];if(!o)return;if(!om.has(o))om.set(o,[]);om.get(o).push(r)});
  let entries=[...om.entries()];
  if(q)entries=entries.filter(([o,rows])=>{const r0=rows[0];
    return String(o).toLowerCase().includes(q)||String(r0[F.cus]||'').toLowerCase().includes(q)||String(r0[F.proj]||'').toLowerCase().includes(q)
      ||rows.some(r=>String(r[F.code]).toLowerCase().includes(q)||String(r[F.name]).toLowerCase().includes(q));});
  entries.sort((a,b)=>String(a[0]).localeCompare(String(b[0])));
  const body=document.getElementById('weight-body');
  if(!entries.length){body.innerHTML='<div class="empty"><div class="big">📃</div><p>ไม่พบใบสั่ง (ต้องมีข้อมูลค้างส่งก่อน)</p></div>';return}
  const cards=entries.map(([ono,rows])=>{
    const r0=rows[0];
    let totalW=0,missing=0;
    const lines=rows.map(r=>{
      const code=String(r[F.code]).trim();const pend=num(r[F.pend]);const wpu=weightOf(code);
      const cc=esc(code).replace(/'/g,"\\'");
      const nn=esc(String(r[F.name]||'')).replace(/'/g,"\\'");
      let wtxt,lineW=0,puTxt;
      if(wpu==null){wtxt=`<button class="abtn" style="color:var(--terra-d);border:1.5px dashed #f3c9bd;background:#fff8f5" onclick="openWeightNew('${cc}','${nn}')">➕ ไม่มีน้ำหนัก · เพิ่ม</button>`;puTxt='<span style="color:var(--muted)">-</span>';missing++;}
      else{lineW=wpu*pend;totalW+=lineW;
        puTxt=wpu.toLocaleString(undefined,{maximumFractionDigits:3})+' กก. <button class="abtn edit" style="margin-left:4px;padding:3px 8px" onclick="openWeightEdit(\''+cc+'\')">แก้</button>';
        wtxt='<b>'+lineW.toLocaleString(undefined,{maximumFractionDigits:1})+' กก.</b>';}
      return `<tr><td>${esc(r[F.code])}<div class="cuscode">${esc(r[F.name])}</div></td>
        <td class="qty">${pend.toLocaleString()}</td>
        <td style="text-align:right">${puTxt}</td>
        <td style="text-align:right">${wtxt}</td></tr>`;
    }).join('');
    const ton=(totalW/1000);
    return `<div class="pcard" style="margin-bottom:14px">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:10px">
        <div><div style="font-weight:800;color:var(--aqua-d);font-size:1rem">📃 ${esc(ono)}</div>
          <div style="font-size:.84rem;color:var(--muted)">${esc(r0[F.cus]||'-')} · ${esc(r0[F.proj]||'-')}</div></div>
        <div style="text-align:right"><div style="font-weight:800;color:var(--terra-d);font-size:1.15rem">${totalW.toLocaleString(undefined,{maximumFractionDigits:1})} กก.</div>
          <div style="font-size:.8rem;color:var(--muted)">≈ ${ton.toLocaleString(undefined,{maximumFractionDigits:2})} ตัน${missing?' · <span style="color:var(--red)">'+missing+' รายการไม่มีน้ำหนัก</span>':''}</div>
          <button class="abtn copy" style="margin-top:6px" onclick="copyWeightOrderTSV('${esc(ono).replace(/'/g,"\\'")}',event.target)">📋 คัดลอก (Excel)</button></div>
      </div>
      <div class="tbl-wrap"><table class="datatbl">
        <thead><tr><th>สินค้า</th><th>ค้างส่ง</th><th>น้ำหนัก/ชิ้น</th><th>น้ำหนักรวม</th></tr></thead><tbody>${lines}</tbody></table></div>
    </div>`;
  }).join('');
  body.innerHTML=`<div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px">
    <div style="font-size:.85rem;color:var(--muted)">${entries.length.toLocaleString()} ใบสั่ง (คำนวณจากยอดค้างส่ง × น้ำหนัก/ชิ้น)</div>
    <button class="btn" onclick="copyAllWeightTSV(event.target)">📋 คัดลอกทั้งหมด (Excel)</button>
