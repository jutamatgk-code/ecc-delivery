const QUEUE_KEY='ecc_queue_v1', TRUCKS_KEY='ecc_trucks_v1';
// รถเริ่มต้น
const DEFAULT_TRUCKS=[
  {id:'t1',name:'11.5 ตัน 10ล้อ',trips:2},
