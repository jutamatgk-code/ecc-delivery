let trucks=JSON.parse(localStorage.getItem(TRUCKS_KEY)||'null')||DEFAULT_TRUCKS.slice();
function saveTrucks(){localStorage.setItem(TRUCKS_KEY,JSON.stringify(trucks))}
// แผนคิว: { 'YYYY-MM-DD': { pool:[orderNo,...], assign:{ 'truckId#tripIdx':[orderNo,...] } } }
let queueStore=JSON.parse(localStorage.getItem(QUEUE_KEY)||'{}');
function saveQueue(){localStorage.setItem(QUEUE_KEY,JSON.stringify(queueStore))}

function qDay(){return document.getElementById('qdate').value||''}
function qPlan(){
  const d=qDay();if(!d)return null;
  if(!queueStore[d])queueStore[d]={pool:[],assign:{}};
  const p=queueStore[d];
  if(!Array.isArray(p.pool))p.pool=[];
  if(!p.assign)p.assign={};
  // migrate: ถ้า item เป็น string (orderNo แบบเก่า) -> แปลงเป็น object ทุกสินค้าในใบสั่ง
  const conv=arr=>{const out=[];arr.forEach(x=>{
    if(typeof x==='string'){
      DATA.filter(r=>String(r[F.order])===x).forEach(r=>out.push({id:newItemId(),order:x,code:r[F.code],qty:num(r[F.pend])}));
    }else out.push(x);
  });return out;};
  let changed=false;
  if(p.pool.some(x=>typeof x==='string')){p.pool=conv(p.pool);changed=true;}
  for(const k in p.assign){if(p.assign[k].some(x=>typeof x==='string')){p.assign[k]=conv(p.assign[k]);changed=true;}}
  if(changed)saveQueue();
  return p;
}
// item = {id, order, code, qty}  (qty = จำนวนที่จะส่งเที่ยว/คันนี้)
function newItemId(){return 'q'+Date.now().toString(36)+Math.random().toString(36).slice(2,6)}
function lineInfo(order,code){
  const r=DATA.find(x=>String(x[F.order])===String(order)&&String(x[F.code])===String(code));
  if(!r)return null;
  return {name:r[F.name],cus:r[F.cus],proj:r[F.proj],ship:r[F.ship],pic:r[F.pic],
    qtyOrder:num(r[F.qty]),pend:num(r[F.pend]),status:orderStatus(order),
    stock:stock[String(code).trim()]};
}
