// เริ่มต้น Firebase
async function initAuth(){
  try{
    firebase.initializeApp(firebaseConfig);
    db=firebase.firestore();
    fbReady=true;
    setFbStatus('เชื่อมต่อฐานข้อมูลแล้ว','ok');
    // กู้ session เดิมก่อน (เข้าใช้งานเร็ว ไม่ต้องรอ seed)
    const sess=localStorage.getItem(SESSION_KEY);
    if(sess){
      try{
        const u=JSON.parse(sess);
        const fresh=await db.collection('appUsers').doc(u.username).get();
        if(fresh.exists && fresh.data().active!==false){
          CURRENT_USER={username:u.username,...fresh.data()};
          onLoginSuccess();
          ensureSeedAdmin(); // เช็ค admin เบื้องหลัง ไม่ block
          return;
        }
      }catch(e){}
      localStorage.removeItem(SESSION_KEY);
    }
    // ยังไม่เคย login -> seed admin (เผื่อเป็นการติดตั้งครั้งแรก)
    await ensureSeedAdmin();
  }catch(err){
    setFbStatus('เชื่อมต่อไม่สำเร็จ — ตรวจอินเทอร์เน็ต','err');
    console.error('Firebase init error',err);
  }
}
