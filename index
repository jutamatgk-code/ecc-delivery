  if(!list.length)return setup+'<div class="empty"><div class="big">📊</div><p>ยังไม่มีรายการติดตาม</p></div>';
  const plan=computePlan(list);
  if(plan.noCap)return setup+'<div class="empty"><div class="big">📊</div><p>กรอกกำลังผลิต/ส่งต่อวัน เพื่อคำนวณแผน</p></div>';

  const start=plan.start;
  const totalDays=Math.max(plan.days,1);
  const th=['ม.ค.','ก.พ.','มี.ค.','เม.ย.','พ.ค.','มิ.ย.','ก.ค.','ส.ค.','ก.ย.','ต.ค.','พ.ย.','ธ.ค.'];
