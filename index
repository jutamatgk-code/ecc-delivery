function fillProvinces(){
  const sel=document.getElementById('af-prov');if(!sel)return;
  const provs=Object.keys(ISAN_GEO).sort((a,b)=>a.localeCompare(b,'th'));
  sel.innerHTML='<option value="">— เลือกจังหวัด —</option>'+provs.map(p=>`<option value="${esc(p)}">${esc(p)}</option>`).join('');
}
function onProvChange(){
  const prov=document.getElementById('af-prov').value;
  const sel=document.getElementById('af-amp');
  const amps=Object.keys(ISAN_GEO[prov]||{}).sort((a,b)=>a.localeCompare(b,'th'));
  sel.innerHTML='<option value="">— เลือกอำเภอ —</option>'+amps.map(a=>`<option value="${esc(a)}">${esc(a)}</option>`).join('');
  onAmpChange();
}
function onAmpChange(){
  const prov=document.getElementById('af-prov').value;
  const amp=document.getElementById('af-amp').value;
  const tams=(ISAN_GEO[prov]&&ISAN_GEO[prov][amp])||[];
  const dl=document.getElementById('af-tam-list');
  if(dl)dl.innerHTML=tams.map(t=>`<option value="${esc(t)}">`).join('');
  const tamInput=document.getElementById('af-tam');
  if(tamInput)tamInput.placeholder=tams.length?'เลือก/พิมพ์ตำบล ('+tams.length+' ตำบล)':'พิมพ์ชื่อตำบล';
}
function setAmpOptions(prov,ampVal){
  onProvChange();
  const sel=document.getElementById('af-amp');if(ampVal)sel.value=ampVal;
  onAmpChange();
}
// รวมที่อยู่เป็นข้อความเดียว
function addrFull(a){
  if(!a)return '';
  const parts=[];
  if(a.addr)parts.push(a.addr);
  if(a.tam)parts.push('ต.'+a.tam);
  if(a.amp)parts.push('อ.'+a.amp);
  if(a.prov)parts.push('จ.'+a.prov);
  return parts.join(' ');
}

function openAddrForm(presetProj,presetCus,presetOrder){
  if(typeof needEdit==='function' && !needEdit('addr'))return;
  addrEditKey=null;
  document.getElementById('addr-modal-title').textContent='เพิ่มที่อยู่จัดส่ง';
  fillCusDatalist();
  const g=id=>document.getElementById(id);
  const cus=presetCus||(presetProj?projectList().get(presetProj):'')||'';
  g('af-cus').value=cus;
  g('af-proj').value=presetProj||'';
  g('af-order').value='';
  formOrders=presetOrder?[presetOrder]:[];
  g('af-name').value='';g('af-tel').value='';g('af-tel2').value='';g('af-tel3').value='';g('af-loc').value='';g('af-note').value='';
  g('af-addr').value='';g('af-tam').value='';fillProvinces();g('af-prov').value='';onProvChange();
  fillProjDatalist(cus);fillOrderDatalist(cus,presetProj||'');renderOrderChips();
  // ถ้ามีที่อยู่เดิมตรง key นี้อยู่แล้ว เปิดเป็นโหมดแก้
  const k=addrKey(cus,presetProj||'',formOrders);
  if(presetProj && addrStore[k])loadAddrToForm(k);
  g('addr-modal').classList.remove('hidden');
  setTimeout(()=>g(presetProj?'af-name':'af-cus').focus(),50);
}
function loadAddrToForm(key){
  addrEditKey=key;
  document.getElementById('addr-modal-title').textContent='แก้ไขที่อยู่จัดส่ง';
  const a=addrStore[key]; const g=id=>document.getElementById(id);
  fillCusDatalist();
  g('af-cus').value=a.cus||'';
  fillProjDatalist(a.cus||'');
  g('af-proj').value=a.proj||'';
  fillOrderDatalist(a.cus||'',a.proj||'');
  formOrders=Array.isArray(a.orders)?a.orders.slice():(a.order?[a.order]:[]);
  g('af-order').value='';
  renderOrderChips();
  g('af-name').value=a.name||'';g('af-tel').value=a.tel||'';g('af-tel2').value=a.tel2||'';g('af-tel3').value=a.tel3||'';g('af-loc').value=a.loc||'';g('af-note').value=a.note||'';
  fillProvinces();
  g('af-addr').value=a.addr||'';g('af-tam').value=a.tam||'';
  g('af-prov').value=a.prov||'';setAmpOptions(a.prov||'',a.amp||'');
