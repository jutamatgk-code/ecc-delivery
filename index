// สร้างลิงก์เบอร์โทร (หลายเบอร์) + ปุ่ม QR
function phoneLinks(addr){
  const tels=[addr.tel,addr.tel2,addr.tel3].filter(t=>t&&String(t).trim());
  if(!tels.length)return '';
  const parts=tels.map((t,i)=>{
    const clean=String(t).replace(/[^0-9+]/g,'');
    const lbl=esc(String(t).replace(/'/g,""));
    // กดที่เบอร์ = เปิด QR ป๊อบอัพเลย (บนคอมโทรไม่ได้อยู่แล้ว, ปุ่มโทรอยู่ในป๊อบอัพ)
    return `<button class="tel-qr" title="แสดง QR / โทร" onclick="showPhoneQR('${esc(clean)}','${lbl}')">▦ ${esc(t)}</button>`;
  });
  return parts.join('<br>');
}
function showPhoneQR(num,label){
  const m=document.getElementById('phoneQRModal');
  const box=document.getElementById('phoneQRBox');
  box.innerHTML='';
  document.getElementById('phoneQRLabel').textContent=label||num;
  const data='tel:'+num;
  let ok=false;
  // 1) library qrcodejs (ออฟไลน์ได้ถ้าโหลดแล้ว)
  if(typeof QRCode!=='undefined'){
    try{new QRCode(box,{text:data,width:220,height:220,correctLevel:QRCode.CorrectLevel.M});ok=true;}catch(e){}
  }
  // 2) fallback: รูป QR จาก API (ชัวร์ว่าได้ภาพ)
  if(!ok){
    const img=new Image();img.width=220;img.height=220;img.alt='QR '+num;
    img.src='https://api.qrserver.com/v1/create-qr-code/?size=220x220&data='+encodeURIComponent(data);
    img.onerror=()=>{box.innerHTML='<div style="color:var(--muted);padding:20px;text-align:center">ต้องต่อเน็ตเพื่อแสดง QR<br>โทร: '+esc(num)+'</div>';};
    box.appendChild(img);
  }
  const dial=document.getElementById('phoneQRDial');
  if(dial)dial.href='tel:'+num;
  m.style.display='flex';
}
function closePhoneQR(){document.getElementById('phoneQRModal').style.display='none';}

