function invalidateCheckCache(){_checkCache=null;}
function checkRows(){
  if(_checkCache)return _checkCache;
  const out=[];
  DATA.forEach(r=>{
    const pend=num(r[F.pend]); if(pend<=0)return; // สนใจเฉพาะที่ยังค้าง
    const code=String(r[F.code]).trim();
    const price=unitPrice(r[F.order],r[F.code]);
    const s=stock[code];
    const noVal=price<=0;
    const noStock=(s===undefined);
    const short=(s!==undefined && num(s)<pend);
    if(!noVal && !noStock && !short)return; // ครบแล้ว ข้าม
    out.push({r,code,pend,price,stock:s,noVal,noStock,short});
  });
  _checkCache=out;
  return out;
}
