    commitExportRows.push({'เลขที่ใบสั่ง':g.order,'ลูกค้า':g.cus,'วันนัดส่ง':shipVal||'','PIC':g.pic||'','สถานะใบสั่ง':statusDef(orderStatus(g.order)).label,
      'จำนวนรายการ':g.rows,'ต้องการรวม':g.totalNeed,'จองได้รวม':g.blocked?0:g.totalCommit,'ขาดรวม':g.blocked?0:g.totalShort,'สถานะCommit':exStat});
    const badge=(isHold&&willCommit)?stBadge[g.totalShort<=0?'full':(g.totalCommit>0?'partial':'none')]:(stBadge[g.status]||stBadge.none);
    return `<tr class="commit-orow" style="cursor:pointer" onclick="toggleCommitOrder('${esc(g.order).replace(/'/g,"\\'")}',this)">
