// ล้างคำตอบฝ่ายผลิตทั้งหมด (admin) — เก็บประวัติก่อนล้าง
function clearProdReply(){
  if(typeof isAdmin==='function' && !isAdmin()){toast('🔒 เฉพาะผู้ดูแลระบบ');return;}
  const keys=Object.keys(prodReply);
  if(keys.length===0){toast('ไม่มีคำตอบให้ล้าง');return;}
  if(!confirm('ล้างคำตอบฝ่ายผลิตทั้งหมด '+keys.length+' รายการ?\n\nระบบจะเก็บสำเนาไว้ในประวัติ ดูย้อนหลังได้'))return;
