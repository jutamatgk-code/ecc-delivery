/* ============================================================
   CLOUD SYNC — sync ข้อมูลหลักขึ้น Firestore แบบ real-time
   collection: appData / doc ต่อ bucket
   ============================================================ */
const DEVICE_ID = (function(){
  let id=localStorage.getItem('ecc_device_id');
  if(!id){id='dev_'+Math.random().toString(36).slice(2)+Date.now().toString(36);localStorage.setItem('ecc_device_id',id);}
  return id;
})();
// ชื่อ bucket เป็นภาษาไทย (สำหรับ toast/แสดงผล)
function bucketLabel(b){
  return {orders:'ใบสั่งขาย',stock:'สต็อก',status:'สถานะ',addr:'ที่อยู่',weights:'น้ำหนัก',prodreply:'ฝ่ายผลิตตอบกลับ',prodhist:'ประวัติฝ่ายผลิต',value:'มูลค่าสินค้า',notes:'โน้ตงาน'}[b]||b;
}
// นิยาม bucket: อ่าน state ปัจจุบัน / เขียน state ที่ดึงมา / re-render อะไร
const BUCKETS={
  orders:{
    read:()=>({DATA,meta,COLS}),
    write:(d)=>{ invalidateCommitCache(); if(d.DATA){DATA=d.DATA;DATA.forEach((r,i)=>r._i=i);} if(d.meta)meta=d.meta; if(d.COLS)COLS=d.COLS;
      localStorage.setItem(DATA_KEY,JSON.stringify(DATA));localStorage.setItem(META_KEY,JSON.stringify(meta));localStorage.setItem(COLS_KEY,JSON.stringify(COLS)); },
    rerender:()=>{render();renderInfo();renderStatBar();renderPicBar();refreshActiveTab();}
  },
  stock:{
    read:()=>({stock,stockMeta}),
    write:(d)=>{ invalidateCommitCache(); if(d.stock)stock=d.stock; if(d.stockMeta!==undefined)stockMeta=d.stockMeta;
      localStorage.setItem(STOCK_KEY,JSON.stringify(stock));localStorage.setItem(STOCKMETA_KEY,JSON.stringify(stockMeta)); },
    rerender:()=>{render();refreshActiveTab();}
  },
  status:{
    read:()=>({statusStore}),
    write:(d)=>{ invalidateCommitCache(); if(d.statusStore)statusStore=d.statusStore; localStorage.setItem(STATUS_KEY,JSON.stringify(statusStore)); },
    rerender:()=>{render();refreshActiveTab();}
  },
  addr:{
    read:()=>({addrStore}),
    write:(d)=>{ if(d.addrStore)addrStore=d.addrStore; localStorage.setItem(ADDR_KEY,JSON.stringify(addrStore)); },
    rerender:()=>{refreshActiveTab();}
  },
  weights:{
    read:()=>({weightEdits}),
    write:(d)=>{ if(d.weightEdits)weightEdits=d.weightEdits; localStorage.setItem(WEIGHT_KEY,JSON.stringify(weightEdits)); },
    rerender:()=>{render();refreshActiveTab();}
  },
  prodreply:{
    read:()=>({prodReply}),
    write:(d)=>{ if(d.prodReply)prodReply=d.prodReply; localStorage.setItem(PRODREPLY_KEY,JSON.stringify(prodReply)); },
    rerender:()=>{refreshActiveTab();}
  },
  prodhist:{
    read:()=>({prodHist}),
    write:(d)=>{ if(d.prodHist)prodHist=d.prodHist; localStorage.setItem(PRODHIST_KEY,JSON.stringify(prodHist)); },
    rerender:()=>{}
  },
  value:{
    read:()=>({valueStore,valueMeta}),
    write:(d)=>{ if(d.valueStore)valueStore=d.valueStore; if(d.valueMeta!==undefined)valueMeta=d.valueMeta;
      localStorage.setItem(VALUE_KEY,JSON.stringify(valueStore));localStorage.setItem('ecc_valuemeta_v1',JSON.stringify(valueMeta)); },
    rerender:()=>{render();refreshActiveTab();}
  },
  notes:{
    read:()=>({notesStore}),
    write:(d)=>{ if(d.notesStore)notesStore=d.notesStore; localStorage.setItem(NOTES_KEY,JSON.stringify(notesStore)); },
    rerender:()=>{ if(typeof refreshNotesUI==='function')refreshNotesUI(); }
  }
};
// cloudReady และ _pushTimers ประกาศไว้ต้นไฟล์แล้ว (กัน temporal dead zone)
// re-render แท็บที่กำลังเปิดอยู่ (ให้ข้อมูลใหม่ขึ้นทันที)
function refreshActiveTab(){
  try{
    const on=document.querySelector('.tabs button[data-tab].on');
    if(!on)return;const t=on.dataset.tab;
    const map={report:renderReport,addr:renderAddr,status:renderStatus,cal:renderCal,stock:renderStock,plan:renderPlan,commit:renderCommit,weight:renderWeight};
    if(map[t])map[t]();
  }catch(e){}
}
// เขียนขึ้น cloud (debounce กัน spam quota)
function cloudPush(bucket){
  if(!cloudReady||!db)return;
  clearTimeout(_pushTimers[bucket]);
  _pushTimers[bucket]=setTimeout(async()=>{
    try{
      const payload=BUCKETS[bucket].read();
      const json=JSON.stringify(payload);
      if(json.length>950000){ // ใกล้ลิมิต 1MB/doc ของ Firestore
        toast('⚠️ ข้อมูล '+bucket+' ใหญ่เกินไป ไม่ได้ sync ขึ้น cloud (ยังเก็บในเครื่อง)');
        return;
      }
      await db.collection('appData').doc(bucket).set({
        data:json, _origin:DEVICE_ID, _at:Date.now(),
        _by:(CURRENT_USER&&CURRENT_USER.username)||'?'
      });
      // อัปเดตเวลาล่าสุด (เครื่องนี้เป็นคนแก้)
      lastCloudUpdate={at:Date.now(),by:(CURRENT_USER&&CURRENT_USER.name)||(CURRENT_USER&&CURRENT_USER.username)||'?',bucket};
      try{localStorage.setItem('ecc_last_update',JSON.stringify(lastCloudUpdate));}catch(e){}
      if(typeof renderInfo==='function')renderInfo();
    }catch(e){console.error('cloudPush '+bucket,e);}
  },600);
}
// ฟังการเปลี่ยนแปลงจากเครื่องอื่น
function startCloudListeners(){
  const firstLoad={}; // ติดตามว่า bucket นี้รับข้อมูลรอบแรกหรือยัง
  Object.keys(BUCKETS).forEach(bucket=>{
    firstLoad[bucket]=true;
    db.collection('appData').doc(bucket).onSnapshot(snap=>{
      if(!snap.exists){firstLoad[bucket]=false;return;}
      const d=snap.data();
      const isFirst=firstLoad[bucket];
      firstLoad[bucket]=false;
      // รอบแรก: รับข้อมูล cloud เสมอ (sync ให้ตรงตอนเพิ่งเปิด) แม้เครื่องนี้จะเป็นคนเขียนล่าสุด
      // รอบถัดไป: ข้ามถ้าเป็นการเขียนของเครื่องนี้เอง (กัน echo-loop)
      if(!isFirst && d._origin===DEVICE_ID)return;
      // ข้ามข้อมูลที่ยังเขียนไม่เสร็จของเราเอง (pending local write) จะได้ไม่กระพริบ
      if(snap.metadata&&snap.metadata.hasPendingWrites)return;
      try{
        const payload=JSON.parse(d.data);
        BUCKETS[bucket].write(payload);
        BUCKETS[bucket].rerender();
        // บันทึกเวลาอัปเดตล่าสุดจาก cloud (ทุก bucket ที่ไม่ใช่ prodreply ถือเป็นการอัปเดตข้อมูลหลัก)
        if(d._at){
          const cur=lastCloudUpdate;
          if(!cur||d._at>cur.at){
            lastCloudUpdate={at:d._at,by:d._by||'?',bucket};
            try{localStorage.setItem('ecc_last_update',JSON.stringify(lastCloudUpdate));}catch(e){}
            if(typeof renderInfo==='function')renderInfo();
          }
        }
        if(!isFirst && d._by)toast('🔄 '+bucketLabel(bucket)+' อัปเดตโดย '+d._by);
      }catch(e){console.error('apply '+bucket,e);}
    },err=>console.error('listen '+bucket,err));
  });
}
// ครั้งแรก: ถ้า cloud ว่าง -> ดันของในเครื่องขึ้น, ถ้ามีแล้ว -> ดึงลงมา
async function initCloudSync(){
  if(!db){return;}
  // เปิดใช้งานทันทีด้วยข้อมูลในเครื่อง (localStorage) — ไม่ต้องรอ cloud
  cloudReady=true;
  // เริ่มฟังทุก bucket พร้อมกัน (onSnapshot จะยิงข้อมูลล่าสุดมาเองรอบแรก — ไม่ต้อง .get() ก่อน)
  startCloudListeners();
  // seed เฉพาะ bucket ที่ cloud ยังว่าง (ทำแบบ parallel เบื้องหลัง ไม่ block)
  Promise.all(Object.keys(BUCKETS).map(async bucket=>{
    try{
      const ref=db.collection('appData').doc(bucket);
      const snap=await ref.get();
      if(!snap.exists){
        const payload=BUCKETS[bucket].read();
        await ref.set({data:JSON.stringify(payload),_origin:DEVICE_ID,_at:Date.now(),_by:(CURRENT_USER&&CURRENT_USER.username)||'seed'});
      }
    }catch(e){console.error('seed '+bucket,e);}
  })).then(()=>{
    toast('☁️ เชื่อมข้อมูลกับ cloud แล้ว');
  }).catch(e=>{
    console.error('initCloudSync',e);
  });
}

