        ${fix()}${wantStr}</td>
        <td class="g-tag prod-tag">ผลิต</td>${prodCells}
      </tr>
      <tr class="g-item2">
        <td class="g-tag ship-tag">จัดส่ง</td>${shipCells}
      </tr>`;
  }).join('');

  return setup+`<div class="pcard" style="padding:0;overflow:hidden"><div class="g-scroll2">
    <table class="gtbl"><thead>${monthRow}${dayRow}</thead><tbody>${body}</tbody></table>
  </div></div>
  <div class="g-legend"><span class="g-prod">ผลิต</span> จำนวนผลิต/วัน · <span class="g-ship">จัดส่ง</span> จำนวนส่ง/วัน · <span class="g-ship late">แดง</span>=ส่งเลยวันลูกค้าต้องการ</div>`;
}
// ตั้งกำลังรายสินค้า (prompt ง่ายๆ ต่อรหัส)
function openCapByCode(){
  const codes=[...new Set(trackStore.map(it=>it.code))];
  if(!codes.length){toast('ยังไม่มีสินค้าในรายการติดตาม');return}
  const lines=codes.map(c=>{const b=capSettings.byCode[c]||{};return c+' : ผลิต='+(num(b.prod)||'-')+' ส่ง='+(num(b.ship)||'-');}).join('\n');
  const pick=prompt('พิมพ์รหัสสินค้าที่จะตั้งกำลังแยก:\n\n'+lines+'\n\n(เว้นว่าง=ยกเลิก)');
  if(!pick||!pick.trim())return;
  const code=pick.trim();
  if(!codes.includes(code)){toast('ไม่พบรหัสนี้ในรายการ');return}
  const pr=prompt('กำลังผลิต/วัน ของ '+code+' (เว้นว่าง=ใช้ค่ารวม):',num((capSettings.byCode[code]||{}).prod)||'');
  const sh=prompt('กำลังส่ง/วัน ของ '+code+' (เว้นว่าง=ใช้ค่ารวม):',num((capSettings.byCode[code]||{}).ship)||'');
  capSettings.byCode[code]={prod:num(pr),ship:num(sh)};
  if(!capSettings.byCode[code].prod&&!capSettings.byCode[code].ship)delete capSettings.byCode[code];
  saveCap();renderTrack();toast('⚙️ ตั้งกำลังรายสินค้าแล้ว');
}

// picker
function openTrackPicker(){tpSel.clear();document.getElementById('tp-search').value='';renderTrackPicker();document.getElementById('track-picker').classList.remove('hidden')}
function closeTrackPicker(){document.getElementById('track-picker').classList.add('hidden')}
function renderTrackPicker(){
  const q=(document.getElementById('tp-search').value||'').trim().toLowerCase();
  const inTrack=new Set(trackStore.map(it=>it.order+'‖'+it.code));
  const rows=DATA.filter(r=>{if(!r[F.order])return false;
    if(q)return [r[F.order],r[F.cus],r[F.proj],r[F.code],r[F.name]].some(v=>String(v||'').toLowerCase().includes(q));
    return true;});
  const om=new Map();rows.forEach(r=>{const o=r[F.order];if(!om.has(o))om.set(o,[]);om.get(o).push(r)});
  document.getElementById('tp-sel').textContent=tpSel.size;
  document.getElementById('tp-list').innerHTML=[...om.entries()].sort((a,b)=>String(a[0]).localeCompare(String(b[0]))).map(([ono,orows])=>{
    const r0=orows[0];const sd=statusDef(orderStatus(ono));
    const lines=orows.map(r=>{
      const key=ono+'‖'+r[F.code];const used=inTrack.has(key);const sel=tpSel.has(key);
      const kk=esc(key).replace(/'/g,"\\'");
      return `<div class="qp-line ${sel?'sel':''}" ${used?'style="opacity:.45"':''}>
        <input type="checkbox" ${sel?'checked':''} ${used?'disabled':''} onchange="tpToggle('${kk}')">
        <div style="flex:1"><div style="font-size:.83rem">${esc(r[F.name])} <span style="color:var(--muted)">(${esc(r[F.code])})</span>${used?' <span style="color:var(--muted);font-size:.72rem">· ติดตามแล้ว</span>':''}</div>
          <div style="font-size:.73rem;color:var(--muted)">ค้าง ${num(r[F.pend]).toLocaleString()}/${num(r[F.qty]).toLocaleString()}${stock[String(r[F.code]).trim()]!==undefined?' · สต็อก '+num(stock[String(r[F.code]).trim()]).toLocaleString():''}</div></div>
      </div>`;
    }).join('');
    return `<div class="qp-order"><div class="qp-order-head">
      <b style="color:var(--aqua-d)">${esc(ono)}</b>
      <span class="ostatus" style="background:${sd.bg};color:${sd.color};font-size:.68rem">${sd.label}</span>
      <span style="font-size:.78rem;color:var(--muted)">${esc(r0[F.cus]||'-')} · ${esc(r0[F.proj]||'-')}</span></div>${lines}</div>`;
  }).join('')||'<div style="text-align:center;color:var(--muted);padding:20px">ไม่พบรายการ</div>';
}
function tpToggle(key){if(tpSel.has(key))tpSel.delete(key);else tpSel.add(key);renderTrackPicker()}
function addTrackPicked(){
  let n=0;tpSel.forEach(key=>{const[order,code]=key.split('‖');
    if(!trackStore.some(it=>it.order===order&&it.code===code)){
      trackStore.push({id:'tk'+Date.now().toString(36)+Math.random().toString(36).slice(2,5),order,code,pstatus:'',pdate:'',want:'',note:'',addedAt:new Date().toISOString()});n++;
    }});
  saveTrack();closeTrackPicker();renderTrack();toast('✓ เพิ่ม '+n+' รายการเข้าติดตามแล้ว');
}

// edit
function openTrackEdit(id){
  const it=trackStore.find(x=>x.id===id);if(!it)return;teEditId=id;
  const info=trackLineInfo(it);
  document.getElementById('te-info').innerHTML=info?
    `<b>${esc(info.name)}</b> (${esc(it.code)})<br>${esc(info.cus||'-')} · ใบสั่ง ${esc(it.order)}<br>ค้างส่ง ${info.pend.toLocaleString()}/${info.qty.toLocaleString()} · สต็อก ${info.stock!==undefined?num(info.stock).toLocaleString():'—'}`:'(ไม่พบข้อมูลสินค้าในระบบแล้ว)';
  document.getElementById('te-pstatus').value=it.pstatus||'';
  document.getElementById('te-pdate').value=it.pdate||'';
  document.getElementById('te-want').value=it.want||'';
  document.getElementById('te-note').value=it.note||'';
  document.getElementById('track-edit').classList.remove('hidden');
}
function closeTrackEdit(){document.getElementById('track-edit').classList.add('hidden')}
function saveTrackEdit(){
  const it=trackStore.find(x=>x.id===teEditId);if(!it)return;
  it.pstatus=document.getElementById('te-pstatus').value;
  it.pdate=document.getElementById('te-pdate').value;
  it.want=document.getElementById('te-want').value;
  it.note=document.getElementById('te-note').value.trim();
  saveTrack();closeTrackEdit();renderTrack();toast('💾 บันทึกแล้ว');
}
function delTrack(){
  const it=trackStore.find(x=>x.id===teEditId);if(!it)return;
  if(!confirm('ลบรายการติดตามนี้?'))return;
  trackStore=trackStore.filter(x=>x.id!==teEditId);saveTrack();closeTrackEdit();renderTrack();toast('🗑️ ลบแล้ว');
}
function exportTrack(){
  if(!trackStore.length){toast('ยังไม่มีรายการติดตาม');return}
  const out=trackStore.map(it=>{const info=trackLineInfo(it)||{};
    return {'เลขที่ใบสั่ง':it.order,'ลูกค้า':info.cus||'','โครงการ':info.proj||'','รหัสสินค้า':it.code,'ชื่อสินค้า':info.name||'',
      'ค้างส่ง':info.pend||'','จำนวนสั่ง':info.qty||'','สต็อก':info.stock!==undefined?num(info.stock):'',
      'สถานะผลิต':pstatusDef(it.pstatus).label,'คาดเสร็จ':it.pdate||'','ลูกค้าต้องการ':it.want||'','โน้ต':it.note||''};});
  const ws=XLSX.utils.json_to_sheet(out);const wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,'ลูกค้าติดตาม');
  XLSX.writeFile(wb,'ลูกค้าติดตามสินค้า_'+new Date().toISOString().slice(0,10)+'.xlsx');
  toast('📤 ส่งออก '+out.length+' รายการแล้ว');
}

