  // 7) สัดส่วนตามสถานะใบสั่ง (donut)
  const orderSet=new Map(); // order -> status id
  DATA.forEach(r=>{if(num(r[F.pend])>0)orderSet.set(String(r[F.order]),orderStatus(String(r[F.order])))});
  const stCount={}; STATUSES.forEach(s=>stCount[s.id]=0);
  orderSet.forEach(sid=>{stCount[sid]=(stCount[sid]||0)+1});
