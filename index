// สร้างโครงสร้างซ้อน: ลูกค้า > โครงการ > ใบสั่ง > สินค้า
function buildCustomerTree(rows){
  const cm=new Map();
  rows.forEach(r=>{
    const ck=(r[F.cuscode]||'')+'|'+(r[F.cus]||'');
    if(!cm.has(ck))cm.set(ck,{code:r[F.cuscode],name:r[F.cus],projs:new Map(),pend:0,rowIdx:[]});
    const c=cm.get(ck);c.pend+=num(r[F.pend]);c.rowIdx.push(r._i);
    const pk=r[F.proj]||'(ไม่ระบุโครงการ)';
    if(!c.projs.has(pk))c.projs.set(pk,{name:pk,orders:new Map(),pend:0});
    const p=c.projs.get(pk);p.pend+=num(r[F.pend]);
    const ok=r[F.order]||'-';
    if(!p.orders.has(ok))p.orders.set(ok,{no:ok,odate:r[F.odate],ship:r[F.ship],pic:r[F.pic],rows:[]});
    p.orders.get(ok).rows.push(r);
  });
  const arr=[...cm.values()];
  arr.forEach(c=>{c.nProj=c.projs.size;c.nOrder=[...c.projs.values()].reduce((s,p)=>s+p.orders.size,0);
    c.nProd=c.rowIdx.length;});
  return arr.sort((a,b)=>b.pend-a.pend);
}

