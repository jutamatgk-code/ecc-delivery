function bindCapInputs(){
  const g=id=>document.getElementById(id);
  const bind=(id,setter)=>{const el=g(id);if(el)el.onchange=()=>{setter(el.value);saveCap();renderTrack();}};
  bind('cap-prod',v=>capSettings.prod=num(v));
  bind('cap-ship',v=>capSettings.ship=num(v));
