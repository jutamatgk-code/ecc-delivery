// ===== สรุปสินค้าที่ต้องส่งในวันนั้น (รวมตามรหัสสินค้า) =====
let _daySummaryText='', _daySummaryK='';
function daySummaryData(k){
  const rows=(shipMap().get(k)||[]);
  const agg=new Map(); // code -> {code,name,pend,real,val,orders:Set,cus:Map}
  rows.forEach(r=>{
    const pend=num(r[F.pend]); if(pend<=0)return;
    const code=String(r[F.code]).trim();
    if(!agg.has(code))agg.set(code,{code,name:r[F.name],pend:0,real:0,val:0,hasReal:false,orders:new Set(),cus:new Map()});
    const g=agg.get(code); g.pend+=pend; g.orders.add(String(r[F.order]));
    // สินค้าส่งจริง จากฝ่ายผลิตตอบกลับ
    const pr=prodReply[prodKey(r[F.order],r[F.code])]||{};
    const hasReal=(pr.qty!=null&&pr.qty!=='');
    const realQty=hasReal?num(pr.qty):0;
    if(hasReal){g.real+=realQty;g.hasReal=true;}
    // มูลค่า = จำนวนส่งจริง × ราคาต่อหน่วย (ถ้าฝ่ายผลิตตอบแล้ว) ไม่งั้นใช้คงค้าง × ราคา
    const price=unitPrice(r[F.order],r[F.code]);
    const lineVal=price*(hasReal?realQty:pend);
    g.val+=lineVal;
    // แยกตามลูกค้า
    const cusName=r[F.cus]||r[F.cuscode]||'-';
    if(!g.cus.has(cusName))g.cus.set(cusName,{pend:0,real:0,val:0,orders:new Set()});
    const cg=g.cus.get(cusName);cg.pend+=pend;cg.orders.add(String(r[F.order]));cg.val+=lineVal;
    if(hasReal)cg.real+=realQty;
  });
  return [...agg.values()].sort((a,b)=>b.pend-a.pend);
}
