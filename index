function addDays(iso,n){const d=new Date(iso+'T00:00:00');d.setDate(d.getDate()+n);return d.toISOString().slice(0,10)}
// คำนวณแผน: กระจายยอดค้างแยก "ผลิต" และ "ส่ง" ต่อวัน -> คืน map วัน->จำนวน ต่อรายการ
// ส่งได้ก็ต่อเมื่อผลิตแล้ว (สะสม): ส่งวันนั้น <= min(กำลังส่ง, ยอดที่ผลิตสะสม - ส่งไปแล้ว)
function computePlan(list){
  const start=capSettings.start||new Date().toISOString().slice(0,10);
  const hasCap=(num(capSettings.prod)>0||num(capSettings.ship)>0||Object.keys(capSettings.byCode).length>0);
  const items=list.map(({it,info})=>({it,info,prodLeft:info.pend,made:0,shipped:0,prodDays:{},shipDays:{}}))
    .sort((a,b)=>{const wa=a.it.want||'9999',wb=b.it.want||'9999';return wa.localeCompare(wb)});
  if(!hasCap)return {items,start,days:0,noCap:true};
  let day=0;const MAX=400;
  while(items.some(x=>x.prodLeft>0||x.shipped<x.info.pend) && day<MAX){
    const date=addDays(start,day);
    // ---- ผลิต ----
    let gProd=num(capSettings.prod)>0?num(capSettings.prod):Infinity;
    for(const x of items){
      if(x.prodLeft<=0)continue;
      const b=capSettings.byCode[x.it.code];const ownP=b&&num(b.prod)>0?num(b.prod):null;
      let cap=ownP!=null?ownP:gProd;if(!isFinite(cap)||cap<=0)continue;
      const mk=Math.min(x.prodLeft,cap);if(mk<=0)continue;
      x.prodLeft-=mk;x.made+=mk;x.prodDays[date]=(x.prodDays[date]||0)+mk;
      if(ownP==null)gProd-=mk;
    }
    // ---- ส่ง (เฉพาะที่ผลิตแล้ว) ----
    let gShip=num(capSettings.ship)>0?num(capSettings.ship):Infinity;
    for(const x of items){
      const readyToShip=x.made-x.shipped;if(readyToShip<=0)continue;
      const b=capSettings.byCode[x.it.code];const ownS=b&&num(b.ship)>0?num(b.ship):null;
      let cap=ownS!=null?ownS:gShip;if(!isFinite(cap)||cap<=0)continue;
      const sh=Math.min(readyToShip,cap);if(sh<=0)continue;
      x.shipped+=sh;x.shipDays[date]=(x.shipDays[date]||0)+sh;
      if(ownS==null)gShip-=sh;
    }
    day++;
  }
  return {items,start,days:day,noCap:false};
}
function trackGanttHtml(list){
  const setup=`<div class="cap-panel">
    <div class="cap-row">
      <label>🏭 กำลังผลิต/วัน (รวม): <input type="number" min="0" id="cap-prod" value="${num(capSettings.prod)||''}" placeholder="ชิ้น/วัน"></label>
      <label>🚚 กำลังส่ง/วัน (รวม): <input type="number" min="0" id="cap-ship" value="${num(capSettings.ship)||''}" placeholder="ชิ้น/วัน"></label>
      <label>📅 เริ่มแผนวันที่: <input type="date" id="cap-start" value="${capSettings.start||''}"></label>
