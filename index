function commitByCodeHtml(cm,flt){
  const {q,filt,picF,ostatusF,hideCancel}=flt;
  commitExportRows=[]; // reset
  const byCode=new Map();
  DATA.forEach(r=>{const code=String(r[F.code]).trim();if(!code)return;if(num(r[F.pend])<=0)return;
    if(orderCommitBlocked(r[F.order]))return; // ข้ามใบที่ถูกกัน (ยกเลิก/พักหน้างานไม่จอง)
    if(!byCode.has(code))byCode.set(code,[]);byCode.get(code).push(r);});
  let entries=[...byCode.entries()];
  if(q)entries=entries.filter(([code,rows])=>code.toLowerCase().includes(q)||rows.some(r=>[r[F.name],r[F.cus],r[F.order],r[F.pic]].some(v=>String(v||'').toLowerCase().includes(q))));
  entries.sort((a,b)=>a[0].localeCompare(b[0]));
