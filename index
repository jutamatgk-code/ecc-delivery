    const shipCells=cells.map(c=>{const v=shipDays[c.iso];const wk=(c.dow===0||c.dow===6);const late=v&&over(c.iso);
      return `<td class="g-cell ${wk?'wk':''}">${v?'<span class="g-ship '+(late?'late':'')+'">'+v.toLocaleString()+'</span>':''}</td>`;}).join('');
    const wantStr=it.want?thShort(it.want):'-';
    const orow=DATA.find(r=>String(r[F.order])===String(it.order));
    const odate=orow?String(orow[F.odate]||'').slice(0,10):'';
    const fix=(cls='')=>`<td class="g-fix ${cls}" rowspan="2">`;
    return `<tr class="g-item" onclick="openTrackEdit('${it.id}')">
