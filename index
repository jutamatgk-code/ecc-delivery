.results{display:flex;flex-direction:column;gap:16px}
.pcard{background:var(--card);border-radius:18px;box-shadow:var(--shadow);border:1px solid var(--line);overflow:hidden;animation:rise .35s ease}
@keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.pcard-head{background:linear-gradient(100deg,var(--tint2),var(--card));padding:18px 22px;display:flex;justify-content:space-between;
  align-items:flex-start;gap:16px;flex-wrap:wrap;border-bottom:2px solid var(--line);cursor:pointer}
.pcard-head:hover{background:linear-gradient(100deg,var(--cardhover),var(--tint2))}
.pname{font-size:1.32rem;font-weight:800;color:var(--ink);line-height:1.3}
.pcode{display:inline-block;margin-top:7px;font-size:.82rem;font-weight:700;color:var(--aqua-d);background:var(--tint);padding:3px 10px;border-radius:8px}
.sum{font-size:.82rem;color:var(--muted);margin-top:9px}
.headright{display:flex;flex-direction:column;align-items:flex-end;gap:10px}
.badge{background:linear-gradient(120deg,var(--terra),var(--terra-d));color:#fff;padding:8px 16px;border-radius:30px;
  font-weight:700;font-size:.9rem;white-space:nowrap;box-shadow:0 4px 12px rgba(225,112,85,.35)}
.badge.one{background:linear-gradient(120deg,var(--aqua),var(--aqua-d))}
.chev{color:var(--muted);font-size:1.2rem;transition:.25s}
.pcard.closed .chev{transform:rotate(-90deg)}
.pcard.closed .body-wrap{display:none}
.stockbar{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:14px 22px;background:var(--tint2);border-bottom:1px solid var(--line)}
.stockbar label{font-weight:700;font-size:.9rem;color:var(--aqua-d)}
.stockbar input{width:130px;border:2px solid var(--line);border-radius:10px;padding:9px 12px;font-size:1rem;font-family:inherit;text-align:right;outline:none;font-weight:700}
.stockbar input:focus{border-color:var(--aqua)}
.pill{padding:6px 14px;border-radius:20px;font-weight:700;font-size:.85rem}
.pill.ok{background:#e3f6ec;color:var(--green)}
.pill.short{background:#fdeae8;color:var(--red)}
.pill.na{background:var(--tint2);color:var(--muted)}
.copybtn{margin-left:auto;border:none;background:linear-gradient(120deg,var(--aqua),var(--aqua-d));color:#fff;
  padding:9px 16px;border-radius:10px;cursor:pointer;font-family:inherit;font-size:.85rem;font-weight:700;
  transition:.2s;box-shadow:0 4px 12px rgba(15,185,177,.3)}
.copybtn:hover{transform:translateY(-1px);filter:brightness(1.05)}
.copybtn.done{background:linear-gradient(120deg,var(--green),#178a53)}
.copyrow{border:1.5px solid var(--line);background:var(--card2);color:var(--aqua-d);width:34px;height:34px;border-radius:9px;
  cursor:pointer;font-size:.95rem;transition:.2s;line-height:1}
.copyrow:hover{background:var(--tint);border-color:var(--aqua)}
.copyrow.done{background:var(--green);border-color:var(--green);color:#fff}
/* Address */
.modal{position:fixed;inset:0;background:rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;z-index:100;padding:20px}
.modal-box{background:var(--card);border-radius:20px;padding:26px 28px;max-width:520px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,.3);max-height:90vh;overflow-y:auto}
.modal-box h3{font-size:1.2rem;font-weight:800;color:var(--aqua-d);margin-bottom:18px}
.fld{margin-bottom:14px}
.fld label{display:block;font-size:.85rem;font-weight:700;color:var(--ink);margin-bottom:5px}
.fld input{width:100%;border:2px solid var(--line);border-radius:10px;padding:10px 13px;font-family:inherit;font-size:.95rem;outline:none;background:var(--card2);color:var(--ink)}
input,select,textarea{color-scheme:dark}
.chips{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:8px}
.chips:empty{margin-bottom:0}
.chip{display:inline-flex;align-items:center;gap:6px;background:var(--tint);color:var(--aqua-d);font-weight:700;
  font-size:.83rem;padding:5px 10px;border-radius:20px;border:1px solid var(--line)}
.chip button{border:none;background:transparent;color:var(--aqua-d);cursor:pointer;font-size:1rem;line-height:1;padding:0;font-weight:700}
.chip button:hover{color:var(--red)}
.fld input:focus{border-color:var(--aqua)}
.modal-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:8px}
.acard{background:var(--card);border-radius:16px;box-shadow:var(--shadow);border:1px solid var(--line);
  border-left:5px solid var(--terra);padding:16px 20px;margin-bottom:14px;animation:rise .3s ease}
.acard .aproj{font-size:1.1rem;font-weight:800;color:var(--ink)}
.acard .acus{font-size:.85rem;color:#a78bfa;font-weight:700;margin-top:2px}
.acard .arow{display:flex;align-items:center;gap:8px;margin-top:8px;font-size:.9rem;color:var(--ink);flex-wrap:wrap}
.acard .arow .k{color:var(--muted);min-width:78px;font-weight:700;font-size:.82rem}
.acard a.loc{color:var(--aqua-d);font-weight:700;text-decoration:none;background:var(--tint);padding:5px 12px;border-radius:8px}
.acard a.loc:hover{background:var(--line)}
.acard .tel{color:var(--terra-d);font-weight:700;text-decoration:none}
.acard-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap}
.acard-btns{display:flex;gap:7px;flex-wrap:wrap}
.abtn{border:1.5px solid var(--line);background:var(--card2);padding:7px 13px;border-radius:9px;cursor:pointer;
  font-family:inherit;font-size:.8rem;font-weight:700;transition:.2s;white-space:nowrap}
.abtn.edit{color:var(--aqua-d)}.abtn.edit:hover{background:var(--tint);border-color:var(--aqua)}
.abtn.del{color:var(--red)}.abtn.del:hover{background:#fdeae8;border-color:var(--red)}
.abtn.copy{color:#a78bfa}.abtn.copy:hover{background:#2a2540;border-color:#7b6ef0}
.abtn.done{background:var(--green);border-color:var(--green);color:#fff}
.no-addr{background:var(--tint2);border:1px dashed var(--terra);border-radius:10px;padding:8px 12px;margin-top:8px;
  display:inline-flex;align-items:center;gap:8px;font-size:.83rem;color:var(--terra-d)}
.no-addr button{border:none;background:var(--terra);color:#fff;padding:5px 12px;border-radius:8px;cursor:pointer;font-family:inherit;font-weight:700;font-size:.8rem}
/* Status */
.statusfilter{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0 4px}
.statusfilter button{border:2px solid var(--line);background:var(--card2);padding:8px 14px;border-radius:20px;cursor:pointer;
  font-family:inherit;font-size:.85rem;font-weight:700;transition:.2s;color:var(--ink);display:inline-flex;align-items:center;gap:6px}
.statusfilter button.on{color:#fff}
.statusfilter button .cnt{font-size:.75rem;opacity:.85;font-weight:800}
.scard{background:var(--card);border-radius:14px;box-shadow:var(--shadow);border:1px solid var(--line);
  padding:14px 18px;margin-bottom:12px;animation:rise .3s ease;display:flex;justify-content:space-between;align-items:flex-start;gap:14px;flex-wrap:wrap}
.scard .sno{font-weight:800;color:var(--aqua-d);font-size:1rem}
.scard .smeta{font-size:.82rem;color:var(--muted);margin-top:3px}
.scard .scus{font-size:.9rem;color:var(--ink);font-weight:600;margin-top:4px}
.scard .sctrl{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.sbadge{display:inline-flex;align-items:center;gap:5px;font-size:.82rem;font-weight:700;padding:5px 12px;border-radius:20px}
.sselect{border:2px solid var(--line);border-radius:10px;padding:8px 12px;font-family:inherit;font-size:.85rem;
  background:var(--card2);color:var(--ink);outline:none;cursor:pointer;font-weight:700}
.sselect:focus{border-color:var(--aqua)}
/* badge เล็กในมุมมองลูกค้า */
.ostatus{display:inline-flex;align-items:center;gap:4px;font-size:.72rem;font-weight:700;padding:2px 9px;border-radius:20px;margin-left:6px;vertical-align:middle}
/* Calendar */
.calbar{margin-top:20px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.calmonth{font-size:1.2rem;font-weight:800;color:var(--ink);min-width:170px;text-align:center}
.calhint{margin:12px 0;font-size:.83rem;color:var(--muted)}
.calgrid{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}
.caldow{text-align:center;font-weight:800;font-size:.82rem;color:var(--aqua-d);padding:6px 0}
.calcell{background:var(--card);border:1px solid var(--line);border-radius:12px;min-height:84px;padding:8px;cursor:pointer;
  transition:.15s;display:flex;flex-direction:column;gap:4px;position:relative}
.calcell:hover{border-color:var(--aqua);box-shadow:0 4px 14px rgba(46,158,91,.15)}
.calcell.empty{background:var(--tint2);cursor:default;border-style:dashed}
.calcell.other{opacity:.4}
.calcell.sel{border:2px solid var(--terra);background:var(--tint2);box-shadow:0 4px 14px rgba(225,112,85,.2)}
.calcell.today .cdnum{background:var(--aqua);color:#fff;border-radius:50%;width:24px;height:24px;display:inline-flex;align-items:center;justify-content:center}
.cdnum{font-weight:800;font-size:.9rem;color:var(--ink)}
.cdinfo{margin-top:auto;font-size:.72rem;font-weight:700;line-height:1.4}
.cdinfo .ci-ord{color:var(--terra-d)}
.cdinfo .ci-pend{color:var(--aqua-d)}
.cdinfo .ci-val{color:#166534;font-weight:800}
.cdinfo .ci-valreal{color:#059669;font-weight:800}
.cdot{position:absolute;top:8px;right:8px;width:9px;height:9px;border-radius:50%;background:var(--terra)}
.caldayhead{font-size:1.05rem;font-weight:800;color:var(--ink);margin:20px 0 10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.caldayhead .cnt{font-size:.82rem;color:var(--muted);font-weight:600}
@media(max-width:640px){.calcell{min-height:64px;padding:5px}.cdinfo{font-size:.66rem}}
.caltbl td.mcell{background:var(--tint2);border-left:2px solid var(--line);border-right:2px solid var(--line);vertical-align:middle;font-weight:600}
.caltbl td.mcell .cusname{font-weight:700;color:var(--ink)}
.caltbl td:first-child.mcell{font-weight:800;color:var(--aqua-d)}
.caltbl tbody tr:hover td:not(.mcell){background:var(--tint2)}
.caltbl{border:2px solid var(--line);font-size:.8rem}
.caltbl th{border-bottom:2px solid var(--line);border-right:1.5px solid var(--line);padding:8px 10px;font-size:.78rem}
.caltbl th.sortable{cursor:pointer;user-select:none;white-space:nowrap}
.caltbl th.sortable:hover{background:var(--tint)}
.qsel-lbl{display:inline-flex;align-items:center;gap:4px;font-size:.72rem;color:var(--muted);font-weight:600;cursor:pointer}
.qsel{width:15px;height:15px;accent-color:var(--terra);cursor:pointer}
.caltbl tr.picked td.mcell{background:var(--tint2);box-shadow:inset 3px 0 0 var(--terra)}
.caltbl td{border-bottom:1.5px solid var(--line);border-right:1.5px solid var(--line);padding:8px 10px}
.caltbl td.mcell{border-top:2px solid var(--line);border-bottom:2px solid var(--line);border-left:2px solid var(--line);border-right:2px solid var(--line)}
.caltbl tr:first-child td.mcell{border-top:none}
.caltbl .cuscode{font-size:.7rem}
.caltbl .mini{font-size:.74rem;padding:5px 10px}
.caltbl .ostatus{font-size:.72rem}
.addr-detail{margin-top:7px;font-size:.78rem;color:var(--ink);line-height:1.6;background:var(--tint2);border-radius:8px;padding:8px 11px;border:1px solid var(--line);border-left:3px solid var(--aqua)}
.addr-detail b{color:var(--aqua-d)}
.addr-detail a{color:var(--terra-d);font-weight:700;text-decoration:none}
.addr-detail .amuted{color:var(--muted)}
.datatbl{width:100%;border-collapse:collapse;font-size:.84rem}
.datatbl th{background:var(--tint2);color:var(--aqua-d);text-align:left;padding:10px 12px;font-weight:700;white-space:nowrap;border-bottom:2px solid var(--line);border-right:1px solid #334155}
.datatbl td{padding:10px 12px;border-bottom:1.5px solid #334155;border-right:1px solid var(--tint2);vertical-align:middle}
.datatbl tr:last-child td{border-bottom:none}
.datatbl tbody tr:hover td{background:var(--tint2)}
.datatbl .sno-td{font-weight:800;color:var(--aqua-d);white-space:nowrap}
.datatbl .qty{font-weight:800;color:var(--terra-d);text-align:right;white-space:nowrap}
.datatbl .tel{color:var(--terra-d);font-weight:700;text-decoration:none;white-space:nowrap}
.datatbl .loc{color:var(--aqua-d);font-weight:700;text-decoration:none;background:var(--tint);padding:4px 10px;border-radius:7px;white-space:nowrap}
.datatbl .loc:hover{background:var(--line)}
.datatbl .sselect{border:1.5px solid var(--line);border-radius:8px;padding:6px 10px;font-family:inherit;font-size:.82rem;background:var(--card2);color:var(--ink);outline:none;cursor:pointer;font-weight:700}
.datatbl .sselect:focus{border-color:var(--aqua)}
.datatbl .sbadge{display:inline-block;font-size:.78rem;font-weight:700;padding:4px 11px;border-radius:20px;white-space:nowrap}
.row-btns{display:flex;gap:6px;flex-wrap:wrap}
.row-btns .abtn{border:1.5px solid var(--line);background:var(--card2);padding:6px 11px;border-radius:8px;cursor:pointer;font-family:inherit;font-size:.78rem;font-weight:700;transition:.2s;white-space:nowrap}
.row-btns .abtn.copy{color:#a78bfa}.row-btns .abtn.copy:hover{background:#2a2540;border-color:#7b6ef0}
.row-btns .abtn.edit{color:var(--aqua-d)}.row-btns .abtn.edit:hover{background:var(--tint);border-color:var(--aqua)}
.row-btns .abtn.del{color:var(--red)}.row-btns .abtn.del:hover{background:#fdeae8;border-color:var(--red)}
.row-btns .abtn.done{background:var(--green);border-color:var(--green);color:#fff}
/* Queue */
.qhint{margin:12px 0;font-size:.85rem;color:var(--ink);background:var(--tint2);border-radius:10px;padding:9px 14px;border:1px solid var(--line)}
.queue-layout{display:grid;grid-template-columns:320px 1fr;gap:16px;align-items:start}
@media(max-width:820px){.queue-layout{grid-template-columns:1fr}}
.qcol-head{font-weight:800;color:var(--aqua-d);font-size:1rem;margin-bottom:10px;display:flex;align-items:center;gap:8px}
.queue-pool{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px;box-shadow:var(--shadow);position:sticky;top:16px}
.qpool-list{display:flex;flex-direction:column;gap:8px;min-height:80px;max-height:70vh;overflow-y:auto}
.qpool-tbl{width:100%;border-collapse:collapse;font-size:.82rem}
.qpool-tbl th{position:sticky;top:0;background:var(--tint2);color:var(--aqua-d);text-align:left;padding:7px 9px;font-size:.74rem;font-weight:700;border-bottom:1px solid var(--line);z-index:1}
.qpool-tbl td{padding:8px 9px;border-bottom:1px solid var(--line);vertical-align:middle}
.qpool-r{cursor:grab;transition:.12s}
.qpool-r:hover{background:var(--tint2)}
.qpool-r.dragging{opacity:.4}
.qpool-tbl .qc-no{font-weight:800;color:var(--aqua-d)}
.qpool-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;background:var(--tint2);border:1px solid var(--line);border-radius:10px;padding:8px 10px;margin-bottom:10px}
.qpool-group{border:1px solid var(--line);border-radius:12px;margin-bottom:10px;overflow:hidden;background:var(--card)}
.qpool-ghead{display:flex;align-items:center;gap:8px;padding:8px 10px;background:var(--tint2);border-bottom:1px solid var(--line)}
.qpool-ghead .qc-no{font-weight:800;color:var(--aqua-d)}
.qgrp-chk,.qrow-chk{width:16px;height:16px;accent-color:var(--aqua);cursor:pointer}
.sttruck-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px;margin-top:12px}
.sttruck{background:var(--tint2);border:1px solid var(--line);border-radius:10px;padding:9px 11px;text-align:center}
.stt-name{font-size:.72rem;color:var(--aqua-d);font-weight:700}
.stt-per{font-size:.95rem;margin-top:4px;color:var(--ink)}
.stt-per b{font-size:1.45rem;color:var(--terra-d)}
.stt-wt{font-size:.7rem;color:var(--aqua-d);margin-top:2px;font-weight:600}
.stt-val{font-size:.8rem;margin-top:2px;color:var(--muted);font-weight:600}
.stt-sub{font-size:.68rem;color:var(--muted);margin-top:1px}
.stcus-head{font-size:.85rem;font-weight:700;color:var(--terra-d);margin-top:4px}
.commit-orow:hover{background:var(--tint2)}
.status-orow:hover{background:var(--tint2)}
.plan-orow:hover{background:var(--tint2)}
.commit-detail-inner{background:var(--tint2);padding:8px 12px 12px;border-left:3px solid var(--aqua)}
.commit-detail-inner .datatbl{font-size:.82rem}
.qtrip-group{border:1px solid var(--line);border-radius:10px;margin-bottom:8px;overflow:hidden;background:var(--card)}
.qtrip-ghead{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:7px 10px;background:var(--tint2);border-bottom:1px solid var(--line)}
.qtrip-ghead .qc-no{font-weight:800;color:var(--aqua-d)}
.qtrip-ginfo{display:flex;flex-wrap:wrap;gap:4px 14px;padding:7px 12px;font-size:.75rem;color:var(--ink);background:var(--tint);border-bottom:1px solid var(--line)}
.qtrip-ginfo span{white-space:nowrap}
.qtrip-tbl{width:100%;border-collapse:collapse;font-size:.8rem;background:var(--card)}
.qtrip-tbl th{background:var(--tint2);color:var(--aqua-d);text-align:left;padding:5px 8px;font-size:.7rem;font-weight:700;border-bottom:1px solid var(--line)}
.qtrip-tbl td{padding:6px 8px;border-bottom:1px solid var(--line);vertical-align:middle}
.qtrip-tbl tr:last-child td{border-bottom:none}
.qtrip-r{cursor:grab;transition:.12s}
.qtrip-r:hover{background:var(--tint2)}
.qtrip-r.dragging{opacity:.4}
.qtrip-tbl .qc-no{font-weight:800;color:var(--aqua-d)}
.qcard{background:var(--tint2);border:1.5px solid var(--line);border-radius:10px;padding:10px 12px;cursor:grab;transition:.15s;font-size:.85rem}
.qcard:hover{border-color:var(--aqua);box-shadow:0 3px 10px rgba(46,158,91,.15)}
.qcard.dragging{opacity:.4}
.qcard .qc-no{font-weight:800;color:var(--aqua-d)}
.qcard .qc-cus{font-weight:600;color:var(--ink);margin-top:2px}
.qcard .qc-meta{font-size:.75rem;color:var(--muted);margin-top:2px}
.qcard .qc-x{float:right;border:none;background:transparent;color:var(--red);cursor:pointer;font-size:1rem;font-weight:700;line-height:1}
.queue-trucks{display:flex;flex-direction:column;gap:16px}
.truck{background:var(--card);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);overflow:hidden}
.truck-head{background:linear-gradient(100deg,var(--tint2),var(--card));padding:12px 16px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;border-bottom:2px solid var(--line)}
.truck-name{font-weight:800;color:var(--ink);font-size:1rem}
.truck-name .cap{font-size:.78rem;color:var(--muted);font-weight:600;margin-left:6px}
.truck-btns{display:flex;gap:6px;flex-wrap:wrap}
.trip{border-bottom:1px dashed var(--line);padding:10px 14px}
.trip:last-child{border-bottom:none}
.trip-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:8px}
.trip-title{font-weight:700;color:var(--terra-d);font-size:.88rem}
.trip-drop{min-height:48px;border:2px dashed #334155;border-radius:10px;padding:8px;display:flex;flex-direction:column;gap:7px;transition:.15s}
.trip-drop.over{border-color:var(--aqua);background:var(--tint)}
.trip-drop:empty::before{content:'ลากใบสั่งมาวางที่นี่';color:#5a7a78;font-size:.8rem;display:block;text-align:center;padding:8px}
.qbtn{border:1.5px solid var(--line);background:var(--card2);padding:6px 12px;border-radius:9px;cursor:pointer;font-family:inherit;font-size:.8rem;font-weight:700;transition:.2s;color:var(--aqua-d)}
.qbtn:hover{background:var(--tint);border-color:var(--aqua)}
.qbtn.del{color:var(--red)}.qbtn.del:hover{background:#fdeae8;border-color:var(--red)}
.qp-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border:1.5px solid var(--line);border-radius:10px;margin-bottom:7px;cursor:pointer}
.qp-item:hover{border-color:var(--aqua);background:var(--tint2)}
.qp-item.sel{border-color:var(--aqua);background:var(--tint)}
.qp-item.used{opacity:.45}
.qp-item input{width:18px;height:18px;accent-color:var(--aqua)}
.qty-input{width:64px;border:1.5px solid var(--line);border-radius:7px;padding:3px 7px;font-family:inherit;font-size:.82rem;text-align:right;outline:none}
.qty-input:focus{border-color:var(--aqua)}
.qp-order{border:1.5px solid var(--line);border-radius:12px;margin-bottom:10px;overflow:hidden}
.qp-order-head{display:flex;align-items:center;gap:8px;flex-wrap:wrap;background:var(--tint2);padding:9px 12px;border-bottom:1px solid var(--line)}
.qp-line{display:flex;align-items:center;gap:10px;padding:8px 12px;border-bottom:1px solid var(--tint2)}
.qp-line:last-child{border-bottom:none}
.qp-line.sel{background:var(--tint)}
.qp-line input[type=checkbox]{width:17px;height:17px;accent-color:var(--aqua)}
/* Track */
.pstatus{display:inline-block;font-size:.76rem;font-weight:700;padding:3px 10px;border-radius:20px;white-space:nowrap}
.pstatus.wait{background:#fbf3d0;color:#c99a00}
.pstatus.prod{background:#fdf0e0;color:#f0932b}
.pstatus.done{background:#e3f6ec;color:var(--green)}
.pstatus.stock{background:#e6f2fb;color:#3b9ae1}
.pstatus.none{background:var(--tint2);color:var(--muted)}
.tl-wrap{position:relative;padding-left:28px}
.tl-wrap::before{content:'';position:absolute;left:9px;top:6px;bottom:6px;width:2px;background:var(--line)}
.tl-item{position:relative;margin-bottom:16px}
.tl-item::before{content:'';position:absolute;left:-24px;top:4px;width:14px;height:14px;border-radius:50%;background:var(--aqua);border:3px solid #fff;box-shadow:0 0 0 2px var(--aqua)}
.tl-item.overdue::before{background:var(--red);box-shadow:0 0 0 2px var(--red)}
.tl-date{font-weight:800;color:var(--aqua-d);font-size:.9rem;margin-bottom:6px}
.tl-card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 14px;box-shadow:var(--shadow);cursor:pointer;transition:.15s}
.tl-card:hover{border-color:var(--aqua)}
.tk-notebox{font-size:.82rem;color:var(--ink);background:#2a2a1a;border:1px solid #4a4326;border-radius:8px;padding:6px 10px;margin-top:6px}
/* Gantt */
.cap-panel{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px 16px;margin-bottom:14px;box-shadow:var(--shadow)}
.cap-row{display:flex;gap:16px;flex-wrap:wrap;align-items:center}
.cap-row label{font-size:.85rem;font-weight:700;color:var(--ink);display:flex;align-items:center;gap:6px}
.cap-row input{border:2px solid var(--line);border-radius:8px;padding:6px 10px;font-family:inherit;font-size:.85rem;width:120px;outline:none}
.cap-row input:focus{border-color:var(--aqua)}
.g-scroll2{overflow-x:auto;max-width:100%}
.gtbl{border-collapse:collapse;font-size:.78rem;white-space:nowrap}
.gtbl th,.gtbl td{border:1px solid #334155}
.gtbl thead th{background:#c2410c;color:#fff;font-weight:800;text-align:center;padding:3px 5px;position:sticky;top:0;z-index:3}
.gtbl tr.g-month th{background:#9a3412;font-size:.82rem}
.gtbl tr.g-daynum th{background:#c2410c}
.gtbl th.g-fix,.gtbl td.g-fix{position:sticky;left:0;background:var(--card2);z-index:2;text-align:center;padding:4px 8px;max-width:180px;white-space:normal}
.gtbl thead th.g-fix{background:#155e63;color:#fff;z-index:4}
.gtbl td.g-fix.qty{font-weight:700;color:var(--terra-d)}
.gtbl td.g-fix{border-color:var(--line)}
/* ตรึงหลายคอลัมน์ซ้าย: ให้แต่ละ g-fix มี left ต่างกัน ทำง่ายๆ ด้วยการไม่ตรึงซ้อน (ตรึงเฉพาะคอลัมน์แรกๆ) */
.gtbl .g-item td.g-tag,.gtbl .g-item2 td.g-tag{font-weight:800;text-align:center;padding:3px 8px;position:sticky;z-index:2}
.gtbl .prod-tag{background:#14432b;color:#bbf7d0}
.gtbl .ship-tag{background:#1c7a48;color:#86efac}
.gtbl td.g-cell{text-align:center;min-width:30px;height:26px;padding:0}
.gtbl td.g-cell.wk{background:var(--tint2)}
.g-prod{display:inline-block;background:#14532d;color:#a7f3d0;font-weight:700;border-radius:4px;padding:1px 6px;min-width:20px}
.g-ship{display:inline-block;background:#166534;color:#d1fae5;font-weight:700;border-radius:4px;padding:1px 6px;min-width:20px}
.g-ship.late{background:#e0483c;color:#fff}
.gtbl thead th.wk{background:#9a3412}
.gtbl thead th.today{background:#c44e34}
.gtbl tr.g-item:hover td,.gtbl tr.g-item2:hover td{background:var(--tint2);cursor:pointer}
.g-legend{font-size:.78rem;color:var(--muted);margin-top:10px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.tbl-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:.87rem}
th{background:var(--tint2);color:var(--aqua-d);text-align:left;padding:11px 14px;font-weight:700;border-bottom:1px solid var(--line);white-space:nowrap}
td{padding:11px 14px;border-bottom:1px solid var(--tint2);vertical-align:top}
tr:last-child td{border-bottom:none}
tr:hover td{background:var(--tint2)}
.cus{font-weight:600;color:var(--ink)}
.cuscode{font-size:.75rem;color:var(--muted)}
.qty{font-weight:800;color:var(--terra-d);text-align:right;white-space:nowrap}
.empty{text-align:center;padding:60px 20px;color:var(--muted)}
.empty .big{font-size:3rem}
.note{color:var(--amber);font-size:.8rem}
mark{background:#fff2b3;padding:0 2px;border-radius:3px}
.foot{text-align:center;color:var(--muted);font-size:.8rem;margin-top:30px}
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--ink);color:#fff;
  padding:13px 22px;border-radius:12px;font-size:.9rem;box-shadow:0 10px 30px rgba(0,0,0,.3);opacity:0;transition:.3s;z-index:99}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.hidden{display:none}

/* Report */
.chart-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:18px;margin-top:20px}
.chart-card{background:var(--card);border-radius:20px;box-shadow:0 2px 12px rgba(0,0,0,.05);border:1px solid var(--line);padding:22px 24px;transition:transform .18s,box-shadow .18s}
.chart-card:hover{transform:translateY(-3px);box-shadow:0 14px 36px rgba(0,0,0,.10)}
.chart-card.full{grid-column:1/-1}
.chart-card h3{font-size:1.02rem;font-weight:800;color:var(--ink);margin-bottom:4px;display:flex;align-items:center;gap:10px;padding-left:12px;position:relative}
.chart-card h3::before{content:"";position:absolute;left:0;top:2px;bottom:2px;width:4px;border-radius:3px;background:var(--aqua)}
.chart-card .sub{font-size:.8rem;color:var(--muted);margin-bottom:14px}
/* การ์ดสถิติรีพอร์ต (ไอคอนกล่องสี) */
#rstats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-top:16px}
.rstat{display:flex;align-items:center;gap:14px;background:var(--card);border-radius:18px;padding:18px 20px;
  border:1px solid var(--line);box-shadow:0 2px 12px rgba(0,0,0,.05);transition:transform .18s,box-shadow .18s}
.rstat:hover{transform:translateY(-3px);box-shadow:0 14px 36px rgba(0,0,0,.10)}
.rstat-ic{flex:0 0 auto;width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center}
.rstat-ic svg{width:24px;height:24px}
.rstat-n{font-size:1.7rem;font-weight:800;color:var(--ink);line-height:1.1}
.rstat-l{font-size:.82rem;color:var(--muted);margin-top:2px}
/* หัวข้อ section ในรีพอร์ต */
.rsection-title{font-size:.9rem;font-weight:800;color:var(--ink);margin:24px 0 12px;padding-left:12px;position:relative;letter-spacing:.01em}
.rsection-title::before{content:"";position:absolute;left:0;top:1px;bottom:1px;width:4px;border-radius:3px;background:var(--aqua)}
/* แจ้งเตือน */
.r-alerts{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-top:16px}
.r-alert{display:flex;align-items:center;gap:12px;background:var(--card);border:1px solid var(--line);border-left:4px solid var(--aqua);
  border-radius:14px;padding:14px 16px;cursor:pointer;transition:transform .15s,box-shadow .15s}
.r-alert:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.1)}
.ra-dot{width:10px;height:10px;border-radius:50%;flex:0 0 auto}
.ra-t{font-size:.85rem;font-weight:700;color:var(--ink)}
.ra-v{font-size:1.15rem;font-weight:800;margin-top:1px}
.ra-go{margin-left:auto;color:var(--muted);font-size:1.2rem;font-weight:800}
/* สุขภาพข้อมูล */
.r-health{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px;
  background:var(--card);border:1px solid var(--line);border-radius:18px;padding:20px 22px;box-shadow:0 2px 12px rgba(0,0,0,.05)}
.hbar-top{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px}
.hbar-top span:first-child{font-size:.85rem;font-weight:600;color:var(--ink)}
.hbar-pct{font-size:1.05rem;font-weight:800}
.hbar-track{height:8px;border-radius:5px;background:var(--tint2);overflow:hidden}
.hbar-fill{height:100%;border-radius:5px;transition:width .5s ease}
.hbar-sub{font-size:.72rem;color:var(--muted);margin-top:4px}
.chart-box{position:relative;height:300px}
.chart-box.tall{height:420px}
@media(max-width:640px){th:nth-child(3),td:nth-child(3){display:none};.pname{font-size:1.15rem};.copybtn{margin-left:0}}

/* ===== LOGIN / AUTH ===== */
#loginOverlay{position:fixed;inset:0;z-index:9000;background:linear-gradient(135deg,var(--headgrad1),var(--headgrad2) 60%,var(--headgrad3));
  display:flex;align-items:center;justify-content:center;padding:20px}
#loginOverlay.hidden{display:none}
.login-card{background:var(--card);border-radius:24px;box-shadow:0 30px 80px rgba(0,0,0,.4);border:1px solid var(--line);
  width:100%;max-width:400px;padding:34px 30px;position:relative;animation:loginIn .3s ease}
@keyframes loginIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.login-card h2{font-size:1.4rem;font-weight:800;color:var(--ink);text-align:center;margin-bottom:4px}
.login-card .sub{font-size:.85rem;color:var(--muted);text-align:center;margin-bottom:24px}
.login-logo{width:64px;height:64px;border-radius:18px;margin:0 auto 16px;display:flex;align-items:center;justify-content:center;
  font-size:2rem;background:linear-gradient(120deg,var(--aqua),#166534);box-shadow:0 8px 24px rgba(46,158,91,.4)}
.login-fld{margin-bottom:16px}
.login-fld label{display:block;font-size:.8rem;font-weight:700;color:var(--muted);margin-bottom:6px}
.login-fld input{width:100%;padding:13px 15px;border-radius:12px;border:1px solid var(--line);background:var(--bg);
  color:var(--ink);font-family:inherit;font-size:1rem;transition:.2s}
.login-fld input:focus{outline:none;border-color:var(--aqua);box-shadow:0 0 0 3px var(--glow1)}
.login-btn{width:100%;border:none;border-radius:12px;padding:14px;cursor:pointer;font-family:inherit;font-size:1rem;
  font-weight:800;background:linear-gradient(120deg,var(--aqua),#166534);color:#04201d;transition:.2s;margin-top:4px}
.login-btn:hover{filter:brightness(1.08)}
.login-btn:disabled{opacity:.6;cursor:not-allowed}
.login-err{background:rgba(248,113,113,.12);color:var(--red);border:1px solid var(--red);border-radius:10px;
  padding:10px 14px;font-size:.85rem;font-weight:600;margin-bottom:16px;display:none}
.login-err.show{display:block}
.login-status{text-align:center;font-size:.8rem;color:var(--muted);margin-top:16px}
.login-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--amber);margin-right:5px;vertical-align:middle}
.login-dot.ok{background:var(--green)}
.login-dot.err{background:var(--red)}

/* user badge in sidebar */
.user-badge{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:12px;background:var(--tint2);
  margin-bottom:10px;border:1px solid var(--line)}
.user-badge .avatar{width:34px;height:34px;border-radius:10px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;
  font-weight:800;color:#04201d;background:linear-gradient(120deg,var(--aqua),#166534);font-size:.9rem}
.user-badge .who{flex:1 1 auto;min-width:0;overflow:hidden}
.user-badge .who .nm{font-size:.85rem;font-weight:800;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.user-badge .who .rl{font-size:.68rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.user-badge .logout{border:none;background:transparent;color:var(--muted);cursor:pointer;font-size:1.1rem;padding:4px;border-radius:8px;flex:0 0 auto;transition:.2s}
.user-badge .logout:hover{background:var(--red);color:#fff}
.sidebar.collapsed .user-badge{justify-content:center;padding:10px 0}
.sidebar.collapsed .user-badge .who,.sidebar.collapsed .user-badge .logout{display:none}
@media(max-width:900px){.sidebar.collapsed .user-badge .who,.sidebar.collapsed .user-badge .logout{display:block}
  .sidebar.collapsed .user-badge{justify-content:flex-start;padding:10px 12px}}

/* role pills */
.role-pill{display:inline-block;padding:2px 10px;border-radius:20px;font-size:.72rem;font-weight:700}
.role-admin{background:rgba(167,139,250,.18);color:var(--purple)}
.role-delivery{background:rgba(96,165,250,.18);color:var(--blue)}
.role-sales{background:rgba(52,211,153,.18);color:var(--green)}
.role-production{background:rgba(251,146,60,.18);color:#f0932b}
/* ===== ช่องตอบกลับฝ่ายผลิต — กระชับ อ่านง่ายบนมือถือ ===== */
.prod-reply-cell{min-width:140px;max-width:180px;background:rgba(251,146,60,.04);vertical-align:middle}
/* ป้ายสถานะ (เล็กลง) */
.pr-badge{display:block;text-align:center;font-weight:700;font-size:.72rem;padding:3px 6px;border-radius:7px;margin-bottom:4px}
.pr-badge-empty{background:var(--tint2);color:var(--muted);border:1px dashed var(--line)}
.pr-badge-have{background:#059669;color:#fff}
.pr-badge-nostock{background:#dc2626;color:#fff}
.pr-badge-making{background:#d97706;color:#fff}
/* จำนวนส่งได้จริง (กระชับ อยู่บรรทัดเดียว) */
.pr-qty{display:flex;align-items:baseline;gap:4px;justify-content:center;text-align:center;flex-wrap:wrap}
.pr-qty-num{font-size:1.05rem;font-weight:800;color:var(--ink);line-height:1.1}
.pr-qty-unit{font-size:.7rem;color:var(--muted)}
.pr-qty-diff{font-size:.66rem;font-weight:700;padding:1px 6px;border-radius:10px}
.pr-qty-diff.ok{background:rgba(5,150,105,.15);color:#059669}
.pr-qty-diff.short{background:rgba(220,38,38,.13);color:#dc2626}
.pr-qty-empty{text-align:center;color:var(--muted);font-size:.7rem;font-style:italic}
.pr-extra{font-size:.68rem;color:var(--ink);margin-top:2px;line-height:1.3}
.pr-meta{font-size:.58rem;color:var(--muted);text-align:right;margin-top:2px}
/* โหมดดูอย่างเดียว */
.pr-view{padding:1px}
.pr-view-empty{text-align:center;color:var(--muted);font-size:.7rem;font-style:italic;padding:8px 4px}
/* โหมดแก้ไข (กระชับ) */
.pr-edit{display:flex;flex-direction:column;gap:3px}
.pr-line{display:flex;gap:4px;align-items:center}
.pr-line .pr-status-sel{flex:1 1 auto;min-width:0}
.pr-line .pr-in-qty{flex:0 0 78px;width:78px}
.pr-more{border:none;background:none;color:var(--muted);font-size:.68rem;cursor:pointer;padding:1px 2px;font-family:inherit;text-align:left}
.pr-more:hover{color:var(--aqua-d)}
.pr-morewrap{margin-top:1px}
.pr-status-sel{width:100%;border:1.5px solid var(--line);border-radius:7px;padding:4px 6px;font-family:inherit;
  font-size:.74rem;font-weight:700;background:var(--card2);color:var(--ink);outline:none;cursor:pointer;text-align:center}
.pr-status-have{border-color:#059669;color:#059669}
.pr-status-nostock{border-color:#dc2626;color:#dc2626}
.pr-status-making{border-color:#d97706;color:#d97706}
.pr-row{display:flex;align-items:center;gap:5px}
.pr-lbl{font-size:.62rem;color:var(--muted);font-weight:700;flex:0 0 46px;text-align:right}
.pr-in{flex:1 1 auto;min-width:0;border:1px solid var(--line);border-radius:6px;padding:3px 6px;
  font-family:inherit;font-size:.72rem;background:var(--card2);color:var(--ink);outline:none}
.pr-in:focus{border-color:#f0932b}
.pr-in-qty{font-size:.82rem;font-weight:800;text-align:center}
.pr-qty-hint{text-align:center;font-size:.64rem;font-weight:700}
.pr-qty-hint.ok{color:#059669}
.pr-qty-hint.short{color:#dc2626}
/* ประวัติคำตอบฝ่ายผลิต */
.hist-block{border:1px solid var(--line);border-radius:12px;margin-bottom:14px;overflow:hidden}
.hist-head{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 14px;
  background:var(--tint2);font-size:.85rem}
.hist-count{background:var(--aqua);color:#04201d;font-weight:800;font-size:.72rem;padding:2px 10px;border-radius:20px;white-space:nowrap}
.hist-tbl{width:100%;border-collapse:collapse}
.hist-tbl th,.hist-tbl td{padding:7px 12px;text-align:left;border-bottom:1px solid var(--line);font-size:.82rem}
.hist-tbl th{font-size:.68rem;text-transform:uppercase;color:var(--muted);font-weight:800;background:var(--card2)}
.hist-tbl tr:last-child td{border-bottom:none}
.sortable-tbl thead th{cursor:pointer;user-select:none;transition:background .15s}
.sortable-tbl thead th:hover{background:var(--tint2)}
.sort-arr{font-size:.8em}
.chk-tag{display:inline-block;padding:2px 9px;border-radius:20px;font-size:.72rem;font-weight:700;white-space:nowrap;margin:1px}
/* ===== Dashboard ===== */
.dash-hello{font-size:1.1rem;font-weight:800;color:var(--ink);margin:8px 0 18px}
.dash-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}
.dash-card{background:var(--card);border-radius:16px;box-shadow:var(--shadow);border:1px solid var(--line);padding:18px 20px;transition:transform .15s,box-shadow .15s}
.dash-card:hover{transform:translateY(-2px);box-shadow:0 14px 40px rgba(0,0,0,.12)}
.dash-card-h{font-size:.9rem;font-weight:700;color:var(--muted);margin-bottom:8px}
.dash-big{font-size:2.4rem;font-weight:800;line-height:1}
.dash-unit{font-size:.95rem;font-weight:600;color:var(--muted)}
.dash-sub{font-size:.82rem;color:var(--muted);margin-top:6px}
.dash-empty{font-size:.8rem;color:var(--green);margin-top:6px;font-weight:600}
/* ===== Global search ===== */
.global-search{position:relative;z-index:50;margin-top:16px}
.global-search>input{width:100%;border:none;border-radius:12px;padding:13px 16px;font-family:inherit;font-size:.95rem;
  background:rgba(255,255,255,.95);color:#14311f;outline:none;box-shadow:0 4px 14px rgba(0,0,0,.12)}
.global-search>input:focus{box-shadow:0 4px 20px rgba(0,0,0,.2)}
.gs-results{position:absolute;top:calc(100% + 6px);left:0;right:0;background:var(--card);border-radius:14px;
  box-shadow:0 18px 50px rgba(0,0,0,.28);border:1px solid var(--line);max-height:min(60vh,420px);overflow-y:auto;display:none;padding:6px;z-index:60}
.gs-results.show{display:block}
.gs-group{font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);padding:8px 12px 4px}
.gs-item{padding:10px 12px;border-radius:9px;cursor:pointer;font-size:.9rem;color:var(--ink);transition:.15s;overflow:hidden;text-overflow:ellipsis}
.gs-item:hover{background:var(--tint2)}
.gs-meta{font-size:.78rem;color:var(--muted);float:right;margin-left:8px}
.gs-empty{padding:16px;text-align:center;color:var(--muted);font-size:.85rem}
@media(max-width:640px){
  .global-search>input{font-size:.88rem;padding:11px 14px}
  .gs-meta{float:none;display:block;margin-left:0;margin-top:2px}
}

/* user management */
.usr-tbl{width:100%;border-collapse:collapse;margin-top:14px}
.usr-tbl th,.usr-tbl td{padding:11px 12px;text-align:left;border-bottom:1px solid var(--line);font-size:.88rem}
.usr-tbl th{font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);font-weight:800}
.usr-tbl tr:hover td{background:var(--tint2)}
.usr-actions{display:flex;gap:6px;flex-wrap:wrap}
.mini2{border:1px solid var(--line);background:var(--card2);color:var(--ink);border-radius:8px;padding:5px 10px;
  cursor:pointer;font-family:inherit;font-size:.78rem;font-weight:700;transition:.2s}
.mini2:hover{border-color:var(--aqua);color:var(--aqua-d)}
.mini2.danger:hover{border-color:var(--red);color:var(--red)}
.perm-grid{display:grid;grid-template-columns:1fr auto auto auto;gap:8px 12px;align-items:center;margin-top:12px}
.perm-grid .ph{font-size:.72rem;font-weight:800;color:var(--muted);text-transform:uppercase;text-align:center}
.perm-grid .pl{font-size:.9rem;font-weight:600;color:var(--ink)}
.perm-radio{display:flex;justify-content:center}
.perm-radio input{width:18px;height:18px;cursor:pointer;accent-color:var(--aqua)}
.modal-lg{max-width:560px}
.badge-you{font-size:.68rem;background:var(--aqua);color:#04201d;padding:1px 7px;border-radius:20px;font-weight:800;margin-left:6px}
.readonly-banner{background:rgba(251,191,36,.12);border:1px solid var(--amber);color:var(--amber);
  border-radius:12px;padding:10px 16px;font-size:.85rem;font-weight:700;margin-top:16px;display:flex;align-items:center;gap:8px}
.fld select{width:100%;border:2px solid var(--line);border-radius:10px;padding:10px 13px;font-family:inherit;
  font-size:.95rem;outline:none;background:var(--card2);color:var(--ink)}
.fld select:focus{border-color:var(--aqua)}
/* โหมดดูอย่างเดียว: ปิดช่องวันที่ + dropdown สถานะ (คงอยู่แม้ตาราง re-render) */
.ro-lock .shipedit,.ro-lock .mini-sel{
  pointer-events:none;opacity:.55;cursor:not-allowed;
  background:var(--tint2)!important;border-style:dashed!important;filter:grayscale(.4)}
/* ===== FAB เครื่องมือลอย ===== */
#fabWrap{position:fixed;right:20px;bottom:20px;z-index:200;display:flex;flex-direction:column;align-items:flex-end;gap:10px}
.fab-btn{width:56px;height:56px;border-radius:50%;border:none;cursor:pointer;font-size:1.5rem;
  background:linear-gradient(135deg,var(--aqua),#166534);color:#fff;box-shadow:0 6px 20px rgba(22,101,52,.45);
  transition:transform .2s}
.fab-btn:hover{transform:scale(1.08)}
.fab-btn.open{transform:rotate(45deg) scale(1.05)}
.fab-menu{display:none;flex-direction:column;gap:8px}
.fab-menu.show{display:flex;animation:fabIn .2s ease}
@keyframes fabIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.fab-item{display:flex;align-items:center;gap:10px;border:none;cursor:pointer;font-family:inherit;font-size:.9rem;font-weight:700;
  background:var(--card);color:var(--ink);padding:11px 18px 11px 14px;border-radius:14px;box-shadow:0 4px 16px rgba(0,0,0,.18);
  border:1px solid var(--line);white-space:nowrap;transition:.15s}
.fab-item:hover{background:var(--tint2);color:var(--aqua-d)}
.fab-item span{font-size:1.15rem}
/* tool modals */
.tool-modal{position:fixed;inset:0;z-index:210;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;padding:20px}
.tool-box{background:var(--card);border-radius:20px;box-shadow:0 30px 80px rgba(0,0,0,.4);border:1px solid var(--line);
  width:100%;max-width:520px;max-height:85vh;display:flex;flex-direction:column;overflow:hidden}
.tool-head{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;font-size:1.05rem;font-weight:800;
  color:var(--ink);border-bottom:1px solid var(--line);background:var(--tint2)}
.tool-head button{border:none;background:none;font-size:1.1rem;cursor:pointer;color:var(--muted);padding:4px 8px;border-radius:8px}
.tool-head button:hover{background:var(--red);color:#fff}
.tool-body{padding:18px 20px;overflow-y:auto}
.note-item{display:flex;gap:8px;align-items:flex-start;padding:10px 12px;border-radius:10px;background:var(--tint2);margin-bottom:8px}
.note-item .txt{flex:1;font-size:.9rem;color:var(--ink);line-height:1.4}
.note-item .meta{font-size:.68rem;color:var(--muted);margin-top:3px}
.note-item button{border:none;background:none;color:var(--muted);cursor:pointer;font-size:.9rem;padding:2px 6px;border-radius:6px;flex:0 0 auto}
.note-item button:hover{background:var(--red);color:#fff}
.link-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;border:1px solid var(--line);margin-bottom:8px;transition:.15s}
.link-item:hover{border-color:var(--aqua);background:var(--tint2)}
.link-item a{flex:1;color:var(--aqua-d);font-weight:700;text-decoration:none;font-size:.92rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.link-item .lurl{font-size:.72rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px}
.link-item button{border:none;background:none;color:var(--muted);cursor:pointer;padding:3px 7px;border-radius:6px;flex:0 0 auto}
.link-item button:hover{background:var(--red);color:#fff}
.calc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.noteview-tabs{display:flex;gap:4px;background:var(--tint2);border-radius:10px;padding:3px}
.noteview-tabs button{border:none;background:none;cursor:pointer;font-family:inherit;font-size:.82rem;font-weight:700;padding:6px 14px;border-radius:8px;color:var(--muted)}
.noteview-tabs button.nv-on{background:var(--card);color:var(--aqua-d);box-shadow:0 1px 3px rgba(0,0,0,.1)}
.icon-picker{display:flex;flex-wrap:wrap;gap:6px}
.icon-picker button{width:38px;height:38px;border:2px solid var(--line);border-radius:10px;background:var(--card2);cursor:pointer;font-size:1.15rem;transition:.12s;display:flex;align-items:center;justify-content:center}
.icon-picker button:hover{border-color:var(--aqua)}
.icon-picker button.sel{border-color:var(--aqua);background:var(--tint2)}
.qr-btn{border:1px solid var(--terra);background:transparent;color:var(--terra-d);border-radius:6px;
  font-size:.68rem;font-weight:700;padding:1px 6px;cursor:pointer;font-family:inherit;margin-left:2px}
.qr-btn:hover{background:var(--terra);color:#fff}
.tel-qr{border:1px solid var(--line);background:var(--card2);color:var(--terra-d);border-radius:8px;
  font-size:.85rem;font-weight:700;padding:5px 10px;cursor:pointer;font-family:inherit;transition:.15s;white-space:nowrap;display:inline-block;margin:1px 0}
.tel-qr:hover{border-color:var(--terra);background:var(--terra);color:#fff}
.calc-grid button{border:none;cursor:pointer;font-family:inherit;font-size:1.1rem;font-weight:700;padding:16px 0;border-radius:12px;
  background:var(--tint2);color:var(--ink);transition:.12s}
.calc-grid button:hover{background:var(--line)}
.calc-grid button.op{background:var(--tint);color:var(--aqua-d)}
.calc-grid button.eq{background:linear-gradient(135deg,var(--aqua),#166534);color:#fff;grid-column:span 2}
.calc-grid button.clr{background:rgba(224,72,60,.15);color:var(--red)}
@media(max-width:640px){#fabWrap{right:14px;bottom:14px}.fab-btn{width:52px;height:52px}}
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
