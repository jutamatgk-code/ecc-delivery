/* ----- เครื่องคิดเลข (คีย์บอร์ดได้) ----- */
let _calcVal='0';
function buildCalc(){
  _calcVal='0';document.getElementById('calcScreen').value='0';
  const keys=['C','⌫','%','÷','7','8','9','×','4','5','6','-','1','2','3','+','0','.','='];
  const grid=document.getElementById('calcGrid');
  grid.innerHTML=keys.map(k=>{
    let cls='';
    if(k==='=')cls='eq';else if(k==='C'||k==='⌫')cls='clr';else if('÷×-+%'.includes(k))cls='op';
    return `<button class="${cls}" onclick="calcPress('${k}')">${k}</button>`;
  }).join('');
}
function calcPress(k){
  const scr=document.getElementById('calcScreen');
  if(k==='C'){_calcVal='0';}
  else if(k==='⌫'){_calcVal=_calcVal.length>1?_calcVal.slice(0,-1):'0';}
  else if(k==='='){
    try{
      let expr=_calcVal.replace(/×/g,'*').replace(/÷/g,'/').replace(/%/g,'/100');
      if(/[^0-9+\-*/.() ]/.test(expr))throw 0;
      let r=Function('"use strict";return('+expr+')')();
      _calcVal=(Math.round(r*1e8)/1e8).toString();
    }catch(e){_calcVal='Error';setTimeout(()=>{_calcVal='0';scr.value='0';},900);}
  }
  else{
    if(_calcVal==='0'&&!'÷×-+%.'.includes(k))_calcVal=k;
    else if(_calcVal==='Error')_calcVal=k;
    else _calcVal+=k;
  }
  scr.value=_calcVal;
}
// รับคีย์บอร์ด (เฉพาะตอนเปิดเครื่องคิดเลข)
function calcKey(e){
  const m=document.getElementById('toolCalc');if(!m||m.style.display!=='flex')return;
  const k=e.key;
  if(/[0-9.]/.test(k))calcPress(k);
  else if(k==='+'||k==='-')calcPress(k);
  else if(k==='*')calcPress('×');
  else if(k==='/'){e.preventDefault();calcPress('÷');}
  else if(k==='%')calcPress('%');
  else if(k==='Enter'||k==='='){e.preventDefault();calcPress('=');}
  else if(k==='Backspace'){e.preventDefault();calcPress('⌫');}
  else if(k==='Escape'||k.toLowerCase()==='c')calcPress('C');
}
